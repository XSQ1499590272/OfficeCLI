{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "ole",
  "elementAliases": ["embed", "object", "oleobject"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/ole[N]"
    ]
  },
  "note": "Aliases：oleobject、object、embed。包含 binary package 和 preview image。Anchor 可使用 cell range（B2:F7），也可使用 cell units 的 x/y/width/height。",
  "extends": [
    "_shared/ole",
    "_shared/ole.pptx-xlsx"
  ],
  "properties": {
    "anchor": {
      "type": "string",
      "aliases": [
        "ref"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop anchor=B2:F7"
      ],
      "readback": "anchor descriptor",
      "enforcement": "report"
    },
    "shapeId": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "OLE container 的 VML shape id（xlsx legacy drawing）。",
      "readback": "integer shape id",
      "enforcement": "report"
    }
  }
}
