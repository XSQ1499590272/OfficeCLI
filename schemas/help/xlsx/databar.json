{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "databar",
  "parent": "sheet",
  "operations": {"add": true, "get": true},
  "paths": {"positional": ["/SheetName/cf[N]"]},
  "note": "Conditional formatting data bar rule。可通过 add /Sheet1/cf --type databar --prop sqref=A1:A10 添加。实现位置：Add.Cf.cs:84（AddDataBar）；Get readback：Query.cs:464。",
  "properties": {
    "ref": { "type":"string", "aliases":["sqref","range"], "add":true, "get":true, "description":"目标单元格范围。", "examples":["--prop ref=A1:A10"], "enforcement":"report" },
    "min": { "type":"string", "add":true, "get":false, "description":"data bar 下界（省略时自动计算最小值）。", "examples":["--prop min=0"], "enforcement":"report" },
    "max": { "type":"string", "add":true, "get":false, "description":"data bar 上界（省略时自动计算最大值）。", "examples":["--prop max=100"], "enforcement":"report" },
    "color": { "type":"color", "add":true, "get":true, "description":"主 bar 颜色（默认 638EC6）。", "examples":["--prop color=4472C4"], "readback":"#-prefixed uppercase hex or 'themeN'", "enforcement":"report" },
    "showValue": { "type":"bool", "add":true, "get":true, "description":"是否在 bar 旁显示单元格值（默认 true）。", "examples":["--prop showValue=false"], "readback":"true | false (only emitted when false)", "enforcement":"report" },
    "negativeColor": { "type":"color", "add":true, "get":true, "description":"负值 bar 颜色（x14 extension，默认 FF0000）。", "examples":["--prop negativeColor=FF0000"], "readback":"#-prefixed uppercase hex", "enforcement":"report" },
    "axisColor": { "type":"color", "add":true, "get":true, "description":"axis 颜色（x14 extension，默认 000000）。", "examples":["--prop axisColor=000000"], "readback":"#-prefixed uppercase hex", "enforcement":"report" },
    "axisPosition": { "type":"enum", "values":["automatic","middle","none"], "add":true, "get":false, "description":"负值的 axis 位置（x14 extension，默认 automatic）。", "examples":["--prop axisPosition=middle"], "enforcement":"report" },
    "minLength": { "type":"number", "add":true, "get":true, "description":"最小 bar 长度（单元格的百分比，默认 0）。", "examples":["--prop minLength=10"], "readback":"integer percentage", "enforcement":"report" },
    "maxLength": { "type":"number", "add":true, "get":true, "description":"最大 bar 长度（单元格的百分比，默认 100）。", "examples":["--prop maxLength=90"], "readback":"integer percentage", "enforcement":"report" },
    "direction": { "type":"enum", "values":["leftToRight","rightToLeft","context","ltr","rtl"], "add":true, "get":true, "description":"bar 方向（x14 extension）。", "examples":["--prop direction=leftToRight"], "readback":"OOXML direction token", "enforcement":"report" },
    "stopIfTrue": { "type":"bool", "add":true, "get":false, "description":"当前 CF rule 生效时，停止评估后续 CF rules。", "examples":["--prop stopIfTrue=true"], "enforcement":"report" },
    "type": { "type":"string", "add":false, "set":false, "get":true, "description":"规范的 CF rule type token（如 \"dataBar\"、\"colorScale\"、\"iconSet\"、\"formula\"、\"topN\"、\"cellIs\"、\"containsText\"、\"aboveAverage\"、\"duplicateValues\"、\"uniqueValues\"、\"timePeriod\"）。每个 CF rule 都会返回。", "readback":"normalized CF type token", "enforcement":"report" },
    "dxfId": { "type":"number", "add":false, "set":false, "get":true, "description":"引用 dxf style 的 differential format id。仅当 rule 中存在时返回。", "readback":"integer", "enforcement":"report" }
  }
}
