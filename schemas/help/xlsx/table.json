{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "table",
  "elementAliases": ["listobject"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/table[N]"
    ]
  },
  "note": "'ref'（alias：'range'）必填，格式为 'A1:C10' 这样的 cell range。与现有 table 重叠的 range 会被拒绝。Name 会被清理，style 会按 built-in/custom whitelist 校验。QUERY：query table 返回真实 ListObject（type=table）以及启发式检测出的 table-shaped block（type=detectedtable、stable=false、使用真实 range path 如 /Sheet1/A1:D10，不会伪造 /table[N]）。检测条件严格：必须有连续的至少 2 列非 numeric-text header row、至少 1 个 data row，且不能与真实 ListObject 重叠。要只获取真实 ListObject，请使用 query listobject。add/set/get/remove 只作用于 /table[N] 下的真实 ListObject；detected block 只能 query，并通过 range path 定位。",
  "extends": [
    "_shared/table",
    "_shared/table.pptx-xlsx"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "description": "单元格范围引用（A1:C10）。必填。别名：range。",
      "aliases": [
        "range"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop ref=A1:C10"
      ],
      "readback": "range string",
      "enforcement": "report"
    },
    "displayName": {
      "type": "string",
      "description": "Excel UI 显示名称。默认使用 name。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop displayName=SalesData"
      ],
      "readback": "display name",
      "enforcement": "report"
    },
    "headerRow": {
      "type": "bool",
      "description": "是否显示 header row。别名：showHeader。",
      "aliases": [
        "showHeader"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop headerRow=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "totalRow": {
      "type": "bool",
      "description": "是否显示 total row。别名：totalsRow、showTotals。",
      "aliases": [
        "totalsRow",
        "showTotals"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop totalRow=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "autoExpand": {
      "type": "bool",
      "description": "Add 时沿连续的非空行向下自动扩展 range。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop autoExpand=true"
      ],
      "readback": "affects range at Add time",
      "enforcement": "report"
    },
    "showFirstColumn": {
      "type": "bool",
      "description": "使用 table style 高亮第一列。别名：firstColumn。",
      "aliases": [
        "firstColumn"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop showFirstColumn=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showLastColumn": {
      "type": "bool",
      "description": "使用 table style 高亮最后一列。别名：lastColumn。",
      "aliases": [
        "lastColumn"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop showLastColumn=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showRowStripes": {
      "type": "bool",
      "description": "使用 table style 的隔行条纹。默认 true。别名：showBandedRows、bandedRows、bandRows。",
      "aliases": [
        "showBandedRows",
        "bandedRows",
        "bandRows"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop showRowStripes=false"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showColumnStripes": {
      "type": "bool",
      "description": "使用 table style 的隔列条纹。默认 false。别名：showBandedColumns、bandedColumns、bandedCols、showColStripes、bandCols。",
      "aliases": [
        "showBandedColumns",
        "bandedColumns",
        "bandedCols",
        "showColStripes",
        "bandCols"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop showColumnStripes=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "columns": {
      "type": "string",
      "description": "以逗号分隔的列标题名称，用于覆盖 A1、B1 等默认值。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop columns=Name,Qty,Price"
      ],
      "readback": "comma-separated column names as stored (e.g. \"Name,Qty,Price\")",
      "enforcement": "report"
    },
    "totalsRowFunction": {
      "type": "string",
      "description": "以逗号分隔的每列 totals row function（none|sum|average|count|countNums|max|min|stdDev|var|custom）。仅 totalRow=true 时生效。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop totalsRowFunction=none,sum,average"
      ],
      "readback": "per-column tokens",
      "enforcement": "report"
    },
    "totalFunction": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "每列 totals-row function 的读取结果（在 column child node 上返回）。",
      "readback": "function token",
      "enforcement": "report"
    },
    "totalLabel": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "每列 totals-row label 的读取结果（在 column child node 上返回）。",
      "readback": "label text",
      "enforcement": "report"
    }
  }
}
