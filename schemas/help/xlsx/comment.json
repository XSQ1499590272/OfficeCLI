{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "comment",
  "elementAliases": ["note"],
  "parent": "sheet|cell",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/comment[N]",
      "/SheetName/CellRef/comment"
    ]
  },
  "note": "Aliases：note。通过 ref（或 path 尾部）将 comment 锚定到 cell。Modern Excel 也支持 threaded comment，但此 handler 输出 classic comment。",
  "extends": "_shared/comment",
  "properties": {
    "ref": {
      "type": "string",
      "description": "目标 cell address（例如 B2）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop ref=B2"
      ],
      "readback": "cell reference",
      "enforcement": "report"
    }
  }
}
