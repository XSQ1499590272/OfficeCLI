{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "sort",
  "parent": "sheet|range",
  "operations": {
    "add": false,
    "set": true,
    "get": true,
    "query": false,
    "remove": false
  },
  "paths": {
    "positional": ["/SheetName", "/SheetName/A1:D50"]
  },
  "note": "Sort 只支持 Set，会修改 sheet 或 range 中的 row order。Sheet-level Set 会自动检测 used range；range-level Set 只处理传入的 range。SortState 会在 save 后保留。",
  "properties": {
    "sort": {
      "type": "string",
      "description": "sort 规格：'COL [DIR][, COL [DIR] ...]'。COL 为 column letter（A、B、AA..XFD）；DIR 为 asc（默认）或 desc。多关键字排序时使用逗号分隔。",
      "add": false, "set": true, "get": true,
      "examples": ["--prop sort=B", "--prop sort=\"B desc, C asc\""],
      "readback": "SortState description string",
      "enforcement": "report"
    },
    "sortHeader": {
      "type": "bool",
      "description": "将第一行视为 header，不参与重新排序。",
      "add": false, "set": true, "get": false,
      "examples": ["--prop sortHeader=true"],
      "readback": "n/a",
      "enforcement": "report"
    }
  }
}
