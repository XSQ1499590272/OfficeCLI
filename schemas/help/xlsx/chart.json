{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "chart",
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/chart[N]"
    ]
  },
  "note": "Validator 除声明的 key 外，还接受点号形式（axis./series./trendline./datalabels./font./fill./border./…）和带 index 的 namespace（series{N}./dataLabel{N}./point{N}.）。chart-level axis* props（axismin、axismax、axistitle、axisfont 等）仅在 Add 时使用；创建后通过 chart-axis 执行 axis Set/Get。",
  "extends": [
    "_shared/chart",
    "_shared/chart.docx-xlsx",
    "_shared/chart.pptx-xlsx"
  ],
  "properties": {
    "dataRange": {
      "type": "string",
      "aliases": [
        "datarange",
        "range"
      ],
      "add": true,
      "set": false,
      "get": false,
      "description": "作为 chart series 数据源的 worksheet 单元格范围，仅在 Add 时可用。未显式提供 categories= 时，第一列作为 categories；提供 categories= 后，每一列都作为一个 series。仅适用于 xlsx：pptx/docx chart 会内嵌数据，没有可供引用的宿主 worksheet。",
      "examples": [
        "--prop dataRange=Sheet1!B2:C5",
        "--prop dataRange=Sheet1!B2:C5 --prop categories=Sheet1!A2:A5"
      ]
    },
    "radarStyle": {
      "type": "string",
      "add": true,
      "set": true,
      "get": true,
      "description": "radar chart 的样式 token（standard | marker | filled）。",
      "readback": "radar style token",
      "enforcement": "report",
      "aliases": [
        "radarstyle"
      ],
      "examples": [
        "--prop radarstyle=filled"
      ],
      "appliesWhen": {
        "chartType": [
          "radar"
        ]
      }
    },
    "roundedCorners": {
      "type": "string",
      "add": true,
      "set": true,
      "get": true,
      "description": "chartSpace 的 roundedCorners 标志（true|false）。",
      "readback": "true|false",
      "enforcement": "report",
      "aliases": [
        "roundedcorners"
      ],
      "examples": [
        "--prop roundedcorners=true"
      ]
    },
    "valAxisVisible": {
      "type": "bool",
      "add": true,
      "set": true,
      "get": true,
      "description": "用于快捷设置 /chart[N]/axis[@role=...] visible 的选项（role=value）；完整的 axis 级选项请参阅 chart-axis schema。",
      "readback": "true|false",
      "enforcement": "report",
      "aliases": [
        "valaxis.visible",
        "valaxisvisible"
      ],
      "examples": [
        "--prop valaxisvisible=false"
      ]
    },
    "view3d.perspective": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "3-D chart 的 perspective（0..240）。",
      "readback": "integer perspective",
      "enforcement": "report"
    },
    "view3d.rotateX": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "3-D chart 绕 X 轴的旋转角度（-90..90）。",
      "readback": "integer degrees",
      "enforcement": "report"
    },
    "view3d.rotateY": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "3-D chart 绕 Y 轴的旋转角度（0..360）。",
      "readback": "integer degrees",
      "enforcement": "report"
    }
  }
}
