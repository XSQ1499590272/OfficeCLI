{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "conditionalformatting",
  "elementAliases": ["cf"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/SheetName/cf[N]"]
  },
  "note": "Aliases：cf、cfextended。type name 映射到 xlsx CF rule（cellIs、colorScale、dataBar、iconSet、containsText、top/bottom N 等）。",
  "properties": {
    "type": {
      "type": "enum",
      "description": "CF rule 类型。",
      "values": ["cellIs", "colorScale", "dataBar", "iconSet", "containsText", "notContainsText", "beginsWith", "endsWith", "top", "topN", "top10", "topPercent", "bottom", "bottomN", "bottomPercent", "aboveAverage", "belowAverage", "duplicateValues", "uniqueValues", "containsBlanks", "containsErrors", "notContainsBlanks", "notContainsErrors", "formula", "dateOccurring", "today", "yesterday", "tomorrow", "thisWeek", "lastWeek", "nextWeek", "thisMonth", "lastMonth", "nextMonth"],
      "aliases": ["rule"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=cellIs", "--prop rule=top10"],
      "readback": "rule type",
      "enforcement": "report"
    },
    "ref": {
      "type": "string",
      "description": "目标单元格范围。",
      "aliases": ["range", "sqref"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop ref=A1:A10", "--prop sqref=A1:A10"],
      "readback": "cell range",
      "enforcement": "report"
    },
    "fill": {
      "type": "color",
      "description": "匹配单元格的背景 fill 颜色。适用于 cellIs、text、top/bottom 和 formula rules。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop fill=FFFF00"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "operator": {
      "type": "string",
      "description": "cellIs/text rules 使用的 operator。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop operator=greaterThan"],
      "readback": "operator",
      "enforcement": "report"
    },
    "value": {
      "type": "string",
      "description": "阈值或比较值。",
      "aliases": ["formula1", "formula"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop value=100", "--prop formula=$A1>5"],
      "readback": "value/formula",
      "enforcement": "report"
    },
    "color": {
      "type": "color",
      "description": "仅用于 dataBar rules 的 bar 颜色。cellIs/text/formula rules 请改用 'fill'。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop color=#FFFF00"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "value2": {
      "type": "string",
      "description": "between/notBetween cellIs rules 的第二个阈值。别名：maxvalue。",
      "aliases": ["maxvalue"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop value=10 --prop value2=20"],
      "readback": "value/formula",
      "enforcement": "report"
    },
    "text": {
      "type": "string",
      "description": "containsText/notContainsText/beginsWith/endsWith rules 用于匹配的文本。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=containsText --prop text=ERROR"],
      "readback": "needle string",
      "enforcement": "report"
    },
    "rank": {
      "type": "number",
      "description": "top/bottom N rules 的 rank。别名：top、bottomN。",
      "aliases": ["top", "bottomN"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=topN --prop rank=10"],
      "readback": "integer rank",
      "enforcement": "report"
    },
    "percent": {
      "type": "bool",
      "description": "在 top/bottom rules 中，将 'rank' 视为百分位数而非数量。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=top --prop rank=10 --prop percent=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "bottom": {
      "type": "bool",
      "description": "在 top/bottom rules 中选择 bottom-N 而不是 top-N。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=bottom --prop rank=5"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "aboveAverage": {
      "type": "bool",
      "description": "aboveAverage rule：true 表示高于平均值，false 表示低于平均值。别名：above。",
      "aliases": ["above"],
      "add": true, "set": false, "get": true,
      "examples": ["--prop type=aboveAverage --prop aboveAverage=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "stdDev": {
      "type": "number",
      "description": "aboveAverage rules 的 stdDev 偏移量（1 表示高于均值 1σ）。仅 add 时生效，目前 Get 不会返回此值。",
      "add": true, "set": false, "get": false,
      "examples": ["--prop stdDev=1"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "equalAverage": {
      "type": "bool",
      "description": "aboveAverage 匹配时是否包含均值。仅 add 时生效，目前 Get 不会返回此值。",
      "add": true, "set": false, "get": false,
      "examples": ["--prop equalAverage=true"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "period": {
      "type": "string",
      "description": "dateOccurring rules 的时间周期 token（today、yesterday、tomorrow、thisWeek、lastWeek、nextWeek、thisMonth、lastMonth、nextMonth）。别名：timePeriod。",
      "aliases": ["timePeriod", "timeperiod"],
      "add": true, "set": false, "get": true,
      "examples": ["--prop type=dateOccurring --prop period=lastWeek"],
      "readback": "period token",
      "enforcement": "report"
    },
    "min": {
      "type": "string",
      "description": "data bar 最小值（数字或 'auto'），用于 dataBar rules。",
      "add": true, "set": false, "get": true,
      "examples": ["--prop type=dataBar --prop min=0 --prop max=100"],
      "readback": "number or token",
      "enforcement": "report"
    },
    "max": {
      "type": "string",
      "description": "data bar 最大值（数字或 'auto'），用于 dataBar rules。",
      "add": true, "set": false, "get": true,
      "examples": ["--prop type=dataBar --prop max=100"],
      "readback": "number or token",
      "enforcement": "report"
    },
    "showValue": {
      "type": "bool",
      "description": "是否在 data bar / icon set 旁显示数值标签。别名：showvalue。",
      "aliases": ["showvalue"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop showValue=false"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "negativeColor": {
      "type": "color",
      "description": "负值的 data bar fill 颜色。",
      "add": true, "set": false, "get": true,
      "examples": ["--prop negativeColor=#FF0000"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "axisColor": {
      "type": "color",
      "description": "data bar axis 颜色（正负 bar 之间的分隔线）。",
      "add": true, "set": false, "get": true,
      "examples": ["--prop axisColor=#000000"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "axisPosition": {
      "type": "enum",
      "values": ["automatic", "middle", "none"],
      "description": "data bar axis 位置。默认 automatic。仅 add 时生效，目前 Get 不会返回此值。",
      "add": true, "set": false, "get": false,
      "examples": ["--prop axisPosition=middle"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "minColor": {
      "type": "color",
      "description": "color scale 最小 stop 的颜色。别名：mincolor。",
      "aliases": ["mincolor"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=colorScale --prop minColor=#F8696B"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "maxColor": {
      "type": "color",
      "description": "color scale 最大 stop 的颜色。别名：maxcolor。",
      "aliases": ["maxcolor"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop maxColor=#63BE7B"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "midColor": {
      "type": "color",
      "description": "color scale 中间 stop 的颜色。别名：midcolor。",
      "aliases": ["midcolor"],
      "add": true, "set": false, "get": true,
      "examples": ["--prop midColor=#FFEB84"],
      "readback": "#-prefixed hex",
      "enforcement": "report"
    },
    "midPoint": {
      "type": "string",
      "description": "color scale 中间 stop 的值（数字或百分位数）。别名：midpoint。仅 add 时生效，目前 Get 不会返回此值。",
      "aliases": ["midpoint"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop midPoint=50"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "iconset": {
      "type": "string",
      "description": "icon set 名称（如 3TrafficLights1、3Arrows、5Rating）。别名：icons。",
      "aliases": ["icons"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=iconSet --prop iconset=3TrafficLights1"],
      "readback": "icon-set name",
      "enforcement": "report"
    },
    "reverse": {
      "type": "bool",
      "description": "反转 icon set 的顺序。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop reverse=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "formula": {
      "type": "string",
      "description": "formulaCf 表达式（不含开头的 '='）。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=formula --prop formula=ISERROR(A1)"],
      "readback": "formula expression",
      "enforcement": "report"
    },
    "type": {
      "type": "enum",
      "values": ["dataBar", "colorScale", "iconSet", "formula", "topN", "aboveAverage", "duplicateValues", "uniqueValues", "containsText", "cellIs", "timePeriod"],
      "description": "规范的只读 CF rule type token（camelCase）。每个语义值对应一个键，替代此前拆分的 ruleType + cfType。",
      "add": false, "set": false, "get": true,
      "readback": "canonical CF type token",
      "enforcement": "report"
    },
    "dxfId": {
      "type": "int",
      "description": "此 rule 引用的 differential format 索引，只能由 Get 返回（关联 workbook 级 dxfs table）。",
      "add": false, "set": false, "get": true,
      "readback": "0-based dxf index",
      "enforcement": "report"
    }
  }
}
