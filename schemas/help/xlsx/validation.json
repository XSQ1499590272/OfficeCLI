{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "validation",
  "elementAliases": ["datavalidation"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/SheetName/dataValidation[N]"]
  },
  "note": "Aliases：datavalidation。通过 ref 指定目标 cell range。Type 决定使用 formula1 还是 formula2。query/set/remove 的 path segment 接受 alias 'validation'（例如 /SheetName/validation[N]）；Add 和 Get 会回显 canonical 的 'dataValidation[N]' form。",
  "properties": {
    "type": {
      "type": "enum",
      "values": ["list", "whole", "decimal", "date", "time", "textlength", "custom"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop type=list"],
      "readback": "validation type",
      "enforcement": "report"
    },
    "ref": {
      "type": "string",
      "description": "目标单元格范围。别名：sqref。",
      "aliases": ["sqref"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop ref=A1:A10", "--prop sqref=A1:A10"],
      "readback": "cell range",
      "enforcement": "report"
    },
    "allowBlank": {
      "type": "bool",
      "description": "是否允许空单元格。默认 true。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop allowBlank=false"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showError": {
      "type": "bool",
      "description": "无效输入时是否显示 error message。默认 true。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop showError=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showInput": {
      "type": "bool",
      "description": "选择单元格时是否显示 input prompt。默认 true。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop showInput=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "errorTitle": {
      "type": "string",
      "description": "error popup 的标题。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop errorTitle=\"Bad value\""],
      "readback": "title text",
      "enforcement": "report"
    },
    "promptTitle": {
      "type": "string",
      "description": "input prompt popup 的标题。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop promptTitle=\"Hint\""],
      "readback": "title text",
      "enforcement": "report"
    },
    "errorStyle": {
      "type": "enum",
      "values": ["stop", "warning", "information"],
      "description": "error popup 的严重级别。默认 stop。别名：warn=warning、info=information。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop errorStyle=warning"],
      "readback": "stop|warning|information",
      "enforcement": "report"
    },
    "inCellDropdown": {
      "type": "bool",
      "description": "type=list 时是否显示单元格内 dropdown arrow。默认 true。与 OOXML showDropDown 的含义相反。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop inCellDropdown=false"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showDropDown": {
      "type": "bool",
      "description": "原始 OOXML showDropDown flag（含义反转：true = 隐藏 arrow）。为清晰起见，优先使用 inCellDropdown。",
      "add": true, "set": true, "get": false,
      "examples": ["--prop showDropDown=true"],
      "readback": "raw OOXML flag",
      "enforcement": "report"
    },
    "operator": {
      "type": "enum",
      "values": ["between", "notBetween", "equal", "notEqual", "greaterThan", "greaterThanOrEqual", "lessThan", "lessThanOrEqual"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop operator=between"],
      "readback": "operator name",
      "enforcement": "report"
    },
    "formula1": {
      "type": "string",
      "add": true, "set": true, "get": true,
      "examples": ["--prop formula1=\"Yes,No,Maybe\""],
      "readback": "formula1 content",
      "enforcement": "report"
    },
    "formula2": {
      "type": "string",
      "add": true, "set": true, "get": true,
      "examples": ["--prop formula2=100"],
      "readback": "formula2 content",
      "enforcement": "report"
    },
    "prompt": {
      "type": "string",
      "description": "选择单元格时显示的消息。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop prompt=\"Enter 1-100\""],
      "readback": "prompt text",
      "enforcement": "report"
    },
    "error": {
      "type": "string",
      "description": "无效输入时显示的 error message。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop error=\"Invalid value\""],
      "readback": "error text",
      "enforcement": "report"
    }
  }
}
