{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "iconset",
  "parent": "sheet",
  "operations": {"add": true, "get": true},
  "paths": {"positional": ["/SheetName/cf[N]"]},
  "note": "Conditional formatting iconset rule。可通过 add /Sheet1/cf --type iconset --prop sqref=A1:A10 --prop iconset=3arrows 添加。实现位置：Add.Cf.cs:322（AddIconSet）；Get：Query.cs:525。",
  "properties": {
    "ref": { "type":"string", "aliases":["sqref","range"], "add":true, "get":true, "description":"目标单元格范围。", "examples":["--prop ref=A1:A10"], "enforcement":"report" },
    "iconset": { "type":"enum", "values":["3arrows","3arrowsGray","3flags","3trafficLights1","3trafficLights2","3signs","3symbols","3symbols2","4arrows","4arrowsGray","4rating","4redToBlack","4trafficLights","5arrows","5arrowsGray","5rating","5quarters"], "aliases":["icons"], "add":true, "get":true, "description":"icon set 名称。", "readback":"icon set token", "examples":["--prop iconset=3arrows"], "enforcement":"report" },
    "reverse": { "type":"bool", "add":true, "get":false, "description":"反转 icon 顺序。", "examples":["--prop reverse=true"], "enforcement":"report" },
    "showValue": { "type":"bool", "add":true, "get":false, "description":"是否在 icon 旁显示 cell value（默认 true）。", "examples":["--prop showValue=false"], "enforcement":"report" },
    "type": { "type":"string", "add":false, "set":false, "get":true, "description":"规范的 CF rule type token（如 \"dataBar\"、\"colorScale\"、\"iconSet\"、\"formula\"、\"topN\"、\"cellIs\"、\"containsText\"、\"aboveAverage\"、\"duplicateValues\"、\"uniqueValues\"、\"timePeriod\"）。每个 CF rule 都会返回。", "readback":"normalized CF type token", "enforcement":"report" },
    "dxfId": { "type":"number", "add":false, "set":false, "get":true, "description":"引用 dxf style 的 differential format id。仅当 rule 中存在时返回。", "readback":"integer", "enforcement":"report" }
  }
}
