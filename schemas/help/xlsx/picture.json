{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "picture",
  "elementAliases": ["image", "img"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/picture[N]"
    ]
  },
  "note": "Aliases：image、img。通过 ParseAnchorBoundsEmu 设置 anchor，接受 cell count 或带单位的 length。SVG source 会生成 PNG fallback。",
  "extends": [
    "_shared/picture",
    "_shared/picture.docx-xlsx",
    "_shared/picture.pptx-xlsx"
  ],
  "properties": {
    "crop": {
      "type": "string",
      "description": "裁剪比例（0–100）。1 个值表示四边相同；2 个值依次为 vertical,horizontal；4 个值依次为 left,top,right,bottom。Excel 可读取但不会写入裁剪信息；此项覆盖 shared base 中 add/set=true 的定义，该写入能力仅适用于 pptx。",
      "add": false,
      "set": false,
      "get": true,
      "examples": [
        "--prop crop=10"
      ],
      "readback": "comma-separated percentages (left,top,right,bottom)",
      "enforcement": "report"
    },
    "title": {
      "type": "string",
      "description": "cNvPr 上的 OOXML @title 属性（不同于 alt）。",
      "add": true,
      "set": false,
      "examples": [
        "--prop title=\"Logo\""
      ],
      "enforcement": "report"
    },
    "decorative": {
      "type": "bool",
      "description": "将图片标记为 decorative（cNvPr 下的 a16:decorative ext），使 screen reader 不会遍历其 alt text。",
      "add": true,
      "set": false,
      "examples": [
        "--prop decorative=true"
      ],
      "enforcement": "report"
    },
    "rotation": {
      "type": "string",
      "description": "旋转角度（正值为顺时针）。OOXML 内部将其以 1/60000 度写入 Transform2D @rot。",
      "add": true,
      "set": true,
      "examples": [
        "--prop rotation=45"
      ],
      "enforcement": "report"
    },
    "flip": {
      "type": "string",
      "description": "简写 flip token：'h' / 'v' / 'both' / 'hv' / 'vh' / 'horizontal' / 'vertical'。",
      "add": true,
      "set": true,
      "examples": [
        "--prop flip=h",
        "--prop flip=both"
      ],
      "enforcement": "report"
    },
    "flipH": {
      "type": "bool",
      "description": "水平翻转（Office-API 风格的 flip=h 别名）。",
      "add": true,
      "set": true,
      "examples": [
        "--prop flipH=true"
      ],
      "enforcement": "report"
    },
    "flipV": {
      "type": "bool",
      "description": "垂直翻转（Office-API 风格的 flip=v 别名）。",
      "add": true,
      "set": true,
      "examples": [
        "--prop flipV=true"
      ],
      "enforcement": "report"
    },
    "flipBoth": {
      "type": "bool",
      "description": "同时翻转两个轴（flip=both 的别名）。",
      "add": true,
      "set": false,
      "examples": [
        "--prop flipBoth=true"
      ],
      "enforcement": "report"
    },
    "opacity": {
      "type": "string",
      "description": "图片不透明度。支持百分数（50、'50%'）或小数（0.5）；100 / 100% / 1.0 表示完全不透明。",
      "add": true,
      "set": false,
      "examples": [
        "--prop opacity=50",
        "--prop opacity=0.5"
      ],
      "enforcement": "report"
    },
    "hyperlink": {
      "type": "string",
      "description": "图片级 hyperlink。可为外部 URL（https://...）或文档内跳转（#SheetName!A1）。",
      "aliases": [
        "link"
      ],
      "add": true,
      "set": false,
      "examples": [
        "--prop hyperlink=https://example.com"
      ],
      "enforcement": "report"
    },
    "anchor": {
      "type": "string",
      "description": "单元格范围 anchor（如 'B2:E6'），或 anchorMode token（'oneCell'/'twoCell'/'absolute'）。单元格范围形式会使用 twoCell mode。",
      "add": true,
      "set": false,
      "examples": [
        "--prop anchor=B2:E6",
        "--prop anchor=oneCell"
      ],
      "enforcement": "report"
    },
    "anchorMode": {
      "type": "string",
      "description": "显式指定 anchor mode：'oneCell' / 'twoCell' / 'absolute'。会覆盖 anchor= 中的 mode token。",
      "add": true,
      "set": false,
      "examples": [
        "--prop anchorMode=oneCell"
      ],
      "enforcement": "report"
    },
    "shadow": {
      "type": "string",
      "description": "外部阴影效果。'none' 清除；否则传入 DrawingEffectsHelper 支持的颜色/配置。",
      "add": false,
      "set": true,
      "examples": [
        "--prop shadow=#808080"
      ],
      "enforcement": "report"
    },
    "glow": {
      "type": "string",
      "description": "发光效果的颜色/配置。'none' 清除。",
      "add": false,
      "set": true,
      "examples": [
        "--prop glow=#4472C4"
      ],
      "enforcement": "report"
    },
    "reflection": {
      "type": "string",
      "description": "倒影效果。'none' 清除。",
      "add": false,
      "set": true,
      "examples": [
        "--prop reflection=true"
      ],
      "enforcement": "report"
    },
    "softEdge": {
      "type": "string",
      "aliases": [
        "softedge"
      ],
      "description": "柔化边缘效果的半径。'none' 清除。",
      "add": false,
      "set": true,
      "examples": [
        "--prop softEdge=5"
      ],
      "enforcement": "report"
    },
    "crop.l": {
      "type": "string",
      "description": "从左边裁剪的比例（如 10 = 10%，也接受 '10%'）。内部以 1/1000 百分比单位存储。",
      "add": true,
      "set": true,
      "examples": [
        "--prop crop.l=10",
        "--prop crop.l=50%"
      ],
      "enforcement": "report"
    },
    "crop.r": {
      "type": "string",
      "description": "从右边裁剪的比例。",
      "add": true,
      "set": true,
      "examples": [
        "--prop crop.r=10"
      ],
      "enforcement": "report"
    },
    "crop.t": {
      "type": "string",
      "description": "从上边裁剪的比例。",
      "add": true,
      "set": true,
      "examples": [
        "--prop crop.t=10"
      ],
      "enforcement": "report"
    },
    "crop.b": {
      "type": "string",
      "description": "从下边裁剪的比例。",
      "add": true,
      "set": true,
      "examples": [
        "--prop crop.b=10"
      ],
      "enforcement": "report"
    },
    "srcRect": {
      "type": "string",
      "description": "组合裁剪配置，如 'l=10,r=10,t=5,b=5'。等同于分别设置 crop.l/crop.r/crop.t/crop.b。",
      "add": true,
      "set": true,
      "examples": [
        "--prop srcRect=l=10,r=10,t=5,b=5"
      ],
      "enforcement": "report"
    },
    "anchoredTo": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "anchor 描述：图片锚定到的 sheet/cell-range 路径。",
      "readback": "`/SheetName/A1[:Z9]` anchor path",
      "enforcement": "report"
    },
    "mergeAnchor": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "当图片锚定到 merged-cell 区域时为 true。",
      "readback": "true|false",
      "enforcement": "report"
    },
    "x": {
      "type": "length",
      "description": "x 位置，以 TwoCellAnchor 的列/行索引表示（xlsx cell-anchor 定位，整数）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop x=0",
        "--prop x=1in"
      ],
      "readback": "integer column/row index",
      "enforcement": "report"
    },
    "y": {
      "type": "length",
      "description": "y 位置，以 TwoCellAnchor 的列/行索引表示（xlsx cell-anchor 定位，整数）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop y=0",
        "--prop y=1in"
      ],
      "readback": "integer column/row index",
      "enforcement": "report"
    },
    "width": {
      "type": "integer",
      "description": "宽度，以 TwoCellAnchor 的列/行跨度表示（xlsx cell-anchor 定位，整数）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop width=5",
        "--prop width=3in"
      ],
      "readback": "integer column/row span",
      "enforcement": "report"
    },
    "height": {
      "type": "integer",
      "description": "高度，以 TwoCellAnchor 的列/行跨度表示（xlsx cell-anchor 定位，整数）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop height=5",
        "--prop height=2in"
      ],
      "readback": "integer column/row span",
      "enforcement": "report"
    }
  }
}
