{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "colorscale",
  "parent": "sheet",
  "operations": {"add": true, "get": true},
  "paths": {"positional": ["/SheetName/cf[N]"]},
  "note": "Conditional formatting 的 2-stop/3-stop color scale。可通过 add /Sheet1/cf --type colorscale --prop sqref=A1:A10 --prop mincolor=F8696B --prop maxcolor=63BE7B 添加。实现位置：Add.Cf.cs:266（AddColorScale）；Get：Query.cs:500。",
  "properties": {
    "ref": { "type":"string", "aliases":["sqref","range"], "add":true, "get":true, "description":"目标单元格范围。", "examples":["--prop ref=A1:A10"], "enforcement":"report" },
    "minColor": { "type":"color", "aliases":["mincolor"], "add":true, "get":true, "description":"低端颜色（默认 F8696B）。", "examples":["--prop minColor=F8696B"], "readback":"#-prefixed uppercase hex", "enforcement":"report" },
    "maxColor": { "type":"color", "aliases":["maxcolor"], "add":true, "get":true, "description":"高端颜色（默认 63BE7B）。", "examples":["--prop maxColor=63BE7B"], "readback":"#-prefixed uppercase hex", "enforcement":"report" },
    "midColor": { "type":"color", "aliases":["midcolor"], "add":true, "get":true, "description":"中间点颜色（两 stop scale 时可省略）。", "examples":["--prop midColor=FFEB84"], "readback":"#-prefixed uppercase hex", "enforcement":"report" },
    "midpoint": { "type":"number", "aliases":["midPoint"], "add":true, "get":false, "description":"中间点百分位（默认 50）。仅在设置 midcolor 时有意义。", "examples":["--prop midpoint=50"], "enforcement":"report" },
    "stopIfTrue": { "type":"bool", "add":true, "get":false, "description":"当前 CF rule 生效时，停止评估后续 CF rules。", "examples":["--prop stopIfTrue=true"], "enforcement":"report" },
    "type": { "type":"string", "add":false, "set":false, "get":true, "description":"规范的 CF rule type token（如 \"dataBar\"、\"colorScale\"、\"iconSet\"、\"formula\"、\"topN\"、\"cellIs\"、\"containsText\"、\"aboveAverage\"、\"duplicateValues\"、\"uniqueValues\"、\"timePeriod\"）。每个 CF rule 都会返回。", "readback":"normalized CF type token", "enforcement":"report" },
    "dxfId": { "type":"number", "add":false, "set":false, "get":true, "description":"引用 dxf style 的 differential format id。仅当 rule 中存在时返回。", "readback":"integer", "enforcement":"report" }
  }
}
