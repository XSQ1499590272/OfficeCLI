{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "cellis",
  "parent": "sheet",
  "operations": {"add": true, "get": true},
  "paths": {"positional": ["/SheetName/cf[N]"]},
  "note": "将 cell value 与 literal/formula 比较。可通过 add /Sheet1/cf --type cellis --prop sqref=A1:A10 --prop operator=greaterThan --prop value=50 --prop fill=FFFF00 添加。实现位置：Add.Cf.cs:453（AddCellIs）；Get：Query.cs:585。",
  "properties": {
    "ref": { "type":"string", "aliases":["sqref","range"], "add":true, "get":true, "description":"目标单元格范围。", "examples":["--prop ref=A1:A10"], "enforcement":"report" },
    "operator": { "type":"enum", "values":["greaterThan","lessThan","greaterThanOrEqual","lessThanOrEqual","equal","notEqual","between","notBetween"], "add":true, "get":true, "description":"比较 operator。别名：gt/lt/gte/lte/eq/ne/= 等。", "examples":["--prop operator=greaterThan","--prop operator=between"], "readback":"OOXML operator token", "enforcement":"report" },
    "value": { "type":"string", "aliases":["formula","value1"], "add":true, "get":true, "description":"主要比较值（literal 或 formula）。必填。", "examples":["--prop value=50","--prop value=\"=AVERAGE(A:A)\""], "readback":"formula text as stored", "enforcement":"report" },
    "value2": { "type":"string", "aliases":["formula2","maxvalue"], "add":true, "get":true, "description":"次要比较值，仅用于 between/notBetween。", "examples":["--prop value2=100"], "readback":"formula text as stored", "enforcement":"report" },
    "fill": { "type":"color", "add":true, "get":false, "description":"通过 dxf 应用的背景 fill。", "examples":["--prop fill=FFFF00"], "enforcement":"report" },
    "font.color": { "type":"color", "add":true, "get":false, "description":"通过 dxf 设置的 font 颜色。", "examples":["--prop font.color=FF0000"], "enforcement":"report" },
    "font.bold": { "type":"bool", "add":true, "get":false, "description":"通过 dxf 设置的 bold。", "examples":["--prop font.bold=true"], "enforcement":"report" },
    "stopIfTrue": { "type":"bool", "add":true, "get":false, "description":"当前 CF rule 生效时，停止评估后续 CF rules。", "examples":["--prop stopIfTrue=true"], "enforcement":"report" },
    "type": { "type":"string", "add":false, "set":false, "get":true, "description":"规范的 CF rule type token（如 \"dataBar\"、\"colorScale\"、\"iconSet\"、\"formula\"、\"topN\"、\"cellIs\"、\"containsText\"、\"aboveAverage\"、\"duplicateValues\"、\"uniqueValues\"、\"timePeriod\"）。每个 CF rule 都会返回。", "readback":"normalized CF type token", "enforcement":"report" },
    "dxfId": { "type":"number", "add":false, "set":false, "get":true, "description":"引用 dxf style 的 differential format id。仅当 rule 中存在时返回。", "readback":"integer", "enforcement":"report" }
  }
}
