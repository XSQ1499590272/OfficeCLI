{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "colbreak",
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/SheetName/colbreak[N]"]
  },
  "note": "在指定 column 前插入 manual page break。接受 numeric index 或 column letter。",
  "properties": {
    "col": {
      "type": "string",
      "description": "column index 或字母。Aliases: column、index。",
      "aliases": ["column", "index"],
      "add": true, "set": true, "get": false,
      "examples": ["--prop col=F"],
      "readback": "n/a (see sheet.colBreaks)",
      "enforcement": "report"
    },
    "manual": {
      "type": "bool",
      "description": "true 表示用户插入的（manual）分页符；false 表示 automatic。",
      "add": false, "set": true, "get": false,
      "enforcement": "report"
    },
    "min": {
      "type": "int",
      "description": "分页符覆盖范围的起始 row，使用 0-based index（OOXML brk@min）。",
      "add": false, "set": true, "get": false,
      "enforcement": "report"
    },
    "max": {
      "type": "int",
      "description": "分页符覆盖范围的结束 row，使用 0-based index（OOXML brk@max）。",
      "add": false, "set": true, "get": false,
      "enforcement": "report"
    }
  }
}
