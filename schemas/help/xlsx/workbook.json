{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "workbook",
  "container": true,
  "operations": {
    "add": false,
    "set": true,
    "get": true,
    "query": true,
    "remove": false
  },
  "paths": {
    "positional": [
      "/"
    ]
  },
  "note": "Root container。Get 返回 sheet list 和 workbook-level metadata。Set 支持 workbook-wide properties（defaultFont、defaultFontSize、calc.mode、calc.iterate、author、title、subject）。Sheet 通过 /SheetName path 修改。",
  "children": [
    {
      "element": "sheet",
      "pathSegment": "{SheetName}",
      "cardinality": "1..n"
    }
  ],
  "extends": "_shared/root-metadata",
  "properties": {
    "defaultFont": {
      "type": "string",
      "description": "所有 cell 的默认字体（fontname 别名）。ExcelHandler 尚未实现；当前 Add/Set/Get 均返回 n/a，请直接管理 cell 字体。",
      "aliases": [
        "fontName",
        "fontname"
      ],
      "add": false,
      "set": false,
      "get": false,
      "examples": [
        "--prop defaultFont=Calibri"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "defaultFontSize": {
      "type": "length",
      "description": "默认字体大小。ExcelHandler 尚未实现；当前 Add/Set/Get 均返回 n/a，请直接管理 cell 字体。",
      "aliases": [
        "fontSize",
        "fontsize"
      ],
      "add": false,
      "set": false,
      "get": false,
      "examples": [
        "--prop defaultFontSize=11"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "author": {
      "type": "string",
      "description": "document 作者（core properties）。",
      "aliases": [
        "creator"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop author=\"Alice\""
      ],
      "readback": "author string",
      "enforcement": "report"
    },
    "title": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop title=\"Q1 Report\""
      ],
      "readback": "title string",
      "enforcement": "report"
    },
    "calc.mode": {
      "type": "enum",
      "values": [
        "auto",
        "manual",
        "autoExceptTables"
      ],
      "description": "workbook formula 计算模式。'auto' 在每次变更时重新计算，'manual' 需要按 F9，'autoExceptTables' 跳过 data table。",
      "aliases": [
        "calcmode"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop calc.mode=manual",
        "--prop calcmode=auto"
      ],
      "readback": "calc mode name",
      "enforcement": "report"
    },
    "calc.iterate": {
      "type": "bool",
      "description": "为 circular reference 启用迭代计算。",
      "aliases": [
        "iterate"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop calc.iterate=true",
        "--prop iterate=false"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "calc.iterateCount": {
      "type": "number",
      "description": "启用 calc.iterate 时的最大迭代次数。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop calc.iterateCount=100"
      ],
      "readback": "integer",
      "enforcement": "report"
    },
    "calc.iterateDelta": {
      "type": "number",
      "description": "视为计算收敛时，迭代之间允许的最大变化量。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop calc.iterateDelta=0.001"
      ],
      "readback": "number",
      "enforcement": "report"
    },
    "calc.fullPrecision": {
      "type": "bool",
      "description": "为 true 时，计算使用完整精度而非显示值。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop calc.fullPrecision=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "lastModifiedBy": {
      "type": "string",
      "aliases": [
        "lastmodifiedby"
      ],
      "add": false,
      "set": true,
      "get": true,
      "description": "来自 docProps/core.xml 的 lastModifiedBy 字段。",
      "examples": [
        "--prop lastModifiedBy=\"Alice\""
      ],
      "readback": "author string",
      "enforcement": "report"
    },
    "created": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "创建时间戳，格式为 ISO-8601。",
      "readback": "ISO-8601 timestamp",
      "enforcement": "report"
    },
    "modified": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "最后修改时间戳，格式为 ISO-8601。",
      "readback": "ISO-8601 timestamp",
      "enforcement": "report"
    },
    "extended.application": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "来自 docProps/app.xml 的 application 标识符（例如 \"Microsoft Excel\"）。",
      "readback": "application string",
      "enforcement": "report"
    },
    "category": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/core.xml 中的 Category 字段。",
      "examples": [
        "--prop category=Reports"
      ],
      "readback": "category string",
      "enforcement": "report"
    },
    "description": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/core.xml 中的 Description 字段。",
      "examples": [
        "--prop description=\"Annual revenue summary\""
      ],
      "readback": "description string",
      "enforcement": "report"
    },
    "keywords": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/core.xml 中的 Keywords 字段。",
      "examples": [
        "--prop keywords=\"finance,2026\""
      ],
      "readback": "keyword list string",
      "enforcement": "report"
    },
    "revisionNumber": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/core.xml 中的 Revision 字段，即 workbook 保存计数器。",
      "examples": [
        "--prop revisionNumber=3"
      ],
      "readback": "revision number string",
      "enforcement": "report"
    },
    "activeTab": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "workbook BookViews 的 activeTab，即文件打开时活动 sheet 的索引。",
      "readback": "integer (0-based)",
      "enforcement": "report"
    },
    "firstSheet": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "workbook BookViews 的 firstSheet，即最左侧可见 sheet 的索引。",
      "readback": "integer (0-based)",
      "enforcement": "report"
    },
    "calc.fullCalcOnLoad": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "CalculationProperties 的 FullCalculationOnLoad 标记：workbook 打开时强制完整重新计算。",
      "readback": "true|false",
      "enforcement": "report"
    },
    "calc.refMode": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "CalculationProperties 的 ReferenceMode（A1 或 R1C1）。",
      "readback": "reference mode string",
      "enforcement": "report"
    },
    "workbook.backupFile": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "WorkbookProperties 的 BackupFile 标记：Excel 会在保存时同时保留 .bak 备份。",
      "readback": "true|false",
      "enforcement": "report"
    },
    "workbook.codeName": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "WorkbookProperties 的 CodeName，即 VBA project 的 workbook codename（例如 ThisWorkbook）。",
      "readback": "codename string",
      "enforcement": "report"
    },
    "workbook.date1904": {
      "type": "bool",
      "aliases": ["date1904"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProperties 的 Date1904 标记：为 true 时日期使用 1904 epoch（旧版 Mac 兼容）。这是实际控制 workbook 日期系统的属性；通过设置它切换 epoch。",
      "examples": [
        "--prop workbook.date1904=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "workbook.dateCompatibility": {
      "type": "bool",
      "aliases": ["datecompatibility"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProperties 的 DateCompatibility 标记：这是独立的 OOXML 属性，不用于切换 1904 epoch；要改变日期系统请使用 workbook.date1904。",
      "examples": [
        "--prop workbook.dateCompatibility=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "workbook.filterPrivacy": {
      "type": "bool",
      "aliases": ["filterprivacy"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProperties 的 FilterPrivacy 标记：为 true 时，Excel 在 filter 保存中隐藏个人信息。",
      "examples": [
        "--prop workbook.filterPrivacy=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "workbook.showObjects": {
      "type": "enum",
      "values": ["all", "placeholders", "none"],
      "aliases": ["showobjects"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProperties 的 ShowObjects：workbook view 中嵌入 object（chart、picture、shape）的可见性。",
      "examples": [
        "--prop workbook.showObjects=all",
        "--prop workbook.showObjects=none"
      ],
      "readback": "all|placeholders|none",
      "enforcement": "report"
    },
    "workbook.lockStructure": {
      "type": "bool",
      "aliases": ["lockstructure"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProtection 的 LockStructure 标记：为 true 时，不能 add/delete/rename/reorder sheet。",
      "examples": [
        "--prop workbook.lockStructure=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "workbook.lockWindows": {
      "type": "bool",
      "aliases": ["lockwindows"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProtection 的 LockWindows 标记：为 true 时，workbook window 的大小和位置被锁定。",
      "examples": [
        "--prop workbook.lockWindows=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "workbook.password": {
      "type": "string",
      "aliases": ["workbookpassword"],
      "add": false,
      "set": true,
      "get": true,
      "description": "WorkbookProtection 的 legacy password（ECMA-376 short hash）。Set 时传入 plaintext；传入空值或 'none' 可清除。存在时 Get 返回 '***'（无法从保存的 hash 恢复 plaintext）。安全性较弱，仅用于 back-compat。",
      "examples": [
        "--prop workbook.password=secret",
        "--prop workbook.password=none"
      ],
      "readback": "*** if set, otherwise omitted",
      "enforcement": "report"
    }
  }
}
