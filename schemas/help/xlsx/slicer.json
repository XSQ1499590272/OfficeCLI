{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "slicer",
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/SheetName/slicer[N]"]
  },
  "note": "Slicer 必须关联已有的 pivot table target。'field' 必须匹配 pivot cache 中现有的 cacheField name。",
  "properties": {
    "pivotTable": {
      "type": "string",
      "description": "现有 pivot table 的路径或引用。裸名称会在宿主 sheet 的 pivots 中解析。",
      "aliases": ["pivot", "source", "tableName"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop pivotTable='/Sheet1/pivottable[1]'", "--prop tableName=Pivot1"],
      "readback": "pivot reference",
      "enforcement": "report"
    },
    "field": {
      "type": "string",
      "description": "pivot field 名称。必须匹配现有 cacheField（不区分大小写）。仅 Add 时生效；Set 会忽略此键，因为 slicer 创建时已锚定到 cache field。",
      "aliases": ["column"],
      "add": true, "set": false, "get": true,
      "examples": ["--prop field=Region", "--prop column=Region"],
      "readback": "field name",
      "enforcement": "report"
    },
    "caption": {
      "type": "string",
      "description": "slicer header 中面向用户显示的 caption。默认使用 field name。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop caption='Filter by Region'"],
      "readback": "caption",
      "enforcement": "report"
    },
    "name": {
      "type": "string",
      "description": "slicer 名称。会进行清理；默认值为 'Slicer_<fieldName>'。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop name=RegionSlicer"],
      "readback": "slicer name",
      "enforcement": "report"
    },
    "rowHeight": {
      "type": "number",
      "description": "每个 slicer item 的行高，单位为 EMU。默认 225425（约 17.5pt）。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop rowHeight=250000"],
      "readback": "row height in EMU",
      "enforcement": "report"
    },
    "columnCount": {
      "type": "number",
      "description": "slicer button grid 的列数。范围 1..20000。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop columnCount=2"],
      "readback": "number of columns",
      "enforcement": "report"
    },
    "pivotCacheId": {
      "type": "number",
      "description": "extension pivot cache id（x14 cacheField extension）。只读；创建 slicer 时自动分配。",
      "add": false, "set": false, "get": true,
      "readback": "pivot cache index (read-only)",
      "enforcement": "report"
    },
    "itemCount": {
      "type": "number",
      "description": "slicer cache 中 item（button）的总数。只读；由 pivot 的 shared items 推导。",
      "add": false, "set": false, "get": true,
      "readback": "total slicer item count",
      "enforcement": "report"
    },
    "cache": { "type":"string", "add":false, "set":false, "get":true, "description":"slicer cache 名称（Slicer @cache 属性）。", "readback":"slicer cache name", "enforcement":"report" }
  }
}
