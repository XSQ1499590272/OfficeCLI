{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "shape",
  "elementAliases": ["textbox"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/SheetName/shape[N]"
    ]
  },
  "note": "Alias：textbox。Anchor 可使用 anchor=B2:F7（cell range），或使用 cell units 的 x/y/width/height。ref=B2 会扩展为 1x1 cell rectangle。Font/text props 既接受 bare form（size、bold、color、font），也接受点号 form（font.size、font.bold、font.color、font.name）。",
  "extends": "_shared/shape",
  "properties": {
    "anchor": {
      "type": "string",
      "description": "单元格范围 anchor（如 B2:F7），仅 Add 支持。Set 使用 x/y/width/height；Get 返回 x/y/width/height，而不是单元格范围形式（通过数值位置而非 anchor string round-trip）。",
      "aliases": [
        "ref"
      ],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop anchor=B2:F7"
      ],
      "readback": "x/y/width/height (numeric)",
      "enforcement": "report"
    },
    "gradientFill": {
      "type": "string",
      "description": "两段或三段 linear gradient，如 'C1-C2[-C3][:angle]'。与 fill 互斥（gradientFill 优先）。",
      "add": true,
      "set": false,
      "examples": [
        "--prop gradientFill=FF0000-0000FF:90"
      ],
      "enforcement": "report"
    },
    "geometry": {
      "type": "string",
      "description": "geometry preset 名称（rect、ellipse、roundRect、triangle、rightArrow 等）。未知 preset 会回退为 rect，并在 stderr 输出警告。Set 会替换现有 PresetGeometry，同时保留 fill/line/effects。",
      "aliases": [
        "preset",
        "shape"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop geometry=ellipse"
      ],
      "enforcement": "report"
    },
    "flip": {
      "type": "string",
      "description": "简写 flip token：'h' / 'v' / 'both' / 'hv' / 'vh' / 'none'。",
      "add": true,
      "set": true,
      "examples": [
        "--prop flip=h",
        "--prop flip=both"
      ],
      "enforcement": "report"
    },
    "flipBoth": {
      "type": "bool",
      "description": "同时翻转两个轴。",
      "add": true,
      "set": true,
      "examples": [
        "--prop flipBoth=true"
      ],
      "enforcement": "report"
    },
    "x": {
      "type": "length",
      "description": "x 位置，以 TwoCellAnchor 的列/行索引表示。xlsx cell-anchor 定位，整数。",
      "aliases": [
        "left"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop x=2",
        "--prop x=2cm",
        "--prop x=1in",
        "--prop x=72pt"
      ],
      "readback": "integer column/row index",
      "enforcement": "strict"
    },
    "y": {
      "type": "string",
      "description": "y 位置，以 TwoCellAnchor 的列/行索引表示。xlsx cell-anchor 定位，整数。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop y=3",
        "--prop y=3cm"
      ],
      "enforcement": "report",
      "aliases": [
        "top"
      ],
      "readback": "integer column/row index"
    },
    "width": {
      "type": "string",
      "description": "宽度，以 TwoCellAnchor 的列/行索引表示。xlsx cell-anchor 定位，整数。",
      "add": true,
      "set": true,
      "get": true,
      "aliases": [
        "w"
      ],
      "examples": [
        "--prop width=4",
        "--prop width=6cm",
        "--prop width=5cm"
      ],
      "enforcement": "report",
      "readback": "integer column/row index"
    },
    "height": {
      "type": "string",
      "description": "高度，以 TwoCellAnchor 的列/行索引表示。xlsx cell-anchor 定位，整数。",
      "add": true,
      "set": true,
      "get": true,
      "aliases": [
        "h"
      ],
      "examples": [
        "--prop height=3",
        "--prop height=3cm"
      ],
      "enforcement": "report",
      "readback": "integer column/row index"
    }
  }
}
