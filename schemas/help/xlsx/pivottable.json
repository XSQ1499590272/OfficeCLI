{
  "$schema": "../_schema.json",
  "format": "xlsx",
  "element": "pivottable",
  "elementAliases": ["pivot"],
  "parent": "sheet",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/SheetName/pivottable[N]"]
  },
  "note": "Alias：pivot。'source' 必填（例如 Sheet1!A1:D100）。拒绝 external workbook ref；未提供 position 时会自动放在 source 之后。Field axes（rows/cols/filters/values）接受逗号分隔的 field name，values 使用 'Field:agg' tuple。Query 返回 pivotfield/pivotrow/pivotcolumn/pivotdata 类型的 child node；这些是只读 structural node，不能独立寻址，也不支持 Add/Set/Remove。",
  "properties": {
    "source": {
      "type": "string",
      "description": "源数据范围。别名：src。不支持外部 workbook 引用。",
      "aliases": ["src"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop source=Sheet1!A1:D100"],
      "readback": "source reference",
      "enforcement": "report"
    },
    "position": {
      "type": "string",
      "description": "锚点单元格（如 H1）。别名：pos。省略时自动放置在 source 后方。",
      "aliases": ["pos"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop position=H1"],
      "readback": "anchor cell",
      "enforcement": "report"
    },
    "name": {
      "type": "string",
      "description": "pivot table 名称（标识符）。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop name=RevenueByRegion"],
      "readback": "pivot name",
      "enforcement": "report"
    },
    "style": {
      "type": "string",
      "description": "内置或 workbook 自定义的 pivot style 名称（如 PivotStyleMedium9）。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop style=PivotStyleMedium9"],
      "readback": "style name",
      "enforcement": "report"
    },
    "rows": {
      "type": "string",
      "description": "row axis 字段名，使用逗号分隔（如 'Region,Category'）。别名：row、rowField、rowFields。",
      "aliases": ["row", "rowField", "rowFields"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop rows=Region,Category"],
      "readback": "comma-separated field names",
      "enforcement": "report"
    },
    "cols": {
      "type": "string",
      "description": "column axis 字段名，使用逗号分隔。别名：col、column、columns、colField、colFields、columnField、columnFields。",
      "aliases": ["col", "column", "columns", "colField", "colFields", "columnField", "columnFields"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop cols=Date"],
      "readback": "comma-separated field names",
      "enforcement": "report"
    },
    "filters": {
      "type": "string",
      "description": "page/filter axis 字段名，使用逗号分隔。别名：filter、filterField、filterFields。",
      "aliases": ["filter", "filterField", "filterFields"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop filters=Year"],
      "readback": "comma-separated field names",
      "enforcement": "report"
    },
    "values": {
      "type": "string",
      "description": "value axis 字段，格式为逗号分隔的 'Field:agg' 元组（如 'Sales:sum,Qty:avg'）。agg 可为 sum、avg、count、max、min、product、stdev、stdevp、var、varp、countNums。别名：value、valueField、valueFields。",
      "aliases": ["value", "valueField", "valueFields"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop values=Sales:sum,Qty:avg"],
      "readback": "value field tuples",
      "enforcement": "report"
    },
    "aggregate": {
      "type": "string",
      "description": "当 --prop values 未指定 agg 时 value field 使用的默认聚合方式。可选 sum、avg、count、max、min、product、stdev、stdevp、var、varp、countNums。",
      "add": true, "set": true, "get": false,
      "examples": ["--prop aggregate=avg"],
      "readback": "n/a (per-value override)",
      "enforcement": "report"
    },
    "showDataAs": {
      "type": "string",
      "description": "value field 的显示方式：normal、percentOfTotal、percentOfRow、percentOfCol、runningTotal。（暂不支持 percentOfParent / rankAscending / rankDescending / index / difference / percentDifference。）",
      "aliases": ["showdataas"],
      "add": true, "set": true, "get": false,
      "examples": ["--prop showDataAs=percentOfTotal"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "topN": {
      "type": "string",
      "description": "仅保留按第一个 value field 聚合结果排序后的前 N 个 row key。N 必须是 >= 1 的整数；筛选在建立 cache 前应用于 source rows。仅 add 时生效，Set 会忽略此键。",
      "aliases": ["topn"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop topN=10"],
      "readback": "n/a (filters source rows)",
      "enforcement": "report"
    },
    "sort": {
      "type": "enum",
      "values": ["asc", "desc", "locale", "locale-desc", "none"],
      "description": "axis label 排序。'none'（或空值）会清除排序。",
      "add": true, "set": true, "get": false,
      "examples": ["--prop sort=desc"],
      "readback": "n/a (label order in axis)",
      "enforcement": "report"
    },
    "layout": {
      "type": "enum",
      "values": ["compact", "outline", "tabular"],
      "description": "报表布局模式。默认值：compact。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop layout=tabular"],
      "readback": "layout name",
      "enforcement": "report"
    },
    "labelFilter": {
      "type": "string",
      "description": "在建立 cache 前应用的行级 label filter，格式为 'field:type:value'（如 'Region:beginsWith:N'）。type 可为 equals、notEquals、beginsWith、endsWith、contains、notContains、greaterThan、greaterThanEqual、lessThan、lessThanEqual、between、notBetween。仅 add 时生效，Set 会忽略此键。",
      "aliases": ["labelfilter"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop labelFilter=Region:beginsWith:N"],
      "readback": "n/a (filters source rows)",
      "enforcement": "report"
    },
    "calculatedField": {
      "type": "string",
      "description": "用户自定义公式字段，格式为 'Name:=Formula'（如 'Margin:=Sales-Cost'）。多个字段请使用 calculatedField1、calculatedField2 等。别名：calculatedFields。仅 add 时生效，Set 会忽略此键。",
      "aliases": ["calculatedfield", "calculatedfields"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop calculatedField=Margin:=Sales-Cost", "--prop calculatedField1=Margin:=Sales-Cost --prop calculatedField2=Tax:=Sales*0.1"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "repeatLabels": {
      "type": "bool",
      "description": "在每一行重复 outer axis item label（fillDown）。别名：repeatItemLabels、repeatAllLabels、fillDownLabels。",
      "aliases": ["repeatlabels", "repeatItemLabels", "repeatAllLabels", "fillDownLabels"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop repeatLabels=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "blankRows": {
      "type": "bool",
      "description": "在每个 outer item group 后插入空白行。别名：insertBlankRow、insertBlankRows、blankRow、blankLine、blankLines。",
      "aliases": ["blankrows", "insertBlankRow", "insertBlankRows", "blankRow", "blankLine", "blankLines"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop blankRows=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "grandTotals": {
      "type": "enum",
      "values": ["both", "none", "rows", "cols", "on", "off", "true", "false"],
      "description": "grand total 的显示方式。'rows' 仅显示 grand-total row；'cols' 仅显示 grand-total column；'both'/'on'/'true' 同时显示；'none'/'off'/'false' 全部隐藏。",
      "aliases": ["grandtotals"],
      "add": true, "set": true, "get": false,
      "examples": ["--prop grandTotals=both"],
      "readback": "n/a (use rowGrandTotals/colGrandTotals on get)",
      "enforcement": "report"
    },
    "rowGrandTotals": {
      "type": "bool",
      "description": "是否显示 row axis grand total；与 colGrandTotals 相互独立。",
      "aliases": ["rowgrandtotals"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop rowGrandTotals=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "colGrandTotals": {
      "type": "bool",
      "description": "是否显示 column axis grand total。别名：columnGrandTotals。",
      "aliases": ["colgrandtotals", "columnGrandTotals"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop colGrandTotals=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "grandTotalCaption": {
      "type": "string",
      "description": "Grand Total 行/列显示的标签文本（默认 'Grand Total'）。",
      "aliases": ["grandtotalcaption"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop grandTotalCaption=\"Total\""],
      "readback": "caption text",
      "enforcement": "report"
    },
    "subtotals": {
      "type": "enum",
      "values": ["on", "off", "true", "false", "show", "hide", "yes", "no", "1", "0"],
      "description": "显示或隐藏 outer level 的 subtotal rows。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop subtotals=off"],
      "readback": "on/off",
      "enforcement": "report"
    },
    "defaultSubtotal": {
      "type": "bool",
      "description": "新 pivot field 的 default-subtotal 标志（每个字段对应 <pivotField defaultSubtotal=...>）。",
      "aliases": ["defaultsubtotal"],
      "add": true, "set": true, "get": false,
      "examples": ["--prop defaultSubtotal=true"],
      "readback": "n/a (per-field)",
      "enforcement": "report"
    },
    "showRowStripes": {
      "type": "bool",
      "description": "pivot style 的隔行条纹。别名：bandedRows。",
      "aliases": ["showrowstripes", "bandedRows"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop showRowStripes=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showColStripes": {
      "type": "bool",
      "description": "pivot style 的隔列条纹。别名：showColumnStripes、bandedCols、bandedColumns。",
      "aliases": ["showcolstripes", "showColumnStripes", "bandedCols", "bandedColumns"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop showColStripes=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showRowHeaders": {
      "type": "bool",
      "description": "显示 row axis header 的样式（pivotTableStyleInfo）。",
      "aliases": ["showrowheaders"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop showRowHeaders=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showColHeaders": {
      "type": "bool",
      "description": "显示 column axis header 的样式。别名：showColumnHeaders。",
      "aliases": ["showcolheaders", "showColumnHeaders"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop showColHeaders=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showLastColumn": {
      "type": "bool",
      "description": "在 pivot style 中突出显示最后一列。",
      "aliases": ["showlastcolumn"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop showLastColumn=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "showDrill": {
      "type": "bool",
      "description": "在每个 pivot field 上显示展开/折叠（+/-）按钮。仅 add 时生效，Set 会忽略此键。",
      "aliases": ["showdrill"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop showDrill=false"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "mergeLabels": {
      "type": "bool",
      "description": "合并并居中重复的 outer axis item 单元格（<pivotTableDefinition mergeItem='1'>）。仅 add 时生效，Set 会忽略此键。",
      "aliases": ["mergelabels"],
      "add": true, "set": false, "get": false,
      "examples": ["--prop mergeLabels=true"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "cacheId": {
      "type": "number",
      "description": "pivot cache 索引（只读；创建 pivot table 时由 Excel 分配）。",
      "add": false, "set": false, "get": true,
      "readback": "pivot cache index (read-only; assigned by Excel)",
      "enforcement": "report"
    },
    "fieldCount": {
      "type": "number",
      "description": "source range 中 pivot field 的总数（只读）。",
      "add": false, "set": false, "get": true,
      "readback": "total number of pivot fields in the source range",
      "enforcement": "report"
    },
    "dataFieldCount": {
      "type": "number",
      "description": "data field 聚合项数量（只读；等于 dataField{N} 条目的数量）。",
      "add": false, "set": false, "get": true,
      "readback": "number of data field aggregations",
      "enforcement": "report"
    },
    "dataField{N}": {
      "type": "string",
      "description": "每个 data field 的读取结果（从 1 开始：dataField1、dataField2 等），格式为 'name:aggFunc:fieldIdx'。当 ShowDataAs != normal 时，Get 还会返回 dataField{N}.showAs。",
      "add": false, "set": false, "get": true,
      "readback": "packed as 'name:aggFunc:fieldIdx'; name reflects Excel's stored DataField/@name which includes auto-prefixes (e.g. 'Sum of Revenue:sum:1')",
      "enforcement": "report"
    },
    "dataField{N}.showAs": {
      "type": "enum",
      "values": ["percent_of_total", "percent_of_row", "percent_of_col", "running_total", "difference", "percent_diff", "index"],
      "description": "data field 的 showAs token（只读）。值会由 OOXML ShowDataAs 规范化而来。",
      "add": false, "set": false, "get": true,
      "readback": "showAs canonical token",
      "enforcement": "report"
    },
    "location": {
      "type": "string",
      "add": false, "set": false, "get": true,
      "description": "pivot table 的渲染目标单元格范围（如 D1:E4）。",
      "readback": "A1 range string",
      "enforcement": "report"
    },
    "collapsedFields": {
      "type": "string",
      "add": false, "set": false, "get": true,
      "description": "包含 collapsed items 的字段名称，使用逗号分隔。",
      "readback": "comma-separated field names",
      "enforcement": "report"
    },
    "axisAsDataField":   { "type":"bool",   "add":false, "set":false, "get":true, "description":"在 axis 上作为 data field 的字段名称，使用逗号分隔。", "readback":"comma-separated field names", "enforcement":"report" },
    "sortByField":       { "type":"string", "add":false, "set":false, "get":true, "description":"排序元组，格式为逗号分隔的 'field:direction'。", "readback":"comma-separated sort tuples", "enforcement":"report" }
  }
}
