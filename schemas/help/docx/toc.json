{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "toc",
  "elementAliases": ["tableofcontents"],
  "parent": "body|paragraph",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/toc", "/tableofcontents"]
  },
  "note": "Aliases：tableofcontents。插入 TOC field（complex fldChar）。除非使用 'pre-render'，否则 Word 打开文档时会重新构建渲染后的条目。",
  "properties": {
    "levels": {
      "type": "string",
      "description": "heading 层级范围（例如 '1-3'）。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop levels=1-3"],
      "readback": "levels string",
      "enforcement": "report"
    },
    "title": {
      "type": "string",
      "description": "TOC 上方可选的 caption。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop title=\"Contents\""],
      "readback": "caption text",
      "enforcement": "report"
    },
    "hyperlinks": {
      "type": "bool",
      "description": "生成可点击的 links。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop hyperlinks=true"],
      "readback": "true/false",
      "enforcement": "report"
    },
    "pageNumbers": {
      "type": "bool",
      "description": "在 TOC 条目中包含页码（Add/Set 使用小写 alias 'pagenumbers'）。",
      "aliases": ["pagenumbers"],
      "add": true, "set": true, "get": true,
      "examples": ["--prop pageNumbers=false"],
      "readback": "true if TOC includes page numbers",
      "enforcement": "report"
    }
  }
}
