{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "style",
  "parent": "styles",
  "addParent": "/styles",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "stable": [
      "/styles/StyleId"
    ]
  },
  "note": "Style type 默认是 paragraph。'id' 必须在 styles.xml 中唯一；显式重复 id 会被拒绝，否则系统会自动追加后缀。内置 id（Normal、Heading1..9、Title、Subtitle、Quote、IntenseQuote、ListParagraph、NoSpacing、TOCHeading）不受 customStyle=true 限制。/style[@name=NAME] 和 /style[N] path 不支持，只有 /styles/StyleId 可解析；navigation 也不处理顶层的 bare 'style' segment。",
  "properties": {
    "id": {
      "type": "string",
      "description": "w:styleId（唯一且不可变的 identity）。省略 'id' 时，alias 会转而使用 'name'。Add 后改名需要重写 document 中每个 paragraph/run/basedOn reference；不支持。",
      "aliases": [
        "styleId",
        "styleid"
      ],
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop id=MyAccent",
        "--prop styleId=MyAccent"
      ],
      "readback": "StyleId value",
      "enforcement": "strict"
    },
    "name": {
      "type": "string",
      "description": "显示名称。省略时默认使用 'id'。",
      "aliases": [
        "styleName",
        "stylename"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop name=\"My Accent\"",
        "--prop styleName=\"My Accent\""
      ],
      "readback": "StyleName.Val",
      "enforcement": "report"
    },
    "type": {
      "type": "enum",
      "values": [
        "paragraph",
        "character",
        "table",
        "numbering"
      ],
      "aliases": {
        "character": [
          "char"
        ],
        "paragraph": [
          "para"
        ]
      },
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop type=paragraph"
      ],
      "readback": "one of values (innerText of StyleValues)",
      "enforcement": "report",
      "note": "Style type 在创建时固定；创建后改变 type 会使已引用该 style 的 paragraph/run 失去关联。如需另一种 type，请重新创建 style。"
    },
    "basedOn": {
      "type": "string",
      "description": "要继承的 parent style id。必须是已有 w:styleId（不是显示名称）。本 style 定义的 property 会覆盖继承的 property。",
      "aliases": [
        "basedon"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop basedOn=Normal"
      ],
      "readback": "BasedOn.Val",
      "enforcement": "report"
    },
    "basedOn.path": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "解析后的 parent style node 路径（仅 get）。快捷方式：Set 请使用 basedOn。",
      "readback": "/styles/{styleId}",
      "enforcement": "report"
    },
    "next": {
      "type": "string",
      "description": "下一 paragraph 的 style id。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop next=Normal"
      ],
      "readback": "NextParagraphStyle.Val",
      "enforcement": "report"
    },
    "linked": {
      "type": "string",
      "aliases": [
        "link"
      ],
      "description": "linked-style 对：paragraph style 引用配套 character style（或反之）。Word UI 中显示为“Linked (paragraph and character)”。值为配套 styleId，必须存在于 styles.xml。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop linked=MyCharStyle"
      ],
      "readback": "LinkedStyle.Val",
      "enforcement": "report"
    },
    "qFormat": {
      "type": "bool",
      "aliases": [
        "qformat"
      ],
      "description": "标记为显示在 Word Styles gallery 中的“primary”（quick）style（<w:qFormat/>）。默认 Normal style 带有此标记；若不在往返中保留，gallery designation 会丢失。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop qFormat=true"
      ],
      "readback": "presence of <w:qFormat/>",
      "enforcement": "report"
    },
    "uiPriority": {
      "type": "int",
      "aliases": [
        "uipriority"
      ],
      "description": "style 在 Word Styles pane / Recommended list 中的排序（<w:uiPriority>）。值越小越靠前。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop uiPriority=9"
      ],
      "readback": "UIPriority.Val",
      "enforcement": "report"
    },
    "semiHidden": {
      "type": "bool",
      "aliases": [
        "semihidden"
      ],
      "description": "从主 Styles gallery 隐藏 style，但仍可使用（<w:semiHidden/>）。通常与 unhideWhenUsed 配合。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop semiHidden=true"
      ],
      "readback": "presence of <w:semiHidden/>",
      "enforcement": "report"
    },
    "unhideWhenUsed": {
      "type": "bool",
      "aliases": [
        "unhidewhenused"
      ],
      "description": "当 semiHidden style 首次应用于 document 时，在 gallery 中显示它（<w:unhideWhenUsed/>）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop unhideWhenUsed=true"
      ],
      "readback": "presence of <w:unhideWhenUsed/>",
      "enforcement": "report"
    },
    "locked": {
      "type": "bool",
      "description": "当 document formatting protection 启用时，锁定该 style 不可使用（<w:locked/>）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop locked=true"
      ],
      "readback": "presence of <w:locked/>",
      "enforcement": "report"
    },
    "customStyle": {
      "type": "bool",
      "aliases": [
        "customstyle"
      ],
      "description": "将 style 标记为用户创建，而非 Word 内置 style（<w:customStyle/>）。会原样经过 dump->batch，避免将改为短 id（Normal->'a'）的内置 style 在重建时误标为 custom。未在 `add`/`set` 指定时，会按 styleId 推断是否内置。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop customStyle=true"
      ],
      "readback": "CustomStyle.Val (always emitted, true or false)",
      "enforcement": "report"
    },
    "align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right",
        "justify",
        "both",
        "distribute"
      ],
      "aliases": [
        "alignment"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop align=center"
      ],
      "readback": "one of values",
      "enforcement": "report"
    },
    "spaceBefore": {
      "type": "length",
      "aliases": [
        "spacebefore"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop spaceBefore=12pt"
      ],
      "readback": "unit-qualified",
      "enforcement": "report"
    },
    "spaceAfter": {
      "type": "length",
      "aliases": [
        "spaceafter"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop spaceAfter=6pt"
      ],
      "readback": "unit-qualified",
      "enforcement": "report"
    },
    "spaceBeforeAuto": {
      "type": "boolean",
      "aliases": [
        "beforeAutospacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "w:spacing @beforeAutospacing——控制使用该 style 的 paragraph 段前间距的 Word“同样式段落自动间距”开关（例如内置 'Normal (Web)' style）。仅在存在时由 get 返回。",
      "examples": [
        "--prop spaceBeforeAuto=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "spaceAfterAuto": {
      "type": "boolean",
      "aliases": [
        "afterAutospacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "w:spacing @afterAutospacing——控制使用该 style 的 paragraph 段后间距的自动间距开关。参见 spaceBeforeAuto。",
      "examples": [
        "--prop spaceAfterAuto=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "font": {
      "type": "string",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font=\"Calibri\""
      ],
      "readback": "font name",
      "enforcement": "report"
    },
    "font.ea": {
      "type": "string",
      "description": "该 style 的 East-Asian 字体槽位（rFonts/eastAsia）——Chinese / Japanese / Korean 字体。",
      "aliases": [
        "font.eastAsia",
        "font.eastasia",
        "font.eastasian"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.ea=\"メイリオ\""
      ],
      "enforcement": "report"
    },
    "font.cs": {
      "type": "string",
      "description": "该 style 的 complex-script 字体槽位（rFonts/cs）——Arabic / Hebrew / Thai 字体。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.cs=\"Arabic Typesetting\""
      ],
      "enforcement": "report"
    },
    "font.asciiTheme": {
      "type": "string",
      "description": "该 style 的 ascii 槽位 Theme font binding（rFonts/asciiTheme）。可选值：minorHAnsi、majorHAnsi、minorEastAsia、majorEastAsia、minorBidi、majorBidi。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.asciiTheme=majorHAnsi"
      ],
      "enforcement": "report"
    },
    "font.hAnsiTheme": {
      "type": "string",
      "description": "该 style 的 hAnsi 槽位 Theme font binding（rFonts/hAnsiTheme）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.hAnsiTheme=majorHAnsi"
      ],
      "enforcement": "report"
    },
    "font.eaTheme": {
      "type": "string",
      "description": "该 style 的 East-Asia 槽位 Theme font binding（rFonts/eastAsiaTheme）。可选值：minorEastAsia、majorEastAsia。",
      "aliases": [
        "font.eastAsiaTheme"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.eaTheme=majorEastAsia"
      ],
      "enforcement": "report"
    },
    "font.csTheme": {
      "type": "string",
      "description": "该 style 的 complex-script 槽位 Theme font binding（rFonts/cstheme）。可选值：minorBidi、majorBidi。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.csTheme=majorBidi"
      ],
      "enforcement": "report"
    },
    "size": {
      "type": "font-size",
      "description": "字体大小。接受不带单位的数值或带 pt 后缀的值。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop size=14"
      ],
      "readback": "unit-qualified pt",
      "enforcement": "report"
    },
    "bold": {
      "type": "bool",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop bold=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "italic": {
      "type": "bool",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop italic=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "color": {
      "type": "color",
      "description": "字体颜色。接受 #RRGGBB、RRGGBB、命名颜色（red、blue 等）、rgb(r,g,b) 或三字符简写（F00）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop color=#FF0000"
      ],
      "readback": "#-prefixed uppercase hex",
      "enforcement": "report"
    },
    "underline": {
      "type": "string",
      "description": "下划线样式（true/false、single、double、thick、dotted、dash、wavy、none 等）。应用于该 style 的 rPr。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop underline=single",
        "--prop underline=double"
      ],
      "readback": "underline style or true/false",
      "enforcement": "report"
    },
    "strike": {
      "type": "bool",
      "description": "该 style rPr 上的单删除线。",
      "aliases": [
        "strikethrough"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop strike=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "dstrike": {
      "type": "bool",
      "description": "该 style rPr 上的双删除线。",
      "aliases": [
        "doublestrike"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop dstrike=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "highlight": {
      "type": "string",
      "description": "突出显示颜色（yellow、green、cyan、magenta、blue、red、darkBlue、darkCyan、darkGreen、darkMagenta、darkRed、darkYellow、darkGray、lightGray、black、white、none）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop highlight=yellow"
      ],
      "readback": "highlight color name",
      "enforcement": "report"
    },
    "caps": {
      "type": "bool",
      "description": "该 style rPr 上的全大写显示。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop caps=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "smallCaps": {
      "type": "bool",
      "description": "该 style rPr 上的小型大写显示。",
      "aliases": [
        "smallcaps"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop smallCaps=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "vanish": {
      "type": "bool",
      "description": "该 style rPr 上的隐藏文本。",
      "aliases": [
        "hidden"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop vanish=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "rtl": {
      "type": "bool",
      "description": "该 style rPr 上从右到左的 run layout。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop rtl=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "vertAlign": {
      "type": "enum",
      "values": [
        "superscript",
        "subscript",
        "baseline"
      ],
      "description": "该 style rPr 上的垂直文本对齐（superscript/subscript）。",
      "aliases": [
        "vertalign",
        "verticalAlign"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop vertAlign=superscript"
      ],
      "readback": "one of values",
      "enforcement": "report"
    },
    "charSpacing": {
      "type": "length",
      "description": "该 style rPr 上的字符间距（letter-spacing）。",
      "aliases": [
        "charspacing",
        "letterSpacing",
        "letterspacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop charSpacing=2pt"
      ],
      "readback": "unit-qualified pt",
      "enforcement": "report"
    },
    "shading": {
      "type": "color",
      "description": "该 style rPr 的背景 shading fill color（paragraph style 则为 pPr）。",
      "aliases": [
        "shd"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop shading=#FFFF00"
      ],
      "readback": "#-prefixed uppercase hex",
      "enforcement": "report"
    },
    "lineSpacing": {
      "type": "string",
      "description": "行距——倍数（1.5x、150%）或固定值（18pt）。应用于该 style 的 pPr。",
      "aliases": [
        "linespacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop lineSpacing=1.5x",
        "--prop lineSpacing=18pt"
      ],
      "readback": "\"<N>x\" or \"<N>pt\"",
      "enforcement": "report"
    },
    "lineRule": {
      "type": "enum",
      "description": "与 lineSpacing 配套的行距规则。'auto' = 倍数，'exact' = 精确固定高度，'atLeast' = 最小高度（行可随较高内容增大）。应用于该 style 的 pPr。",
      "values": [
        "auto",
        "exact",
        "atLeast"
      ],
      "aliases": [
        "linerule"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop lineSpacing=14pt --prop lineRule=atLeast"
      ],
      "readback": "auto | exact | atLeast",
      "enforcement": "report"
    },
    "contextualSpacing": {
      "type": "bool",
      "description": "抑制同一 style 的 paragraph 之间的间距。",
      "aliases": [
        "contextualspacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop contextualSpacing=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "outlineLvl": {
      "type": "int",
      "description": "outline 级别（0–9，0=Heading 1）。驱动 TOC 和 Navigator。应用于该 style 的 pPr。",
      "aliases": [
        "outlinelvl",
        "outlineLevel",
        "outlinelevel"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop outlineLvl=0"
      ],
      "readback": "integer 0-9",
      "enforcement": "report"
    },
    "kinsoku": {
      "type": "bool",
      "description": "kinsoku（CJK 换行规则）开关。应用于该 style 的 pPr。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop kinsoku=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "snapToGrid": {
      "type": "bool",
      "description": "为 CJK layout 对齐到 document grid。应用于该 style 的 pPr。仅 Add/Set；当前 Get 不返回此项。",
      "aliases": [
        "snaptogrid"
      ],
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop snapToGrid=false"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "wordWrap": {
      "type": "bool",
      "description": "允许 CJK 行内的非 CJK 文本断词。应用于该 style 的 pPr。仅 Add/Set；当前 Get 不返回此项。",
      "aliases": [
        "wordwrap"
      ],
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop wordWrap=true"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "autoSpaceDE": {
      "type": "bool",
      "description": "East-Asian 与 Latin 文本之间的自动间距。应用于该 style 的 pPr。",
      "aliases": [
        "autospacede"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop autoSpaceDE=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "autoSpaceDN": {
      "type": "bool",
      "description": "East-Asian 文本与数字之间的自动间距。应用于该 style 的 pPr。",
      "aliases": [
        "autospacedn"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop autoSpaceDN=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "bidi": {
      "type": "bool",
      "description": "从右到左的 paragraph direction。应用于该 style 的 pPr。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop bidi=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "direction": {
      "type": "enum",
      "values": [
        "rtl",
        "ltr"
      ],
      "aliases": [
        "dir"
      ],
      "description": "Paragraph 阅读方向（Arabic / Hebrew）。'rtl' 会在 style pPr 上写入 <w:bidi/>；标准形式等同于 bidi=true。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop direction=rtl"
      ],
      "readback": "rtl | ltr",
      "enforcement": "report"
    },
    "overflowPunct": {
      "type": "bool",
      "description": "允许标点悬挂在文本页边距之外（CJK）。应用于该 style 的 pPr。",
      "aliases": [
        "overflowpunct"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop overflowPunct=true"
      ],
      "readback": "true/false",
      "enforcement": "report"
    },
    "topLinePunct": {
      "type": "bool",
      "description": "压缩行首标点（CJK）。应用于该 style 的 pPr。仅 Add/Set；当前 Get 不返回此项。",
      "aliases": [
        "toplinepunct"
      ],
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop topLinePunct=true"
      ],
