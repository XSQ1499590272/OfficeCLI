    },
    "effective.italic.src": {
      "type": "string",
      "description": "effective.italic 的来源指针。已有文档说明但当前不输出。",
      "add": false,
      "set": false,
      "get": false,
      "readback": "n/a (planned)",
      "enforcement": "report"
    },
