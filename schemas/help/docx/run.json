{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "run",
  "elementAliases": [
    "r"
  ],
  "parent": "paragraph",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "remove": true
  },
  "paths": {
    "stable": [
      "/body/p[@paraId=ID]/r[N]"
    ],
    "positional": [
      "/body/p[N]/r[N]"
    ]
  },
  "note": "effective.*（如 effective.size、effective.bold、effective.color）是只读的继承解析值，run 会沿 run/paragraph style chain 解析到 docDefaults；每个值带 effective.X.src 指向实际写入层。设置 direct value 后不会返回对应 effective.*。也可以不定位单个 run，使用 set <paragraph-or-body-path> --prop range=START:END --prop bold=true 按字符偏移格式化（0-based、半开区间；支持多个不连续 span），handler 会拆分覆盖该范围的 run 并只格式化对应片段。path 的 [N] 是 1-based，range 是 0-based；find 与 range 不能同时使用，range 仅用于 run-level formatting。",
  "extends": [
    "_shared/run",
    "_shared/run.docx-pptx",
    "_shared/run.docx-xlsx"
  ],
  "properties": {
    "highlight": {
      "type": "color",
      "description": "Word 内置突出显示颜色。接受命名颜色（yellow、green、cyan、magenta、blue、red 等）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop highlight=yellow"
      ],
      "readback": "highlight color name",
      "enforcement": "report"
    },
    "strike": {
      "type": "bool",
      "description": "单删除线。",
      "aliases": [
        "strikethrough",
        "font.strike",
        "font.strikethrough"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop strike=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "dstrike": {
      "type": "bool",
      "description": "双删除线。",
      "aliases": [
        "doublestrike",
        "doubleStrike"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop dstrike=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "caps": {
      "type": "bool",
      "description": "以全大写呈现文本（仅显示效果；底层文本不变）。",
      "aliases": [
        "allCaps"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop caps=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "smallcaps": {
      "type": "bool",
      "description": "将小写字母呈现为小型大写字母。",
      "aliases": [
        "smallCaps"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop smallcaps=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "vanish": {
      "type": "bool",
      "description": "隐藏文本（不呈现，但仍保留在文件中）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop vanish=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "outline": {
      "type": "bool",
      "description": "轮廓（文本效果）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop outline=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "shadow": {
      "type": "bool",
      "description": "阴影（文本效果）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop shadow=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "emboss": {
      "type": "bool",
      "description": "浮雕（文本效果）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop emboss=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "imprint": {
      "type": "bool",
      "description": "凹印 / 雕刻（文本效果）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop imprint=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "noproof": {
      "type": "bool",
      "description": "将此 run 排除在拼写/语法检查之外。",
      "aliases": [
        "noProof"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop noproof=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "rtl": {
      "type": "bool",
      "description": "从右到左文本（'direction' 的 legacy 别名）。Get 将其以 direction=rtl|ltr 返回。",
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop rtl=true"
      ],
      "enforcement": "strict"
    },
    "direction": {
      "type": "enum",
      "values": [
        "ltr",
        "rtl"
      ],
      "description": "run 阅读方向。Arabic / Hebrew 请使用 'rtl'，传入 'ltr' 清除。run direction 的标准 key，与 paragraph/section 的词汇一致。",
      "aliases": [
        "dir"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop direction=rtl"
      ],
      "readback": "rtl | ltr",
      "enforcement": "strict"
    },
    "font.cs": {
      "type": "string",
      "description": "complex-script 字体槽位（rFonts/cs）——Arabic / Hebrew / Thai 字体。",
      "aliases": [
        "font.complexscript",
        "font.complex"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.cs=\"Arabic Typesetting\""
      ],
      "enforcement": "report"
    },
    "font.ea": {
      "type": "string",
      "description": "East-Asian 字体槽位（rFonts/eastAsia）——Chinese / Japanese / Korean 字体。",
      "aliases": [
        "font.eastasia",
        "font.eastasian"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.ea=\"メイリオ\""
      ],
      "enforcement": "report"
    },
    "font.latin": {
      "type": "string",
      "description": "Latin 字体槽位（rFonts/ascii + hAnsi）——ASCII / Western 文本。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.latin=Calibri"
      ],
      "enforcement": "report"
    },
    "font.hint": {
      "type": "string",
      "description": "字体槽位 hint（rFonts/hint）——告诉 Word 对歧义字符（CJK 数字、标点）使用哪个槽位（eastAsia / cs / default），从而使用预期字体呈现。可选值：eastAsia、cs、default。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.hint=eastAsia"
      ],
      "enforcement": "report"
    },
    "font.asciiTheme": {
      "type": "string",
      "description": "ascii 槽位的 Theme font binding（rFonts/asciiTheme）。可选值：minorHAnsi、majorHAnsi、minorEastAsia、majorEastAsia、minorBidi、majorBidi。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.asciiTheme=minorHAnsi"
      ],
      "enforcement": "report"
    },
    "font.hAnsiTheme": {
      "type": "string",
      "description": "hAnsi 槽位的 Theme font binding（rFonts/hAnsiTheme）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.hAnsiTheme=minorHAnsi"
      ],
      "enforcement": "report"
    },
    "font.eaTheme": {
      "type": "string",
      "description": "East-Asia 槽位的 Theme font binding（rFonts/eastAsiaTheme）。可选值：minorEastAsia、majorEastAsia。",
      "aliases": [
        "font.eastAsiaTheme"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.eaTheme=minorEastAsia"
      ],
      "enforcement": "report"
    },
    "font.csTheme": {
      "type": "string",
      "description": "complex-script 槽位的 Theme font binding（rFonts/cstheme）。可选值：minorBidi、majorBidi。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.csTheme=minorBidi"
      ],
      "enforcement": "report"
    },
    "bold.cs": {
      "type": "bool",
      "description": "complex-script 粗体（<w:bCs/>）。Word 通过此标记而非 <w:b/> 呈现 Arabic / Hebrew 粗体；Arabic 粗体要实际呈现必须设置此项。",
      "aliases": [
        "font.bold.cs",
        "boldcs"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop bold.cs=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "italic.cs": {
      "type": "bool",
      "description": "complex-script 斜体（<w:iCs/>）。对 Arabic / Hebrew 文本的斜体样式，其作用与 bold.cs 对粗体的作用相同。",
      "aliases": [
        "font.italic.cs",
        "italiccs"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop italic.cs=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "size.cs": {
      "type": "font-size",
      "description": "complex-script 字体大小（<w:szCs/>）。独立于不带子字段的 'size'（<w:sz/>），后者仅设置 Latin 文本大小。",
      "aliases": [
        "font.size.cs",
        "sizecs"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop size.cs=14pt",
        "--prop size.cs=14"
      ],
      "readback": "unit-qualified, e.g. \"14pt\"",
      "enforcement": "strict"
    },
    "lang.latin": {
      "type": "string",
      "description": "Latin-script language tag（<w:lang w:val=.../>），例如 en-US、fr-FR。",
      "aliases": [
        "lang",
        "lang.val"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop lang.latin=en-US"
      ],
      "readback": "BCP-47 / xml:lang tag, e.g. \"en-US\"",
      "enforcement": "lenient"
    },
    "lang.ea": {
      "type": "string",
      "description": "EastAsian-script language tag（<w:lang w:eastAsia=.../>），例如 zh-CN、ja-JP。",
      "aliases": [
        "lang.eastAsia",
        "lang.eastAsian"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop lang.ea=zh-CN"
      ],
      "readback": "BCP-47 / xml:lang tag",
      "enforcement": "lenient"
    },
    "lang.cs": {
      "type": "string",
      "description": "ComplexScript language tag（<w:lang w:bidi=.../>），例如 ar-SA、he-IL。",
      "aliases": [
        "lang.complexScript",
        "lang.bidi"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop lang.cs=ar-SA"
      ],
      "readback": "BCP-47 / xml:lang tag",
      "enforcement": "lenient"
    },
    "vertAlign": {
      "type": "enum",
      "description": "垂直文本对齐。可选值：superscript|super、subscript|sub、baseline。",
      "aliases": [
        "vertalign"
      ],
      "values": [
        "superscript",
        "super",
        "subscript",
        "sub",
        "baseline"
      ],
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop vertAlign=superscript"
      ],
      "readback": "n/a (surfaces as superscript/subscript flag)",
      "enforcement": "report"
    },
    "kern": {
      "type": "int",
      "description": "kerning 启用阈值（<w:kern w:val=.../>）：达到或超过此 point size 的字体会自动应用字偶距调整。值为 half-points 整数（28 = 14pt 阈值）；不接受 'pt' 后缀（不同于 pptx kern）。有效范围为 0–3277 half-points（约 164pt）；空值可清除。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop kern=28"
      ],
      "readback": "integer half-points, e.g. \"28\"",
      "enforcement": "report"
    },
    "position": {
      "type": "length",
      "description": "垂直 baseline 位移（<w:position w:val=.../>）：正值将文本抬高到 baseline 之上，负值降低，0 = baseline。会保持完整 glyph 大小（不同于 vertAlign=super|sub，后者也会缩小 glyph）。接受 'pt' 值（例如 6pt）或 half-points 的整数；空值可清除。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop position=6pt",
        "--prop position=-3pt"
      ],
      "readback": "unit-qualified pt, e.g. \"6pt\"",
      "enforcement": "report"
    },
    "charSpacing": {
      "type": "length",
      "description": "字符间距（letter spacing），单位为 points。以 twips × 20 存储。",
      "aliases": [
        "charspacing",
        "letterspacing",
        "letterSpacing",
        "spacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop charSpacing=1pt",
        "--prop charspacing=2"
      ],
      "readback": "unit-qualified pt, e.g. \"1pt\"",
      "enforcement": "report"
    },
    "fill": {
      "type": "color",
      "description": "run 背景 shading（w:shd @fill）。纯色背景会以此标准 key 读取（与 table cell 和 paragraph 一致）。接受纯色：hex（'FF0000'）、带 '#' 的 hex（'#FF0000'）、命名颜色（'red'）或 rgb(...)。若需真实的 pattern shading（pct*/stripe/cross）或前景 pattern color，请传入旧版 `shading`/`shd` 三段形式 'PATTERN;FILL[;COLOR]'；读取结果会通过 shading.* detail key 返回。它不同于 `highlight`（w:highlight marker）和 w14 text shadow。",
      "aliases": [
        "shading",
        "shd"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop fill=FFFF00",
        "--prop fill=#FF0000",
        "--prop shd=\"pct25;FF0000;0000FF\""
      ],
      "readback": "#RRGGBB uppercase",
      "enforcement": "report"
    },
    "shading": {
      "type": "color",
      "description": "背景 shading 颜色或 '<pattern>;<fill>;<color>' 三元组。Set 侧是 `fill` 的别名；纯色背景通过标准 `fill` key 返回。",
      "aliases": [
        "shd"
      ],
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop shading=FFFF00",
        "--prop shd=clear;FFFF00;auto"
      ],
      "enforcement": "report"
    },
    "shading.val": {
      "type": "string",
      "description": "shading pattern 值。仅真实 pattern shading（pct*/stripe/cross）在 get 时输出；纯色背景以标准 `fill` key 返回。Add/Set 使用 `fill`/`shading`/`shd`。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "shading pattern token (pattern shading only)",
      "enforcement": "report"
    },
    "shading.fill": {
      "type": "string",
      "description": "shading fill color hex。仅真实 pattern shading 在 get 时输出；纯色背景以标准 `fill` key 返回。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "#RRGGBB (pattern shading only)",
      "enforcement": "report"
    },
    "shading.color": {
      "type": "string",
      "description": "shading 前景（pattern）颜色 hex。仅 pattern shading 支持。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "#RRGGBB (pattern shading only)",
      "enforcement": "report"
    },
    "textOutline": {
      "type": "string",
      "description": "w14 text outline：'WIDTHpt-COLOR'（例如 '1pt-FF0000'）。先 width 后 color；使用 '-' 或 ';' 分隔。",
      "aliases": [
        "textoutline"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop textOutline=1pt-FF0000"
      ],
      "readback": "\"{width}pt\" or \"{width}pt;#RRGGBB\"",
      "enforcement": "report"
    },
    "textFill": {
      "type": "string",
      "description": "w14 text fill（颜色或 gradient spec）。",
      "aliases": [
        "textfill"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop textFill=FF0000"
      ],
      "readback": "#RRGGBB (solid) | C1;C2;angle (gradient) | radial:C1;C2",
      "enforcement": "report"
    },
    "w14shadow": {
      "type": "string",
      "description": "w14 text shadow 效果。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop w14shadow=FF0000"
      ],
      "readback": "#RRGGBB;blur_pt;angle_deg;dist_pt;opacity",
      "enforcement": "report"
    },
    "w14glow": {
      "type": "string",
      "description": "w14 text glow 效果。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop w14glow=FF0000"
      ],
      "readback": "#RRGGBB;radius_pt;opacity",
      "enforcement": "report"
    },
    "w14reflection": {
      "type": "string",
      "description": "w14 text reflection 效果。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop w14reflection=true"
      ],
      "readback": "semicolon-delimited reflection parameters",
      "enforcement": "report"
    },
    "effective.size.src": {
      "type": "string",
      "description": "effective.size 的来源指针，即写入层的路径（例如 \"/styles/Heading1\"、\"/docDefaults\"）。已有文档说明但当前不输出；Get 仅返回解析后的 `effective.size` 值。",
      "add": false,
      "set": false,
      "get": false,
      "readback": "n/a (planned — only effective.size emits today)",
      "enforcement": "report"
    },
    "effective.font.ascii": {
      "type": "string",
      "description": "按继承关系解析的 Latin/ASCII 字体槽位（只读）。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "font family name",
      "enforcement": "report"
    },
    "effective.font.ascii.src": {
