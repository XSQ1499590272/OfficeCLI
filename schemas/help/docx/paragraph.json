{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "paragraph",
  "elementAliases": [
    "p"
  ],
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "stable": [
      "/body/p[@paraId=ID]"
    ],
    "positional": [
      "/body/p[N]"
    ]
  },
  "note": "Get 返回 canonical keys：spaceBefore/spaceAfter/lineSpacing/align（Add/Set 仍接受旧 alias：spacebefore/linespacing/halign）。effective.* 是只读的继承解析值，通过 paragraph style → docDefaults 从第一个 run 解析；每个值都带 effective.X.src，指向实际写入层（例如 /styles/Heading1）。如果 paragraph 或第一个 run 设置了 direct value，则不会返回对应的 effective.*。",
  "children": [
    {
      "element": "run",
      "pathSegment": "r",
      "cardinality": "0..n"
    }
  ],
  "extends": "_shared/paragraph",
  "properties": {
    "lineRule": {
      "type": "enum",
      "description": "与 lineSpacing 配套的行距规则（仅 Word：w:spacing@w:lineRule）。'auto' = 倍数（1.5x/150% 的默认值），'exact' = 精确固定高度（Npt 的默认值），'atLeast' = 最小高度（Npt 下限；行可随较高内容增大）。",
      "values": [
        "auto",
        "exact",
        "atLeast"
      ],
      "aliases": [
        "linerule"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop lineSpacing=14pt --prop lineRule=atLeast"
      ],
      "readback": "auto | exact | atLeast",
      "enforcement": "report"
    },
    "align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right",
        "justify",
        "both",
        "distribute"
      ],
      "aliases": [
        "alignment",
        "halign"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop align=center"
      ],
      "readback": "one of values",
      "enforcement": "strict"
    },
    "style": {
      "type": "string",
      "description": "paragraph 的 styleId（例如 Heading1、Normal、Quote）。必须引用已有 style 或内置 style 别名。别名与 Get 返回的标准 key 对应：styleId 指向 OOXML styleId；styleName 通过 styles part 解析显示名称（宽松匹配，无匹配时按原值使用）。",
      "aliases": [
        "styleId",
        "styleid",
        "styleName",
        "stylename"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop style=Heading1",
        "--prop styleId=Heading1",
        "--prop styleName=\"Heading 1\""
      ],
      "readback": "styleId as stored on the paragraph",
      "enforcement": "strict"
    },
    "spaceBefore": {
      "type": "length",
      "aliases": [
        "spacebefore"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop spaceBefore=12pt"
      ],
      "readback": "unit-qualified, e.g. \"12pt\"",
      "enforcement": "strict"
    },
    "spaceAfter": {
      "type": "length",
      "aliases": [
        "spaceafter"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop spaceAfter=6pt"
      ],
      "readback": "unit-qualified, e.g. \"6pt\"",
      "enforcement": "strict"
    },
    "spaceBeforeAuto": {
      "type": "boolean",
      "aliases": [
        "beforeAutospacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "w:spacing @beforeAutospacing——控制段前间距的 Word“同样式段落自动间距”开关。仅在存在时由 get 返回。",
      "examples": [
        "--prop spaceBeforeAuto=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "spaceAfterAuto": {
      "type": "boolean",
      "aliases": [
        "afterAutospacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "w:spacing @afterAutospacing——控制段后间距的自动间距开关。参见 spaceBeforeAuto。",
      "examples": [
        "--prop spaceAfterAuto=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "listStyle": {
      "type": "enum",
      "values": [
        "bullet",
        "ordered",
        "none"
      ],
      "description": "高层 list 类型。'bullet'（别名：unordered、ul）创建项目符号 list；'ordered'（或其他非 bullet 值，例如 'decimal'）创建编号 list；'none'/'remove'/'clear' 清除 list 格式。优先使用此项而非原始 numId。会自动延续紧邻在前的同类型 list；中间出现非 list paragraph（或另一类型 list）时，会从 1 开始新的 list。若要跨越这种中断继续编号，请传入引用先前 list instance 的显式 'numId'；传入 'start' 可强制重新开始。",
      "aliases": [
        "liststyle"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop listStyle=bullet --prop text=\"item\"",
        "--prop listStyle=ordered --prop text=\"step 1\""
      ],
      "readback": "'bullet' or 'ordered' (normalized from the numbering format)",
      "enforcement": "strict"
    },
    "numId": {
      "type": "int",
      "description": "numbering definition id（w:numId）。这是低层入口；除非需要引用已有 numbering instance，否则优先使用 'listStyle'。numId 必须已存在于 /numbering 中（先通过 `add /numbering --type num` 创建）。",
      "aliases": [
        "numid"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop numId=1"
      ],
      "readback": "numbering id as stored on the paragraph",
      "enforcement": "report"
    },
    "numLevel": {
      "type": "int",
      "description": "list 缩进级别（w:ilvl），范围 0..8。需配合 numId 或 listStyle 才会生效；仅当 paragraph 存在 numId 时 Get 才返回 numLevel。",
      "aliases": [
        "numlevel",
        "ilvl",
        "listLevel",
        "listlevel",
        "level"
      ],
      "requires": [
        "numId"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop numLevel=1 --prop numId=1",
        "--prop ilvl=1 --prop numId=1"
      ],
      "readback": "integer level as stored on the paragraph (only when numId is set)",
      "enforcement": "report"
    },
    "start": {
      "type": "int",
      "description": "ordered list 的起始编号（numbering definition 第 0 级上的 w:start / w:startOverride）。仅与 liststyle=ordered 或已有 numid 配合时有意义。注意：它作用于 paragraph 共享的整个 numbering instance，因此在多项 list 的一项上设置，会重新编号整个 list（所有共享 numId 的 paragraph），而非仅从此项开始。若要在 list 中间的局部范围重新开始编号，请为这些 paragraph 分配新的 numId。未实现读取结果——w:start 位于独立 numbering part，跨 part 遍历不稳定；需要时请直接 query numbering。",
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop liststyle=ordered --prop start=5 --prop text=\"item\""
      ],
      "readback": "n/a (write-only via paragraph; query numbering part)",
      "enforcement": "report"
    },
    "bold": {
      "type": "bool",
      "description": "run 级粗体。Add 时应用于由 'text' 创建的隐式 run；Set 时应用于 paragraph 中的所有 run 以及 paragraph-mark run property，使后续 run 继承。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop bold=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "italic": {
      "type": "bool",
      "description": "run 级斜体。作用范围与 'bold' 相同。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop italic=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "font": {
      "type": "string",
      "description": "run 级字体族（应用于 Ascii/HighAnsi/EastAsia）。Add 时应用于由 'text' 创建的隐式 run；Set 时应用于 paragraph 中的所有 run。",
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop font=\"Times New Roman\" --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "size": {
      "type": "font-size",
      "description": "run 级字体大小。接受不带单位的数值（pt）、'14pt'、'10.5pt'。",
      "aliases": [
        "fontsize"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop size=14 --prop text=\"Hi\"",
        "--prop size=10.5pt --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "color": {
      "type": "color",
      "description": "run 级文本颜色。接受 #RRGGBB、RRGGBB、命名颜色（例如 red）、rgb(r,g,b)。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop color=red --prop text=\"Hi\"",
        "--prop color=#FF0000 --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "underline": {
      "type": "string",
      "description": "run 级下划线。接受 'true'/'false' 或下划线样式（single、double、thick、dotted、dash、wavy 等）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop underline=true --prop text=\"Hi\"",
        "--prop underline=double --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "underline.color": {
      "type": "color",
      "description": "下划线笔画颜色，写入 w:u/@w:color。切换 'underline' 样式时会保留。",
      "aliases": [
        "underlineColor",
        "underlinecolor",
        "font.underline.color"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop underline=single --prop underline.color=#FF0000"
      ],
      "enforcement": "strict"
    },
    "strike": {
      "type": "bool",
      "description": "run 级单删除线。",
      "aliases": [
        "strikethrough"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop strike=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "highlight": {
      "type": "string",
      "description": "run 级突出显示颜色（w:highlight 可选值：yellow、green、cyan、magenta、blue、red、darkBlue、darkCyan、darkGreen、darkMagenta、darkRed、darkYellow、darkGray、lightGray、black、white、none）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop highlight=yellow --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "caps": {
      "type": "bool",
      "description": "run 级全大写。仅 Add 支持（没有 paragraph 级 Set 包装）。",
      "aliases": [
        "allCaps"
      ],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop caps=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "smallcaps": {
      "type": "bool",
      "description": "run 级小型大写字母。仅 Add 支持。",
      "aliases": [
        "smallCaps"
      ],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop smallcaps=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "dstrike": {
      "type": "bool",
      "description": "run 级双删除线。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop dstrike=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "vanish": {
      "type": "bool",
      "description": "run 级隐藏文本。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop vanish=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "outline": {
      "type": "bool",
      "description": "run 级轮廓文本效果。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop outline=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "shadow": {
      "type": "bool",
      "description": "run 级阴影文本效果。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop shadow=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "emboss": {
      "type": "bool",
      "description": "run 级浮雕文本效果。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop emboss=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "imprint": {
      "type": "bool",
      "description": "run 级凹印（engrave）文本效果。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop imprint=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "noproof": {
      "type": "bool",
      "description": "run 级不校对标记。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop noproof=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "superscript": {
      "type": "bool",
      "description": "run 级 superscript 垂直对齐。仅 Add 支持（Set 请使用 vertAlign）。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop superscript=true --prop text=\"x^2\""
      ],
      "enforcement": "strict"
    },
    "subscript": {
      "type": "bool",
      "description": "run 级 subscript 垂直对齐。仅 Add 支持（Set 请使用 vertAlign）。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop subscript=true --prop text=\"H2O\""
      ],
      "enforcement": "strict"
    },
    "vertAlign": {
      "type": "enum",
      "values": [
        "superscript",
        "subscript",
        "baseline",
        "super",
        "sub"
      ],
      "description": "run 级垂直文本对齐。仅 Add 支持。",
      "aliases": [
        "vertalign"
      ],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop vertAlign=superscript --prop text=\"x^2\""
      ],
      "enforcement": "strict"
    },
    "charSpacing": {
      "type": "length",
      "description": "run 级字符间距，单位为 points（不带单位的数值 = pt，也可传 'Xpt'）。以 twips 存储。仅 Add 支持。",
      "aliases": [
        "charspacing",
        "letterspacing",
        "letterSpacing"
      ],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop charSpacing=2 --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "rtl": {
      "type": "bool",
      "description": "run 级从右到左文本标记。仅 Add 支持。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop rtl=true --prop text=\"Hi\""
      ],
      "enforcement": "strict"
    },
    "direction": {
      "type": "enum",
      "values": [
        "ltr",
        "rtl"
      ],
      "description": "paragraph 阅读方向。'rtl' 会在 pPr 写入 <w:bidi/>、在 paragraph mark 写入 <w:rtl/>、在每个 run 写入 <w:rtl/>（使 Arabic / Hebrew 的字符顺序在 run 内反转，而不只是页面侧布局）。'ltr' 会清除这三项。",
      "aliases": [
        "dir",
        "bidi"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop direction=rtl"
      ],
      "readback": "rtl | ltr (only emitted when explicitly set)",
      "enforcement": "strict"
    },
    "font.cs": {
      "type": "string",
      "description": "complex-script 字体槽位（rFonts/cs）——Arabic / Hebrew / Thai 字体。",
      "aliases": [
        "font.complexscript",
        "font.complex"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.cs=\"Arabic Typesetting\""
      ],
      "enforcement": "report"
    },
    "font.ea": {
      "type": "string",
      "description": "East-Asian 字体槽位（rFonts/eastAsia）——Chinese / Japanese / Korean 字体。",
      "aliases": [
        "font.eastasia",
        "font.eastasian"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.ea=\"メイリオ\""
      ],
      "enforcement": "report"
    },
    "font.latin": {
      "type": "string",
      "description": "Latin 字体槽位（rFonts/ascii + hAnsi）——ASCII / Western 文本。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.latin=Calibri"
      ],
      "enforcement": "report"
    },
    "font.asciiTheme": {
      "type": "string",
      "description": "ascii 槽位的 Theme font binding（rFonts/asciiTheme）。可选值：minorHAnsi、majorHAnsi、minorEastAsia、majorEastAsia、minorBidi、majorBidi。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.asciiTheme=minorHAnsi"
      ],
      "enforcement": "report"
    },
    "font.hAnsiTheme": {
      "type": "string",
      "description": "hAnsi 槽位的 Theme font binding（rFonts/hAnsiTheme）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.hAnsiTheme=minorHAnsi"
      ],
      "enforcement": "report"
    },
    "font.eaTheme": {
      "type": "string",
      "description": "East-Asia 槽位的 Theme font binding（rFonts/eastAsiaTheme）。可选值：minorEastAsia、majorEastAsia。",
      "aliases": [
        "font.eastAsiaTheme"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.eaTheme=minorEastAsia"
      ],
      "enforcement": "report"
    },
    "font.csTheme": {
      "type": "string",
      "description": "complex-script 槽位的 Theme font binding（rFonts/cstheme）。可选值：minorBidi、majorBidi。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop font.csTheme=minorBidi"
      ],
      "enforcement": "report"
    },
    "bold.cs": {
      "type": "bool",
      "description": "paragraph 各 run 的 complex-script 粗体（<w:bCs/>）。Arabic / Hebrew 的粗体呈现需要此项。",
      "aliases": [
        "font.bold.cs",
        "boldcs"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop bold.cs=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "italic.cs": {
      "type": "bool",
      "description": "paragraph 各 run 的 complex-script 斜体（<w:iCs/>）。",
      "aliases": [
        "font.italic.cs",
        "italiccs"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop italic.cs=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "size.cs": {
      "type": "font-size",
      "description": "paragraph 各 run 的 complex-script 字体大小（<w:szCs/>）。",
      "aliases": [
        "font.size.cs",
        "sizecs"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop size.cs=14pt"
      ],
      "readback": "unit-qualified, e.g. \"14pt\"",
      "enforcement": "strict"
    },
    "shd": {
      "type": "string",
      "description": "shading。格式：'fill'、'val;fill' 或 'val;fill;color'。Add 时在 paragraph 级应用（pPr/shd）。",
      "aliases": [
        "shading"
      ],
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop shd=FFFF00",
        "--prop shd=clear;FFFF00"
      ],
      "enforcement": "report"
    },
    "firstLineIndent": {
      "type": "length",
      "description": "首行缩进。经由 SpacingConverter 处理。",
      "aliases": [
        "firstlineindent"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop firstLineIndent=2cm"
      ],
      "enforcement": "report"
    },
    "rightIndent": {
      "type": "length",
      "description": "右缩进。经由 SpacingConverter 处理。",
      "aliases": [
        "rightindent",
        "indentright"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop rightIndent=1cm"
      ],
      "enforcement": "report"
    },
    "hangingIndent": {
      "type": "length",
      "description": "悬挂缩进（与左缩进配合）。经由 SpacingConverter 处理。",
      "aliases": [
        "hangingindent",
        "hanging"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop hangingIndent=0.5cm"
      ],
      "readback": "unit-qualified length (e.g. \"28.35pt\")",
      "enforcement": "report"
    },
    "keepNext": {
      "type": "bool",
      "description": "使本 paragraph 与下一 paragraph 保持在同一页（中间不分页）。",
