{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "fieldChar",
  "parent": "paragraph",
  "operations": {
    "add": false,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/body/p[@paraId=X]/r[N]", "/header[N]/p[M]/r[K]", "/footer[N]/p[M]/r[K]"]
  },
  "note": "Field-character marker（w:fldChar）是用于界定 complex field begin/separate/end 的 inline atom。单独 Add 不受支持，因为孤立 fldChar 不是有效 OOXML；请使用 --type field 一次插入完整的 begin+instrText+separate+cached+end 序列。对单个 fldChar 的 Get/Set 可用于 audit→fix，检查并调整已有 field 的结构。",
  "properties": {
    "fieldCharType": {
      "type": "enum",
      "values": ["begin", "separate", "end"],
      "aliases": ["fieldchartype"],
      "add": false, "set": true, "get": true,
      "required": true,
      "examples": ["--prop fieldCharType=separate"],
      "readback": "fldChar fldCharType attribute",
      "enforcement": "report"
    }
  }
}
