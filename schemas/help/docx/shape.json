{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "shape",
  "elementAliases": [
    "sp"
  ],
  "parent": "body",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": false,
    "remove": true
  },
  "paths": {
    "positional": [
      "/body/shape[N]"
    ]
  },
  "note": "Floating geometric shape，即带锚点的 DrawingML shape（wps:wsp），包含 preset geometry、fill 和 outline，但不包含 text body。通过 add --type shape 创建；Get 返回 raw drawing tree，Remove 会删除宿主 paragraph。Set 可原地修改 spPr surface（fill、line、line.*、width、height、geometry）；position/anchor/wrap/rotation 只支持 Add，修改时请 Remove 后重新 Add，或使用 raw-set path。带文本请使用 textbox，inline image 请使用 picture。",
  "properties": {
    "geometry": {
      "type": "string",
      "description": "预设 shape geometry（rect、roundRect、ellipse、triangle、diamond 等）。别名：preset。",
      "aliases": ["preset"],
      "default": "rect",
      "add": true,
      "set": true,
      "examples": ["--prop geometry=ellipse", "--prop geometry=roundRect"]
    },
    "width": {
      "type": "length",
      "description": "shape 宽度（cm/in/pt/EMU）。默认约 1in。",
      "add": true,
      "set": true,
      "examples": ["--prop width=4cm"]
    },
    "height": {
      "type": "length",
      "description": "shape 高度（cm/in/pt/EMU）。默认约 1in。",
      "add": true,
      "set": true,
      "examples": ["--prop height=4cm"]
    },
    "wrap": {
      "type": "enum",
      "description": "shape 周围 body text 的环绕方式。",
      "values": ["square", "tight", "through", "topAndBottom", "behind", "front", "none"],
      "default": "none",
      "add": true,
      "examples": ["--prop wrap=square"]
    },
    "hAlign": {
      "type": "enum",
      "description": "相对水平对齐方式（写入 <wp:align>，会替代 X 轴位置偏移）。别名：halign。",
      "values": ["left", "center", "right", "inside", "outside"],
      "aliases": ["halign"],
      "add": true,
      "examples": ["--prop hAlign=center"]
    },
    "vAlign": {
      "type": "enum",
      "description": "相对垂直对齐方式（在 Y 轴写入 <wp:align>）。别名：valign。",
      "values": ["top", "center", "bottom", "inside", "outside"],
      "aliases": ["valign"],
      "add": true,
      "examples": ["--prop vAlign=center"]
    },
    "hRelative": {
      "type": "enum",
      "description": "水平位置/对齐的参照对象。别名：hrelative。",
      "values": ["margin", "page", "column", "character", "leftMargin", "rightMargin", "insideMargin", "outsideMargin"],
      "default": "column",
      "aliases": ["hrelative"],
      "add": true,
      "examples": ["--prop hRelative=margin"]
    },
    "vRelative": {
      "type": "enum",
      "description": "垂直位置/对齐的参照对象。别名：vrelative。",
      "values": ["margin", "page", "paragraph", "line", "topMargin", "bottomMargin", "insideMargin", "outsideMargin"],
      "default": "paragraph",
      "aliases": ["vrelative"],
      "add": true,
      "examples": ["--prop vRelative=paragraph"]
    },
    "anchor.x": {
      "type": "length",
      "description": "相对于 hRelative 起点的水平位置偏移。别名：hposition；设置 hAlign 时会忽略。",
      "aliases": ["hposition"],
      "add": true,
      "examples": ["--prop anchor.x=2cm"]
    },
    "anchor.y": {
      "type": "length",
      "description": "相对于 vRelative 起点的垂直位置偏移。别名：vposition；设置 vAlign 时会忽略。",
      "aliases": ["vposition"],
      "add": true,
      "examples": ["--prop anchor.y=1cm"]
    },
    "fill": {
      "type": "color",
      "description": "fill 颜色（hex/name），或使用 'none' 表示无填充。",
      "add": true,
      "set": true,
      "examples": ["--prop fill=FF0000", "--prop fill=none"]
    },
    "line": {
      "type": "string",
      "description": "组合 outline，格式为 'STYLE;SIZE;COLOR'（或 'none'）；也支持分别使用 line.style/line.width/line.color。",
      "add": true,
      "set": true,
      "examples": ["--prop line=solid;1pt;000000"]
    },
    "line.color": {
      "type": "color",
      "description": "outline 颜色。别名：linecolor。",
      "aliases": ["linecolor"],
      "add": true,
      "set": true
    },
    "line.width": {
      "type": "length",
      "description": "outline 宽度。别名：linewidth。",
      "aliases": ["linewidth"],
      "add": true,
      "set": true
    },
    "line.style": {
      "type": "string",
      "description": "outline dash 样式。别名：linestyle。",
      "aliases": ["linestyle"],
      "add": true,
      "set": true
    },
    "alt": {
      "type": "string",
      "description": "accessibility / object 名称（docPr name）。别名：name。默认值：'Shape'。",
      "aliases": ["name"],
      "add": true,
      "examples": ["--prop alt=\"Diagram box\""]
    }
  }
}
