{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "styles",
  "parent": "document",
  "container": true,
  "operations": {
    "add": true,
    "set": false,
    "get": true,
    "query": true,
    "remove": false
  },
  "paths": {
    "positional": ["/styles"]
  },
  "note": "StyleDefinitionsPart container。可在此 Add 新 style（参见 docx/style.json）。单个 style 通过 id 定位：/styles/StyleId。",
  "properties": {
    "count": { "type":"number", "add":false, "set":false, "get":true, "description":"styles.xml 中 style definition 的总数。", "readback":"integer style count", "enforcement":"report" }
  },
  "children": [
    { "element": "style", "pathSegment": "{StyleId}", "cardinality": "0..n" }
  ]
}
