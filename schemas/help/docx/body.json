{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "body",
  "parent": "document",
  "container": true,
  "operations": {
    "add": false,
    "set": false,
    "get": true,
    "query": true,
    "remove": false
  },
  "paths": {
    "positional": ["/body"]
  },
  "note": "正文容器。Get 返回按顺序排列的 paragraph、table、section 流。通过子 path（/body/p[N]、/body/tbl[N]、/body/section[N]）执行修改。",
  "children": [
    { "element": "paragraph", "pathSegment": "p",       "cardinality": "0..n" },
    { "element": "table",     "pathSegment": "tbl",     "cardinality": "0..n" },
    { "element": "section",   "pathSegment": "section", "cardinality": "0..n" },
    { "element": "sdt",       "pathSegment": "sdt",     "cardinality": "0..n" }
  ]
}
