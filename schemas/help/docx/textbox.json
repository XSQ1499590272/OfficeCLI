{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "textbox",
  "elementAliases": [
    "txbx"
  ],
  "parent": "body",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": false,
    "remove": true
  },
  "paths": {
    "positional": [
      "/body/textbox[N]"
    ]
  },
  "note": "Floating text box，即携带 text body 的 DrawingML anchored shape（wps:wsp），添加在 run+paragraph 内。通过 add --type textbox 创建；Get 返回 raw drawing tree，Remove 删除宿主 paragraph。Set 可原地修改 spPr surface（fill、line.*、width、height、geometry）；position/anchor/wrap/inset/text/rotation/shadow 只支持 Add，修改时请 Remove 后重新 Add，或使用 raw-set path。没有 text body 的空 graphic shape 请使用 shape，inline picture 请使用 picture。",
  "properties": {
    "text": {
      "type": "string",
      "description": "放入 text box body 的初始文本。",
      "add": true,
      "examples": ["--prop text=\"Sidebar note\""]
    },
    "width": {
      "type": "length",
      "description": "box 宽度（cm/in/pt/EMU）。默认约 6cm。",
      "add": true,
      "set": true,
      "examples": ["--prop width=6cm"]
    },
    "height": {
      "type": "length",
      "description": "box 高度（cm/in/pt/EMU）。默认约 2.4cm。",
      "add": true,
      "set": true,
      "examples": ["--prop height=3cm"]
    },
    "geometry": {
      "type": "string",
      "description": "box 的预设 shape 外轮廓（rect、roundRect、ellipse 等）。别名：shape。",
      "aliases": ["shape"],
      "add": true,
      "set": true,
      "examples": ["--prop geometry=roundRect"]
    },
    "wrap": {
      "type": "enum",
      "description": "box 周围 body text 的环绕方式。",
      "values": ["square", "tight", "through", "topAndBottom", "behind", "front", "none"],
      "default": "square",
      "add": true,
      "examples": ["--prop wrap=square"]
    },
    "hAlign": {
      "type": "enum",
      "description": "相对水平对齐方式（写入 <wp:align>，会替代 X 轴位置偏移）。别名：halign。",
      "values": ["left", "center", "right", "inside", "outside"],
      "aliases": ["halign"],
      "add": true,
      "examples": ["--prop hAlign=center"]
    },
    "vAlign": {
      "type": "enum",
      "description": "相对垂直对齐方式（在 Y 轴写入 <wp:align>）。别名：valign。",
      "values": ["top", "center", "bottom", "inside", "outside"],
      "aliases": ["valign"],
      "add": true,
      "examples": ["--prop vAlign=top"]
    },
    "hRelative": {
      "type": "enum",
      "description": "水平位置/对齐的参照对象。别名：hrelative。",
      "values": ["margin", "page", "column", "character", "leftMargin", "rightMargin", "insideMargin", "outsideMargin"],
      "aliases": ["hrelative"],
      "add": true,
      "examples": ["--prop hRelative=margin"]
    },
    "vRelative": {
      "type": "enum",
      "description": "垂直位置/对齐的参照对象。别名：vrelative。",
      "values": ["margin", "page", "paragraph", "line", "topMargin", "bottomMargin", "insideMargin", "outsideMargin"],
      "aliases": ["vrelative"],
      "add": true,
      "examples": ["--prop vRelative=paragraph"]
    },
    "anchor.x": {
      "type": "length",
      "description": "相对于 hRelative 起点的水平位置偏移。别名：hposition；设置 hAlign 时会忽略此值。",
      "aliases": ["hposition"],
      "add": true,
      "examples": ["--prop anchor.x=2cm"]
    },
    "anchor.y": {
      "type": "length",
      "description": "相对于 vRelative 起点的垂直位置偏移。别名：vposition；设置 vAlign 时会忽略此值。",
      "aliases": ["vposition"],
      "add": true,
      "examples": ["--prop anchor.y=1cm"]
    },
    "fill": {
      "type": "color",
      "description": "fill 颜色（hex/name），或使用 'none' 表示无填充。别名：fillcolor。",
      "aliases": ["fillcolor"],
      "add": true,
      "set": true,
      "examples": ["--prop fill=EAF2FF", "--prop fill=none"]
    },
    "fill.gradient": {
      "type": "string",
      "description": "gradient fill 配置（会覆盖 solid fill）。别名：gradient。",
      "aliases": ["gradient"],
      "add": true
    },
    "fill.opacity": {
      "type": "string",
      "description": "fill 透明度百分比。别名：opacity。",
      "aliases": ["opacity"],
      "add": true,
      "examples": ["--prop fill.opacity=50"]
    },
    "line.color": {
      "type": "color",
      "description": "outline 颜色。别名：linecolor。",
      "aliases": ["linecolor"],
      "add": true,
      "set": true,
      "examples": ["--prop line.color=2B579A"]
    },
    "line.width": {
      "type": "length",
      "description": "outline 宽度。别名：linewidth。",
      "aliases": ["linewidth"],
      "add": true,
      "set": true,
      "examples": ["--prop line.width=1pt"]
    },
    "line.style": {
      "type": "string",
      "description": "outline dash 样式。别名：linestyle。",
      "aliases": ["linestyle"],
      "add": true,
      "set": true
    },
    "inset.left": {
      "type": "length",
      "description": "box 边缘与文本之间的左内边距。默认 0.1in。",
      "add": true
    },
    "inset.top": {
      "type": "length",
      "description": "上内边距。默认 0.05in。",
      "add": true
    },
    "inset.right": {
      "type": "length",
      "description": "右内边距。默认 0.1in。",
      "add": true
    },
    "inset.bottom": {
      "type": "length",
      "description": "下内边距。默认 0.05in。",
      "add": true
    },
    "textDirection": {
      "type": "string",
      "description": "box 内部的文本流向（如 vertical）。别名：vert。",
      "aliases": ["vert"],
      "add": true
    },
    "textAnchor": {
      "type": "string",
      "description": "文本在 box 内的垂直锚点（top/center/bottom）。",
      "add": true
    },
    "autoFit": {
      "type": "bool",
      "description": "调整 box 尺寸以容纳其文本（<a:spAutoFit/>）。",
      "add": true,
      "examples": ["--prop autoFit=true"]
    },
    "rotation": {
      "type": "string",
      "description": "旋转角度。别名：rot。",
      "aliases": ["rot"],
      "add": true,
      "examples": ["--prop rotation=90"]
    },
    "shadow": {
      "type": "string",
      "description": "drop-shadow 预设。",
      "add": true
    },
    "alt": {
      "type": "string",
      "description": "accessibility / object 名称（docPr name）。别名：name。默认值：'Text Box'。",
      "aliases": ["name"],
      "add": true,
      "examples": ["--prop alt=\"Callout\""]
    }
  }
}
