{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "cell",
  "elementAliases": [
    "tc"
  ],
  "parent": "row",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/body/tbl[N]/tr[R]/tc[C]"
    ]
  },
  "note": "Add 时只有 text 和 width 会生效；其他 property 要在 cell 创建后通过 Set 应用。Run-level formatting（font/size/bold/italic/color/highlight/underline/strike）会写入 cell 中每个 paragraph 的每个 run；如果 cell 尚无 run，则写入 ParagraphMarkRunProperties。Border value 格式为 STYLE[;SIZE[;COLOR[;SPACE]]], 例如 'single;4;FF0000'。",
  "extends": "_shared/table-cell",
  "properties": {
    "width": {
      "type": "string",
      "description": "单元格首选宽度（w:tcW）。支持裸 twips 整数、带单位的 'Ndxa'（Dxa）、'N%'（table width 的百分比）、'auto'（自动适应，无首选宽度）或 'nil'（无首选宽度，区别于显式的零 twip 宽度）。Get 会按相同带单位形式返回，以保证无损 round-trip。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop width=2500",
        "--prop width=25%",
        "--prop width=auto",
        "--prop width=nil"
      ],
      "readback": "'Ndxa' | 'N%' | 'auto' | 'nil' | '0dxa'",
      "enforcement": "report"
    },
    "skipGridSync": {
      "type": "bool",
      "description": "禁止设置 width 时通常会触发的逐单元格 tblGrid 同步副作用。用于 dump → batch replay：当单个 tcW 与 gridCol 宽度不一致时，保留源 table 的权威 colWidths（Word 按 tcW 渲染，tblGrid 只是布局提示）。仅支持 Set。",
      "add": false,
      "set": true,
      "get": false,
      "examples": [
        "--prop skipGridSync=true"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "font": {
      "type": "string",
      "description": "应用到单元格内每个段落、每个 run 的 font family（仅支持 Set；请在 add 后使用）。",
      "aliases": [
        "fontname",
        "fontFamily"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop font=\"Times New Roman\""
      ],
      "readback": "from first run's RunFonts.Ascii",
      "enforcement": "report"
    },
    "size": {
      "type": "font-size",
      "description": "应用到单元格内每个 run 的 font size。支持裸数字（按 pt）、'14pt'、'10.5pt'（仅支持 Set；请在 add 后使用）。",
      "aliases": [
        "fontsize"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop size=14pt",
        "--prop size=10.5pt"
      ],
      "readback": "unit-qualified, e.g. \"14pt\"",
      "enforcement": "report"
    },
    "bold": {
      "type": "bool",
      "description": "应用到单元格内每个 run 的 bold（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop bold=true"
      ],
      "readback": "true | (absent)",
      "enforcement": "report"
    },
    "italic": {
      "type": "bool",
      "description": "应用到单元格内每个 run 的 italic（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop italic=true"
      ],
      "readback": "true | (absent)",
      "enforcement": "report"
    },
    "underline": {
      "type": "enum",
      "values": [
        "none",
        "single",
        "double",
        "thick",
        "dotted",
        "dash",
        "wave",
        "words"
      ],
      "description": "应用到单元格内每个 run 的 underline 样式（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop underline=single",
        "--prop underline=double"
      ],
      "readback": "one of values",
      "enforcement": "report"
    },
    "strike": {
      "type": "bool",
      "description": "应用到单元格内每个 run 的 strike-through（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop strike=true"
      ],
      "readback": "true | (absent)",
      "enforcement": "report"
    },
    "color": {
      "type": "color",
      "description": "应用到单元格内每个 run 的文本颜色（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop color=FF0000",
        "--prop color=#FF0000",
        "--prop color=red"
      ],
      "readback": "#RRGGBB uppercase",
      "enforcement": "report"
    },
    "highlight": {
      "type": "color",
      "description": "文本高亮颜色。映射到 Word 的命名高亮调色板（yellow、green、cyan、magenta、blue、red、darkBlue 等）（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop highlight=yellow"
      ],
      "readback": "highlight palette name",
      "enforcement": "report"
    },
    "fill": {
      "type": "color",
      "description": "单元格背景 shading（w:shd @fill）。支持纯色：hex（'FF0000'）、带 '#' 的 hex（'#FF0000'）、命名色（'red'）、rgb(...)，或使用 'transparent' 清除。docx <w:shd> 没有原生 gradient；不支持 CSS 风格的 'COLOR1-COLOR2[-ANGLE]'（原生 gradient cell fill 仅限 pptx）。可用分号格式 'gradient;STARTCOLOR;ENDCOLOR[;ANGLE]' 创建模拟的两段 gradient，底层以 shading pattern 实现。不支持裸 'none'，请使用 'transparent'。仅支持 Set；请在 add 后使用。",
      "aliases": [
        "shd",
        "shading"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop fill=FFFF00",
        "--prop fill=#FF0000",
        "--prop fill=red",
        "--prop fill=transparent",
        "--prop fill=\"gradient;FF0000;0000FF;90\""
      ],
      "readback": "#RRGGBB uppercase, or 'gradient' (with a separate 'gradient' key)",
      "enforcement": "report"
    },
    "align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right",
        "justify",
        "both",
        "distribute"
      ],
      "description": "应用到单元格内每个段落的水平对齐方式（仅支持 Set；请在 add 后使用）。",
      "aliases": [
        "alignment"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop align=center"
      ],
      "readback": "one of values (from first paragraph)",
      "enforcement": "report"
    },
    "valign": {
      "type": "enum",
      "values": [
        "top",
        "center",
        "bottom"
      ],
      "description": "单元格内容的垂直对齐方式（仅支持 Set；请在 add 后使用）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop valign=center"
      ],
      "readback": "one of values",
      "enforcement": "report"
    },
    "colspan": {
      "type": "int",
      "description": "该单元格跨越的 grid column 数。别名：gridspan。设置后会将单元格宽度调整为所跨 grid column 宽度之和，并移除本行中变为冗余的后续单元格（仅支持 Set；请在 add 后使用）。",
      "aliases": [
        "gridspan"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop colspan=2"
      ],
      "readback": "under key 'colspan' when > 1",
      "enforcement": "report"
    },
    "fitText": {
      "type": "bool",
      "description": "在每个 run 上启用 w:fitText，使文本压缩以适应单元格宽度（仅支持 Set；请在 add 后使用）。",
      "aliases": [
        "fittext"
      ],
      "add": false,
      "set": true,
      "get": false,
      "examples": [
        "--prop fitText=true"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "textDirection": {
      "type": "enum",
      "values": [
        "lrtb",
        "btlr",
        "tbrl",
        "horizontal",
        "vertical",
        "vertical-rl",
        "tbrl-r",
        "lrtb-r",
        "tblr-r"
      ],
      "description": "单元格内的文本流向。别名：textdir（仅支持 Set；请在 add 后使用）。",
      "aliases": [
        "textdir"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop textDirection=btlr"
      ],
      "readback": "OpenXML enum inner text",
      "enforcement": "report"
    },
    "direction": {
      "type": "enum",
      "values": [
        "rtl",
        "ltr"
      ],
      "aliases": [
        "dir",
        "bidi"
      ],
      "description": "阅读方向（Arabic / Hebrew）。'rtl' 会在每个单元格段落写入 <w:bidi/>、在每个段落标记和每个 run 写入 <w:rtl/>；'ltr' 清除这三处设置。不同于 textDirection，后者控制单元格内文本的垂直/水平流向。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop direction=rtl"
      ],
      "readback": "rtl when set, key absent otherwise",
      "enforcement": "report"
    },
    "nowrap": {
      "type": "bool",
      "description": "禁用单元格内的文本换行。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop nowrap=true"
      ],
      "readback": "true | (absent)",
      "enforcement": "report"
    },
    "hideMark": {
      "type": "bool",
      "description": "w:hideMark：自动适应计算行高时忽略单元格结束标记（即使单元格包含段落标记，也会显示为空）。",
      "aliases": [
        "hidemark"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop hideMark=true"
      ],
      "readback": "true | (absent)",
      "enforcement": "report"
    },
    "tcFitText": {
      "type": "bool",
      "description": "w:tcFitText：使单元格文本适应其宽度（tcPr 级开关）。不同于 run 级的 'fitText' 属性，后者通过 w:fitText 压缩每个 run。",
      "aliases": [
        "tcfittext"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop tcFitText=true"
      ],
      "readback": "true | (absent)",
      "enforcement": "report"
    },
    "padding.top": {
      "type": "number",
      "description": "上单元格边距，单位为 twips（整数；1 twip = 1/20 pt，如 100 = 5pt）。仅支持裸整数，不带单位后缀。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop padding.top=100"
      ],
      "readback": "twips integer",
      "enforcement": "report"
    },
    "padding.bottom": {
      "type": "number",
      "description": "下单元格边距，单位为 twips（整数；1 twip = 1/20 pt，如 100 = 5pt）。仅支持裸整数，不带单位后缀。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop padding.bottom=100"
      ],
      "readback": "twips integer",
      "enforcement": "report"
    },
    "padding.left": {
      "type": "number",
      "description": "左单元格边距，单位为 twips（整数；1 twip = 1/20 pt，如 100 = 5pt）。仅支持裸整数，不带单位后缀。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop padding.left=100"
      ],
      "readback": "twips integer",
      "enforcement": "report"
    },
    "padding.right": {
      "type": "number",
      "description": "右单元格边距，单位为 twips（整数；1 twip = 1/20 pt，如 100 = 5pt）。仅支持裸整数，不带单位后缀。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop padding.right=100"
      ],
      "readback": "twips integer",
      "enforcement": "report"
    },
    "vmerge": {
      "type": "enum",
      "values": [
        "restart",
        "continue"
      ],
      "description": "纵向合并标记（w:vMerge）。'restart' 标记纵向跨度顶部单元格；'continue' 标记同列后续合并单元格。裸 <w:vMerge/> 会读取为 'continue'。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop vmerge=restart",
        "--prop vmerge=continue"
      ],
      "readback": "restart|continue",
      "enforcement": "report"
    },
    "hmerge": {
      "type": "enum",
      "values": [
        "restart",
        "continue"
      ],
      "description": "横向合并标记（w:hMerge，legacy 格式）。'restart' 标记横向跨度的首个单元格；'continue' 标记后续合并单元格。多数现代文档优先使用 gridSpan；保留 hmerge 是为了与已有此格式的文件进行 round-trip。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop hmerge=restart",
        "--prop hmerge=continue"
      ],
      "readback": "restart|continue",
      "enforcement": "report"
    },
    "cnfStyle": {
      "type": "string",
      "description": "单元格（tcPr）上的 conditional-formatting bitmask（ST_Cnf @val）。为 12 位二进制字符串，每个 '0'/'1' 按顺序标记一个区域：firstRow、lastRow、firstColumn、lastColumn、oddVBand、evenVBand、oddHBand、evenHBand、firstRowFirstColumn、firstRowLastColumn、lastRowFirstColumn、lastRowLastColumn。较短的二进制输入会在右侧补齐到 12 位；不是 hex number。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop cnfStyle=100000000000"
      ],
      "readback": "12-digit binary bitmask string",
      "enforcement": "report"
    }
  }
}
