{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "document",
  "container": true,
  "operations": {
    "add": false,
    "set": true,
    "get": true,
    "query": true,
    "remove": false
  },
  "paths": {
    "positional": [
      "/"
    ]
  },
  "note": "Root container。Get 返回顶层 children（body、styles、numbering、headers、footers 等）。Set 可修改 core document properties（author/title/subject/keywords/description）。",
  "children": [
    {
      "element": "body",
      "pathSegment": "body",
      "cardinality": "1"
    },
    {
      "element": "styles",
      "pathSegment": "styles",
      "cardinality": "1"
    },
    {
      "element": "numbering",
      "pathSegment": "numbering",
      "cardinality": "0..1"
    }
  ],
  "extends": "_shared/root-metadata",
  "properties": {
    "author": {
      "type": "string",
      "aliases": [
        "creator"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop author=\"Alice\""
      ],
      "readback": "author string",
      "enforcement": "report"
    },
    "title": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop title=\"Report\""
      ],
      "readback": "title string",
      "enforcement": "report"
    },
    "keywords": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop keywords=\"tag1,tag2\""
      ],
      "readback": "keywords string",
      "enforcement": "report"
    },
    "description": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop description=\"Abstract\""
      ],
      "readback": "description string",
      "enforcement": "report"
    },
    "lastModifiedBy": {
      "type": "string",
      "aliases": [
        "lastmodifiedby"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop lastModifiedBy=\"Bob\""
      ],
      "readback": "last-modified author",
      "enforcement": "report"
    },
    "category": {
      "type": "string",
      "description": "document 分类元数据。仅在存在时输出。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "category string",
      "enforcement": "report"
    },
    "revisionNumber": {
      "type": "string",
      "description": "来自 docProps/core.xml（cp:revision）的 document 保存计数器。不同于 tracked-change revision；参见 `help docx revision`。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "revision number string",
      "enforcement": "report"
    },
    "created": {
      "type": "string",
      "description": "创建时间戳（ISO-8601）。仅在存在时输出。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "ISO-8601 timestamp",
      "enforcement": "report"
    },
    "modified": {
      "type": "string",
      "description": "最后修改时间戳（ISO-8601）。仅在存在时输出。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "ISO-8601 timestamp",
      "enforcement": "report"
    },
    "protection": {
      "type": "enum",
      "values": [
        "none",
        "readOnly",
        "comments",
        "trackedChanges",
        "forms"
      ],
      "description": "document 保护模式。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "protection mode name",
      "enforcement": "report"
    },
    "protectionEnforced": {
      "type": "bool",
      "description": "是否强制启用 document 保护。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "true | false",
      "enforcement": "report"
    },
    "docGrid.type": {
      "type": "enum",
      "values": [
        "default",
        "lines",
        "linesAndChars",
        "snapToChars"
      ],
      "description": "document grid 类型。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "grid type token",
      "enforcement": "report"
    },
    "docGrid.linePitch": {
      "type": "number",
      "description": "document grid 行距。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "integer",
      "enforcement": "report"
    },
    "docGrid.charSpace": {
      "type": "number",
      "description": "document grid 字符间距。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "integer",
      "enforcement": "report"
    },
    "charSpacingControl": {
      "type": "enum",
      "values": [
        "compressPunctuation",
        "compressPunctuationAndJapaneseKana",
        "doNotCompress"
      ],
      "description": "CJK 字符间距控制。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "spacing control token",
      "enforcement": "report"
    },
    "compatibility.mode": {
      "type": "string",
      "description": "兼容模式标识符。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "compatibility mode value",
      "enforcement": "report"
    },
    "docDefaults.font": {
      "type": "string",
      "description": "默认 Latin 字体。",
      "aliases": [
        "defaultFont"
      ],
      "add": false,
      "set": true,
      "get": true,
      "readback": "font family name",
      "enforcement": "report"
    },
    "docDefaults.font.eastAsia": {
      "type": "string",
      "description": "默认 East Asian 字体槽位。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "font family name",
      "enforcement": "report"
    },
    "docDefaults.font.hAnsi": {
      "type": "string",
      "description": "默认 hAnsi 字体槽位。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "font family name",
      "enforcement": "report"
    },
    "docDefaults.font.complexScript": {
      "type": "string",
      "description": "默认 complex-script 字体槽位。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "font family name",
      "enforcement": "report"
    },
    "docDefaults.fontSize": {
      "type": "font-size",
      "description": "默认字体大小。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "Npt",
      "enforcement": "report"
    },
    "docDefaults.color": {
      "type": "color",
      "description": "默认文本颜色。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "#RRGGBB",
      "enforcement": "report"
    },
    "docDefaults.bold": {
      "type": "bool",
      "description": "默认粗体标记。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "true | false",
      "enforcement": "report"
    },
    "docDefaults.italic": {
      "type": "bool",
      "description": "默认斜体标记。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "true | false",
      "enforcement": "report"
    },
    "docDefaults.rtl": {
      "type": "bool",
      "description": "默认从右到左标记。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "true | false",
      "enforcement": "report"
    },
    "docDefaults.alignment": {
      "type": "string",
      "description": "默认段落对齐方式。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "alignment token",
      "enforcement": "report"
    },
    "docDefaults.spaceBefore": {
      "type": "string",
      "description": "默认段前间距。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "Npt",
      "enforcement": "report"
    },
    "docDefaults.spaceAfter": {
      "type": "string",
      "description": "默认段后间距。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "Npt",
      "enforcement": "report"
    },
    "docDefaults.lineSpacing": {
      "type": "string",
      "description": "默认段落行距。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "1.5x or Npt",
      "enforcement": "report"
    },
    "autoSpaceDE": {
      "type": "bool",
      "description": "East Asian 与 Latin 文本之间的自动间距。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "autoSpaceDN": {
      "type": "bool",
      "description": "East Asian 与数字文本之间的自动间距。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "kinsoku": {
      "type": "bool",
      "description": "日文禁则换行规则。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "overflowPunct": {
      "type": "bool",
      "description": "允许标点溢出页边距。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "embedFonts": {
      "type": "bool",
      "description": "嵌入 TrueType 字体。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "embedSystemFonts": {
      "type": "bool",
      "description": "嵌入系统字体。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "saveSubsetFonts": {
      "type": "bool",
      "description": "保存字体子集。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "mirrorMargins": {
      "type": "bool",
      "description": "为对页使用镜像页边距。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "gutterAtTop": {
      "type": "bool",
      "description": "在顶部设置装订线。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "bookFoldPrinting": {
      "type": "bool",
      "description": "书册折页打印布局。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "evenAndOddHeaders": {
      "type": "bool",
      "description": "为奇偶页使用不同的 header。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "true when settings/evenAndOddHeaders is present",
      "enforcement": "report"
    },
    "updateFields": {
      "type": "bool",
      "description": "写入 <w:updateFields w:val=\"true\"/>，使 Word 在打开时重新计算每个 field（TOC / PAGE / NUMPAGES / SEQ / PAGEREF），而非显示写入时已过期的 cache。可在 /settings 或 / 上设置。",
      "aliases": ["updateFieldsOnOpen"],
      "add": false,
      "set": true,
      "get": true,
      "readback": "true when settings/updateFields is present",
      "enforcement": "report"
    },
    "recalcFields": {
      "type": "enum",
      "values": ["seq"],
      "description": "计算并写入 officecli 无需 layout engine 即可计算的 cached field 值——当前为 SEQ 编号（Figure/Table 1、2、3…，按 body document 顺序计数，并遵循 \\n / \\c / \\r 以及 arabic/roman/alphabetic 格式）。PAGE/PAGEREF/TOC 页码需要 pagination；请结合 updateFields=true 将其延后交给 Word 计算。相对于 heading 的 SEQ（\\s）及 body 外的 SEQ 仍交给 Word。可在 / 上设置。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (action — writes field result caches; read values back via get/query on the field)",
      "enforcement": "report"
    },
    "autoHyphenation": {
      "type": "bool",
      "description": "启用自动连字符（settings/autoHyphenation）。",
      "add": false,
      "set": true,
      "get": true,
      "readback": "true when settings/autoHyphenation is present",
      "enforcement": "report"
    },
    "trackRevisions": {
      "type": "bool",
      "description": "document 级 track-changes MODE 开关（settings/trackRevisions；Word：Review > Track Changes）。开启后，word processor 中的编辑会成为 revision。不同于逐 run/paragraph 的 revision.type key，后者用于写入 tracked-change DATA 本身。可在 /settings 或 / 上设置。",
      "aliases": ["trackChanges"],
      "add": false,
      "set": true,
      "get": true,
      "readback": "true when settings/trackRevisions is present",
      "enforcement": "report"
    },
    "defaultTabStop": {
      "type": "string",
      "description": "默认 tab stop（例如 \"720\" twips 或 \"0.5in\"）。",
      "add": false,
      "set": true,
      "get": false,
      "examples": [
        "--prop defaultTabStop=720",
        "--prop defaultTabStop=0.5in"
      ],
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "displayBackgroundShape": {
      "type": "bool",
      "description": "显示背景 shape。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "removePersonalInformation": {
      "type": "bool",
      "description": "保存时删除个人信息。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "removeDateAndTime": {
      "type": "bool",
      "description": "保存时删除日期和时间。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "printFormsData": {
      "type": "bool",
      "description": "仅打印 form data。",
      "add": false,
      "set": true,
      "get": false,
      "readback": "n/a (set-only)",
      "enforcement": "report"
    },
    "pageWidth": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm (e.g. \"21cm\")",
      "examples": [
        "--prop pageWidth=21cm"
      ],
      "enforcement": "report"
    },
    "sectPr": {
      "type": "enum",
      "values": [
        "present"
      ],
      "add": false,
      "set": true,
      "get": false,
      "description": "dump→batch 往返标记：强制 body 的最后一个 section 输出（可能为空的）<w:sectPr/>，避免空的源 sectPr 被丢弃。供内部往返使用，不是交互式编辑项。",
      "examples": [
        "--prop sectPr=present"
      ],
      "enforcement": "report"
    },
    "pageHeight": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm (e.g. \"29.7cm\")",
      "examples": [
        "--prop pageHeight=29.7cm"
      ],
      "enforcement": "report"
    },
    "orientation": {
      "type": "enum",
      "values": [
        "portrait",
        "landscape"
      ],
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "orientation token",
      "examples": [
        "--prop orientation=landscape"
      ],
      "enforcement": "report"
    },
    "marginTop": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginTop=2.54cm"
      ],
      "enforcement": "report"
    },
    "marginBottom": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginBottom=2.54cm"
      ],
      "enforcement": "report"
    },
    "marginLeft": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginLeft=3.18cm"
      ],
      "enforcement": "report"
    },
    "marginRight": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginRight=3.18cm"
      ],
      "enforcement": "report"
    },
    "marginHeader": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "header 到顶部边缘的距离（pgMar @header）。从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginHeader=1.5cm"
      ],
      "enforcement": "report"
    },
    "marginFooter": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "footer 到底部边缘的距离（pgMar @footer）。从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginFooter=1.75cm"
      ],
      "enforcement": "report"
    },
    "marginGutter": {
      "type": "length",
      "add": false,
      "set": true,
      "get": true,
      "description": "装订线宽度（pgMar @gutter）。从 sectPr 读取的快捷结果；主要编辑路径为 /section[N]。",
      "readback": "length in cm",
      "examples": [
        "--prop marginGutter=0cm"
      ],
      "enforcement": "report"
    },
    "extended.application": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "来自 docProps/app.xml 的 application 标识符（例如 \"Microsoft Word\"）。",
      "readback": "application string",
      "enforcement": "report"
    },
    "bookFoldPrintingSheets": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "settings.xml 的 bookFoldPrintingSheets：书册折页打印时每个 booklet signature 的 sheet 数。",
      "readback": "integer sheets-per-signature",
      "enforcement": "report"
    },
    "bookFoldReversePrinting": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "settings.xml 的 bookFoldRevPrinting 标记：书册折页打印反转页序时为 true。",
      "readback": "true|false",
      "enforcement": "report"
    },
    "doNotDisplayPageBoundaries": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "settings.xml 的 doNotDisplayPageBoundaries 标记：Word view 隐藏 page-boundary frame。",
      "readback": "true when set",
      "enforcement": "report"
    },
    "columns.equalWidth": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "document 默认 column 的等宽标记（body sectPr 中 sectPr cols @equalWidth）。",
      "readback": "true|false",
      "enforcement": "report"
    },
    "columns.separator": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "document 默认 column 的分隔线标记（body sectPr 中 sectPr cols @sep）。",
      "readback": "true|false",
      "enforcement": "report"
    },
    "locale": {
      "type": "string",
      "description": "从 theme themeFontLang 推导的主 document locale（例如 'en-US'、'zh-CN'、'ar-SA'）。仅读摘要；请通过 run lang.* 槽位或 theme themeFontLang 修改。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "BCP-47 locale string",
      "enforcement": "report"
    }
  }
}
