{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "sdt",
  "elementAliases": [
    "contentcontrol"
  ],
  "parent": "body|paragraph",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/sdt[N]",
      "/body/p[N]/sdt[M]"
    ]
  },
  "note": "Aliases：contentcontrol。Structured document tag，可为 inline 或 block；block-level SDT 包装 paragraph，inline SDT 包装 run。",
  "properties": {
    "type": {
      "type": "enum",
      "description": "SDT 变体。add 时支持：text、richtext、dropdown、combobox、date、group、picture、checkbox。add 时尚未实现 buildingBlockGallery / repeatingSection，请在 Word 中创建后再通过 CLI 编辑。创建后不可修改 type。",
      "values": [
        "text",
        "richtext",
        "dropdown",
        "combobox",
        "date",
        "group",
        "picture",
        "checkbox"
      ],
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop type=text",
        "--prop type=dropdown",
        "--prop type=checkbox"
      ],
      "readback": "type descriptor",
      "enforcement": "report"
    },
    "tag": {
      "type": "string",
      "description": "用于 data-binding 的 machine-readable tag。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop tag=customerName"
      ],
      "readback": "Tag attribute",
      "enforcement": "report"
    },
    "alias": {
      "type": "string",
      "description": "在 Word 中显示的 human-readable 名称。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop alias=\"Customer Name\""
      ],
      "readback": "Alias attribute",
      "enforcement": "report"
    },
    "text": {
      "type": "string",
      "description": "placeholder/初始内容。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop text=\"[Enter name]\""
      ],
      "readback": "concatenated text",
      "enforcement": "report"
    },
    "checked": {
      "type": "bool",
      "description": "checkbox content-control 的选中状态（<w14:checked w14:val=\"1|0\">）。仅适用于 Checkbox control，默认 false。内容 run 显示 ☒（checked）/ ☐（unchecked）。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop type=checkbox --prop checked=true"
      ],
      "readback": "true | false (checkbox controls only)",
      "enforcement": "report"
    },
    "format": {
      "type": "string",
      "description": "date-picker 的显示格式字符串（如 yyyy-MM-dd）。仅适用于 Date control。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop format=yyyy-MM-dd"
      ],
      "readback": "DateFormat attribute",
      "enforcement": "report"
    },
    "items": {
      "type": "string",
      "description": "逗号分隔的 dropdown/combobox 选项。当显示文本与存储值不同时，每项可用 display|value 形式（如 Draft|DRAFT）。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop items=Red,Green,Blue",
        "--prop items=\"Draft|DRAFT,Final|FINAL\""
      ],
      "readback": "ListItem display|value list",
      "enforcement": "report"
    },
    "lock": {
      "type": "enum",
      "description": "content-control 锁定方式。unlocked（默认）、contentLocked（内容只读）、sdtLocked（control 不可删除）、sdtContentLocked（两者同时）。",
      "values": [
        "unlocked",
        "contentLocked",
        "sdtLocked",
        "sdtContentLocked"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop lock=sdtContentLocked"
      ],
      "readback": "Lock attribute",
      "enforcement": "report"
    },
    "placeholder": {
      "type": "bool",
      "description": "control 当前显示 placeholder text 时为 true（<w:showingPlcHdr/>）。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop placeholder=true"
      ],
      "readback": "true | false",
      "enforcement": "report"
    },
    "placeholderText": {
      "type": "string",
      "description": "placeholder 内容的 docPart gallery 引用（<w:placeholder><w:docPart w:val=.../></w:placeholder>）。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop placeholderText=DefaultPlaceholder"
      ],
      "readback": "DocPartReference attribute",
      "enforcement": "report"
    },
    "date.fullDate": {
      "type": "string",
      "description": "date-picker 选中的值，使用 ISO-8601 UTC（w:fullDate）。是实际选择的日期，不同于 display format。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop date.fullDate=2026-01-01T00:00:00Z"
      ],
      "readback": "FullDate attribute",
      "enforcement": "report"
    },
    "date.calendar": {
      "type": "string",
      "description": "date-picker calendar system（w:calendar），如 gregorian、hijri、japan。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop date.calendar=gregorian"
      ],
      "readback": "Calendar attribute",
      "enforcement": "report"
    },
    "date.lid": {
      "type": "string",
      "description": "date-picker locale/language id（w:lid），如 en-US。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop date.lid=en-US"
      ],
      "readback": "LanguageId attribute",
      "enforcement": "report"
    },
    "date.storeMappedDataAs": {
      "type": "string",
      "description": "date-picker XML-mapping 的存储类型（w:storeMappedDataAs），如 dateTime、date、text。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop date.storeMappedDataAs=dateTime"
      ],
      "readback": "SdtDateMappingType attribute",
      "enforcement": "report"
    },
    "comboBox.lastValue": {
      "type": "string",
      "description": "combobox 当前选择值（<w:comboBox> 上的 w:lastValue）。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop comboBox.lastValue=B"
      ],
      "readback": "LastValue attribute",
      "enforcement": "report"
    },
    "dropDown.lastValue": {
      "type": "string",
      "description": "dropdown 当前选择值（<w:dropDownList> 上的 w:lastValue）。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop dropDown.lastValue=X"
      ],
      "readback": "LastValue attribute",
      "enforcement": "report"
    },
    "id": {
      "type": "number",
      "description": "OOXML SdtId 值；稳定路径 /sdt[@sdtId=N] 中 @sdtId 的来源。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "integer",
      "enforcement": "report"
    },
    "editable": {
      "type": "bool",
      "description": "当前 content control 的内容被锁定时为 false（lock = contentLocked 或 sdtContentLocked）。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "true | false",
      "enforcement": "report"
    }
  }
}
