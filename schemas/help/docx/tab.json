{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "tab",
  "parent": "paragraph",
  "elementAliases": [
    "tabstop"
  ],
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": false,
    "remove": true
  },
  "paths": {
    "positional": [
      "/body/p[N]/tab[K]",
      "/body/p[@paraId=X]/tab[K]"
    ]
  },
  "note": "Paragraph tab STOP（pPr 的 <w:tabs> 中的 w:tab）。它不同于 ptab（w:ptab，位于 run 中的 inline positional tab）。tab stop 定义 tab character 落在哪里；tab character 本身是 run 中的 <w:tab/>，可通过 add --type run --prop text='\\\\t' 生成。常用场景是在一行中让 equation 居中、编号靠右：在列中点设置 center tab，在右边缘设置 right tab，然后排布 [tab] equation [tab] (1)。Alias：tabstop。",
  "properties": {
    "pos": {
      "type": "length",
      "description": "tab stop 位置。接受 twips（不带单位的整数）或带单位的 length（6cm / 2in / 360pt）。可以为负数（OOXML 允许 tab stop 位于 hanging/negative-indent 区域）。Add 时必填。",
      "aliases": [
        "position"
      ],
      "add": true,
      "set": true,
      "get": true,
      "required": true,
      "examples": [
        "--prop pos=9360",
        "--prop pos=6cm"
      ],
      "readback": "tab stop position in twips",
      "enforcement": "report"
    },
    "val": {
      "type": "enum",
      "description": "tab stop 对齐方式。left/center/right 是常用值；decimal 按小数点对齐数字；bar 绘制竖线；clear 移除继承的 stop；num/start/end 是 legacy/compat 值。",
      "values": [
        "left",
        "center",
        "right",
        "decimal",
        "bar",
        "clear",
        "num",
        "start",
        "end"
      ],
      "default": "left",
      "aliases": [
        "type"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop val=center",
        "--prop val=right"
      ],
      "readback": "tab stop alignment (w:val)",
      "enforcement": "report"
    },
    "leader": {
      "type": "enum",
      "description": "从前置文本延伸到 tab stop 的 leader 字符（例如 table of contents 中的点状 leader）。",
      "values": [
        "none",
        "dot",
        "heavy",
        "hyphen",
        "middleDot",
        "underscore"
      ],
      "default": "none",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop leader=dot"
      ],
      "readback": "tab leader char (w:leader)",
      "enforcement": "report"
    }
  }
}
