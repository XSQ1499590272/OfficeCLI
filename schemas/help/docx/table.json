{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "table",
  "elementAliases": [
    "tbl"
  ],
  "parent": "body",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/body/tbl[N]"
    ]
  },
  "note": "Table 默认所有边使用 Single/Size=4 border。Length props 接受 twips（raw int）或带单位的值。可通过 'data'（分号分隔 rows、逗号分隔 cells）或 per-cell 的 'r{R}c{C}' props 预填数据。cantSplit、noWrap、hideMark 作用于 row/cell，而不是 table props；参见 'help docx table-row' 和 'help docx table-cell'。",
  "children": [
    {
      "element": "row",
      "pathSegment": "tr",
      "cardinality": "1..n"
    },
    {
      "element": "cell",
      "pathSegment": "tc",
      "cardinality": "1..n (per row)"
    }
  ],
  "extends": [
    "_shared/table",
    "_shared/table.docx-pptx"
  ],
  "properties": {
    "colWidths": {
      "type": "string",
      "description": "以逗号分隔的每列宽度，单位为 twips。别名：colwidths。",
      "aliases": [
        "colwidths"
      ],
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop colWidths=3000,2000,5000"
      ],
      "readback": "comma-separated column widths in OOXML units",
      "enforcement": "strict"
    },
    "direction": {
      "type": "enum",
      "values": [
        "rtl",
        "ltr"
      ],
      "aliases": [
        "dir",
        "bidi"
      ],
      "description": "阅读方向（Arabic / Hebrew）。'rtl' 会在 tblPr 写入 <w:bidiVisual/>（反转列顺序）；'ltr' 清除它。不同于单元格级 textDirection。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop direction=rtl"
      ],
      "readback": "rtl when set, key absent otherwise",
      "enforcement": "report"
    },
    "align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right"
      ],
      "aliases": [
        "alignment"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop align=center"
      ],
      "readback": "one of values",
      "enforcement": "report"
    },
    "indent": {
      "type": "int",
      "description": "table 缩进，单位为 twips。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop indent=200"
      ],
      "readback": "twips",
      "enforcement": "report"
    },
    "cellSpacing": {
      "type": "int",
      "description": "单元格之间的间距，单位为 twips。别名：cellspacing。",
      "aliases": [
        "cellspacing"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop cellSpacing=40"
      ],
      "readback": "twips",
      "enforcement": "report"
    },
    "layout": {
      "type": "enum",
      "values": [
        "fixed",
        "autofit"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop layout=fixed"
      ],
      "readback": "one of values",
      "enforcement": "report"
    },
    "padding": {
      "type": "int",
      "description": "默认单元格内边距（四边），单位为 twips。仅 Add/Set；当前 Get 不返回 table-default cell margin。",
      "add": true,
      "set": true,
      "get": false,
      "examples": [
        "--prop padding=100"
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "caption": {
      "type": "string",
      "description": "table 的 accessibility caption（<w:tblCaption> @w:val）。会提供给 assistive technology。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop caption=\"...\""
      ],
      "readback": "string value",
      "enforcement": "report"
    },
    "description": {
      "type": "string",
      "description": "table 的 accessibility description / long-desc（<w:tblDescription> @w:val）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop description=\"...\""
      ],
      "readback": "string value",
      "enforcement": "report"
    },
    "rowBandSize": {
      "type": "integer",
      "description": "应用 banded table style 时每个 band 的行数（<w:tblStyleRowBandSize> @w:val）。默认 1；如设为 2，则每隔一行使用同一条纹。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop rowBandSize=2"
      ],
      "readback": "integer value",
      "enforcement": "report"
    },
    "colBandSize": {
      "type": "integer",
      "description": "应用 banded table style 时每个 band 的列数（<w:tblStyleColBandSize> @w:val）。默认 1。别名：columnBandSize。",
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop colBandSize=3"
      ],
      "readback": "integer value",
      "enforcement": "report"
    },
    "tblLook": {
      "type": "string",
      "description": "conditional-formatting bitmask（<w:tblLook> @w:val，4 位 hex），用于选择 conditional/banded table style 的生效 facet：0x0020 firstRow、0x0040 lastRow、0x0080 firstColumn、0x0100 lastColumn、0x0200 noHBand、0x0400 noVBand。w:val hex 是权威值（Word 也会读取拆分后的 boolean 属性，但以 w:val 为准）。Get 返回源 hex（如 0620），因此 dump→batch 可保留每一位；默认 04A0（firstRow+firstColumn）仅在应用 table style 且未指定 tblLook 时写入。拆分 facet 也可通过 firstRow/lastRow/firstColumn/lastColumn/bandRow/bandCol，或 tblLook.<facet> 组合形式设置。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop tblLook=0620",
        "--prop tblLook.firstRow=true --prop tblLook.firstColumn=false"
      ],
      "readback": "4-digit uppercase hex bitmask",
      "enforcement": "report"
    }
  }
}
