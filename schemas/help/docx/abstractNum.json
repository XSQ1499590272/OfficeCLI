{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "abstractNum",
  "parent": "numbering",
  "addParent": "/numbering",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "stable": ["/numbering/abstractNum[@id=N]"],
    "positional": ["/numbering/abstractNum[N]"]
  },
  "note": "Numbering template（<w:abstractNum>）。定义 list 的外观：包含 9 个 level，每个 level 都有自己的 number format、marker text、indent、start value 和 marker run properties。可复用：多个 <w:num> instance 可以共享同一个 abstractNum。要将 list 应用到 paragraph，先创建指向此 abstractNumId 的 <w:num>（--type num --prop abstractNumId=N），再在 paragraph 或 style 上引用该 numId（--prop numId=N --prop ilvl=L）。顶层 format/text/start/indent 是 level0.* 的 shorthand；每级定制使用 level<N>.*（N = 0..8）。如果设置顶层 format，所有 level 都会继承它，不再循环使用 decimal/lowerLetter/lowerRoman。",
  "properties": {
    "id": {
      "type": "int",
      "description": "abstractNumId（w:abstractNumId，在 /numbering 内唯一）。省略时自动分配。Add 后不支持改名，否则引用它的每个 <w:num> 都会失去关联。",
      "add": true,
      "set": false,
      "get": true,
      "examples": ["--prop id=5"],
      "readback": "integer abstractNumId",
      "enforcement": "strict"
    },
    "type": {
      "type": "enum",
      "values": ["hybridMultilevel", "multilevel", "singleLevel"],
      "aliases": {
        "hybridMultilevel": ["hybrid"],
        "multilevel": ["multi"],
        "singleLevel": ["single"]
      },
      "description": "multiLevelType（w:multiLevelType）。默认值：hybridMultilevel。Hybrid 是 Word 为临时列表写入的格式；singleLevel 将 bullets/numbers 限定在 level 0。",
      "add": true,
      "set": true,
      "get": true,
      "examples": ["--prop type=hybridMultilevel"],
      "readback": "hybridMultilevel | multilevel | singleLevel",
      "enforcement": "report"
    },
    "name": {
      "type": "string",
      "description": "人类可读的名称（w:name）。可选；Word 会在 Numbering 对话框中显示它。",
      "add": true,
      "set": true,
      "get": true,
      "examples": ["--prop name=\"Chapter outline\""],
      "readback": "AbstractNumDefinitionName.Val",
      "enforcement": "report"
    },
    "styleLink": {
      "type": "string",
      "description": "反向关联的 numbering style（w:styleLink）。可选。",
      "add": true,
      "set": true,
      "get": true,
      "examples": ["--prop styleLink=MyListStyle"],
      "readback": "StyleLink.Val",
      "enforcement": "report"
    },
    "numStyleLink": {
      "type": "string",
      "description": "通过 numbering style 链接到其他 abstractNum（w:numStyleLink）。可选。",
      "add": true,
      "set": true,
      "get": true,
      "examples": ["--prop numStyleLink=OutlineList"],
      "readback": "NumberingStyleLink.Val",
      "enforcement": "report"
    },
    "format": {
      "type": "string",
      "description": "level 0 的 numFmt（未逐层覆盖时会传播到全部 9 层）。常用值：decimal、decimalZero、upperRoman、lowerRoman、upperLetter、lowerLetter、ordinal、cardinalText、ordinalText、bullet、chineseCounting、chineseLegalSimplified、japaneseCounting、koreanCounting、hex。按脚本本地化的格式：arabicAlpha（أ ب ت ث）、arabicAbjad（أ ب ج د）、hebrew1、hebrew2、hindiNumbers、hindiVowels、hindiCounting、hindiConsonants、thaiCounting、thaiNumbers、thaiLetters。顶层裸 'format' 是 level0.format 的简写；设置后也会让其余 level 默认使用相同格式，而非 decimal/lowerLetter/lowerRoman 循环。",
      "aliases": ["fmt", "numFmt"],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop format=decimal",
        "--prop format=bullet",
        "--prop format=chineseCounting",
        "--prop format=arabicAlpha"
      ],
      "readback": "n/a (surfaces on /numbering/abstractNum[@id=N]/level[L])",
      "enforcement": "report"
    },
    "text": {
      "type": "string",
      "description": "lvlText for level 0. Use %N as placeholder for level N's running counter (e.g. '%1.', '%1.%2', '第%1章'). Bullet marker default: •. Top-level bare 'text' is shorthand for level0.text.",
      "aliases": ["lvlText"],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop text=\"%1.\"",
        "--prop text=\"第%1章\"",
        "--prop lvlText=\"%1.%2\""
      ],
      "readback": "n/a (surfaces on /numbering/abstractNum[@id=N]/level[L])",
      "enforcement": "report"
    },
    "start": {
      "type": "int",
      "description": "level 0 的起始编号。默认 1。是 level0.start 的简写。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop start=5"],
      "readback": "n/a (surfaces on /numbering/abstractNum[@id=N]/level[L])",
      "enforcement": "report"
    },
    "indent": {
      "type": "int",
      "description": "level 0 的左缩进，单位为 twips。默认值为 (level+1)*720。是 level0.indent 的简写。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop indent=720"],
      "readback": "n/a (surfaces on /numbering/abstractNum[@id=N]/level[L])",
      "enforcement": "report"
    },
    "level<N>.format": {
      "type": "string",
      "description": "level N（N = 0..8）的 numFmt。可用值与裸 'format' 相同。逐层覆盖；仅设置实际使用的 level，其余 level 回退到 decimal/lowerLetter/lowerRoman 循环（或 'format' 传播的格式）。",
      "aliases": ["level<N>.fmt", "level<N>.numFmt"],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop level0.format=upperRoman --prop level1.format=decimal"
      ],
      "readback": "n/a (surfaces on level[N])",
      "enforcement": "report"
    },
    "level<N>.text": {
      "type": "string",
      "description": "level N 的 lvlText。使用相同的 %N placeholder 语法。",
      "aliases": ["level<N>.lvlText"],
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop level0.text=\"%1.\" --prop level1.text=\"%1.%2\""
      ],
      "readback": "n/a (surfaces on level[N])",
      "enforcement": "report"
    },
    "level<N>.start": {
      "type": "int",
      "description": "level N 的起始编号。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level3.start=1"],
      "readback": "n/a (surfaces on level[N])",
      "enforcement": "report"
    },
    "level<N>.indent": {
      "type": "int",
      "description": "level N 的左缩进，单位为 twips。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.indent=720"],
      "readback": "n/a (surfaces on level[N])",
      "enforcement": "report"
    },
    "level<N>.hanging": {
      "type": "int",
      "description": "level N 的悬挂缩进，单位为 twips。默认 360。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.hanging=360"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.justification": {
      "type": "enum",
      "values": ["left", "center", "right"],
      "aliases": ["level<N>.jc"],
      "description": "lvlJc：marker 在缩进区域内的对齐方式。默认 left。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.justification=left"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.suff": {
      "type": "enum",
      "values": ["tab", "space", "nothing"],
      "description": "marker 与文本内容之间的分隔内容。默认 tab。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.suff=space"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.font": {
      "type": "string",
      "description": "marker font（level 上的 rPr/rFonts）。适用于需要 Symbol 或 Wingdings 的 bullet glyph。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.font=Symbol"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.size": {
      "type": "font-size",
      "description": "marker font size（level 上的 rPr/sz）。裸数字按 pt 处理。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.size=14"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.color": {
      "type": "color",
      "description": "marker color（level 上的 rPr/color）。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.color=#FF0000"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.bold": {
      "type": "bool",
      "description": "marker 的 bold 设置。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.bold=true"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "level<N>.italic": {
      "type": "bool",
      "description": "marker 的 italic 设置。",
      "add": true,
      "set": false,
      "get": false,
      "examples": ["--prop level0.italic=true"],
      "readback": "n/a",
      "enforcement": "report"
    },
    "abstractNumId": {
      "type": "int",
      "description": "id 的读取别名（与 w:abstractNumId 属性名称一致）。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "integer",
      "enforcement": "report"
    }
  },
  "children": [
    { "element": "level", "pathSegment": "level", "cardinality": "0..9" }
  ]
}
