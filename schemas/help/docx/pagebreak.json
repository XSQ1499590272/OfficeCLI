{
  "$schema": "../_schema.json",
  "format": "docx",
  "element": "pagebreak",
  "elementAliases": ["break", "columnbreak"],
  "parent": "paragraph|body",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/body/p[@paraId=X]/r[N]", "/header[N]/p[M]/r[K]", "/footer[N]/p[M]/r[K]"]
  },
  "note": "Inline w:br element 会包装在 run 中。Aliases：columnbreak、break。type=column 表示 column break；type=page（默认）表示 page break；type=line/textWrapping 表示 soft line break。当 run 除 <w:br> 外不带 <w:t> 时，Get 会以 type=break 返回。",
  "properties": {
    "type": {
      "type": "enum",
      "values": ["page", "column", "textWrapping", "line"],
      "default": "page",
      "add": true, "set": false, "get": true,
      "examples": ["--prop type=page", "--prop type=column"],
      "readback": "n/a (use 'breakType' on Get / Set)",
      "enforcement": "report",
      "description": "仅用于 Add 的 alias；Get 会以 'breakType' 返回，Set 必须使用 'breakType'。"
    },
    "breakType": {
      "type": "enum",
      "values": ["page", "column", "textWrapping", "line"],
      "aliases": ["breaktype"],
      "add": false, "set": true, "get": true,
      "examples": ["--prop breakType=column"],
      "readback": "br type attribute",
      "enforcement": "report",
      "description": "Get/Set 使用的 canonical key。为兼容历史 alias，Add 同时接受 'type' 作为 synonym。"
    }
  }
}
