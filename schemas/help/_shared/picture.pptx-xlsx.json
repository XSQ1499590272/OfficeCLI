{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "crop": {
      "type": "string",
      "description": "以百分比指定裁剪（0–100）。1 个值表示对称裁剪，2 个值依次为 vertical、horizontal，4 个值依次为 left、top、right、bottom。",
      "add": true,
      "set": true,
      "examples": [
        "--prop crop=10",
        "--prop crop=5,10",
        "--prop crop=10,5,10,5"
      ],
      "enforcement": "report",
      "get": true,
      "readback": "as emitted by handler (per-format details vary)"
    },
    "cropBottom": {
      "type": "string",
      "description": "从下边缘裁剪的百分比（0–100）。别名：cropbottom。",
      "aliases": [
        "cropbottom"
      ],
      "add": true,
      "set": true,
      "examples": [
        "--prop cropBottom=10"
      ],
      "enforcement": "report"
    },
    "cropLeft": {
      "type": "string",
      "description": "从左侧裁剪，可传分数（<=1）或百分比（>1）。例如 cropLeft=0.1 和 cropLeft=10 均表示 10%。",
      "add": true,
      "set": true,
      "examples": [
        "--prop cropLeft=0.1",
        "--prop cropLeft=10"
      ],
      "enforcement": "report",
      "aliases": [
        "cropleft"
      ]
    },
    "cropRight": {
      "type": "string",
      "description": "从右边缘裁剪的百分比（0–100）。别名：cropright。",
      "aliases": [
        "cropright"
      ],
      "add": true,
      "set": true,
      "examples": [
        "--prop cropRight=10"
      ],
      "enforcement": "report"
    },
    "cropTop": {
      "type": "string",
      "description": "从上边缘裁剪的百分比（0–100）。别名：croptop。",
      "aliases": [
        "croptop"
      ],
      "add": true,
      "set": true,
      "examples": [
        "--prop cropTop=10"
      ],
      "enforcement": "report"
    },
    "name": {
      "type": "string",
      "description": "覆盖 cNvPr @name 中自动生成的 'Picture {id}' 标签。",
      "add": true,
      "set": false,
      "examples": [
        "--prop name=\"hero-image\"",
        "--prop name=\"Hero Image\""
      ],
      "enforcement": "report",
      "get": true,
      "readback": "shape name string"
    }
  }
}
