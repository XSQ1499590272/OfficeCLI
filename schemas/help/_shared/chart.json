{
  "$schema": "../_schema.json",
  "element": "chart",
  "shared_base": true,
  "properties": {
    "areafill": {
      "type": "string",
      "aliases": [
        "area.fill"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "应用到每个 series shape 的填充。可为纯色或渐变 'c1-c2[:angle]'。",
      "examples": [
        "--prop areafill=4472C4-A5C8FF:90"
      ]
    },
    "autotitledeleted": {
      "type": "bool",
      "add": true,
      "set": true,
      "get": false,
      "description": "隐藏自动生成的 'Chart Title' placeholder。",
      "examples": [
        "--prop autotitledeleted=true"
      ]
    },
    "axisfont": {
      "type": "string",
      "aliases": [
        "axis.font"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 axisFont 快捷入口；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axisfont=10:8B949E:Helvetica"
      ]
    },
    "axisline": {
      "type": "string",
      "aliases": [
        "axis.line"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 lineWidth/lineDash 快捷入口；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axisline=666666:1"
      ]
    },
    "axismax": {
      "type": "number",
      "aliases": [
        "max"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 max 快捷入口，作用于 value/value2；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axismax=1000",
        "--prop axismax=250"
      ]
    },
    "axismin": {
      "type": "number",
      "aliases": [
        "min"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 min 快捷入口，作用于 value/value2；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axismin=0"
      ]
    },
    "axisnumfmt": {
      "type": "string",
      "aliases": [
        "axisnumberformat"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 axisNumFmt / format 快捷入口；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axisnumfmt=\"#,##0\""
      ]
    },
    "axisorientation": {
      "type": "string",
      "aliases": [
        "axisreverse"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 axisOrientation 快捷入口；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axisorientation=true"
      ]
    },
    "axisposition": {
      "type": "string",
      "aliases": [
        "axispos"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 tickLabelPos / crossBetween 快捷入口；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axisposition=top"
      ]
    },
    "axistitle": {
      "type": "string",
      "aliases": [
        "vtitle"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 title 快捷入口，作用于 value-axis；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axistitle=\"Revenue\""
      ]
    },
    "axisvisible": {
      "type": "bool",
      "aliases": [
        "axis.delete",
        "axis.visible"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 visible 快捷入口；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop axisvisible=false"
      ]
    },
    "bubbleScale": {
      "type": "number",
      "add": true,
      "set": true,
      "get": true,
      "description": "bubble chart 缩放比例（默认值的百分比）。",
      "readback": "integer percentage",
      "enforcement": "report",
      "aliases": [
        "bubblescale"
      ],
      "examples": [
        "--prop bubblescale=100"
      ],
      "appliesWhen": {
        "chartType": [
          "bubble"
        ]
      }
    },
    "catAxisVisible": {
      "type": "bool",
      "add": true,
      "set": true,
      "get": true,
      "description": "/chart[N]/axis[@role=...] 的 visible 快捷入口，作用于 role=category；完整的 axis 级选项请参见 chart-axis schema。",
      "readback": "true | false",
      "enforcement": "report",
      "aliases": [
        "cataxis.visible",
        "cataxisvisible"
      ],
      "examples": [
        "--prop cataxisvisible=false"
      ]
    },
    "catTitle": {
      "type": "string",
      "add": true,
      "set": true,
      "get": true,
      "description": "category axis 标题文本。",
      "readback": "title string",
      "enforcement": "report",
      "aliases": [
        "htitle",
        "cattitle"
      ],
      "examples": [
        "--prop cattitle=\"Quarter\""
      ]
    },
    "cataxisline": {
      "type": "string",
      "aliases": [
        "cataxis.line"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 lineWidth/lineDash 快捷入口，作用于 role=category；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop cataxisline=333333:1"
      ]
    },
    "categories": {
      "type": "string",
      "description": "以逗号分隔的 category labels，或 cell range reference（例如 Sheet1!A2:A5）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop categories=A,B,C",
        "--prop categories=\"Q1,Q2,Q3,Q4\"",
        "--prop categories=\"Sheet1!$A$2:$A$5\""
      ],
      "readback": "comma-separated category labels",
      "enforcement": "strict"
    },
    "chartFill": {
      "type": "color",
      "add": true,
      "set": true,
      "get": true,
      "description": "chart 级填充颜色，接受 #RRGGBB、命名颜色或 scheme 名称。",
      "readback": "#RRGGBB or color descriptor",
      "enforcement": "report"
    },
    "chartType": {
      "type": "enum",
      "values": [
        "bar",
        "column",
        "line",
        "pie",
        "doughnut",
        "area",
        "scatter",
        "bubble",
        "radar",
        "stock",
        "combo",
        "waterfall",
        "funnel",
        "treemap",
        "sunburst",
        "boxWhisker",
        "histogram",
        "pareto"
      ],
      "modifiers": {
        "3d": {
          "suffix": "3d",
          "example": "column3d",
          "appliesWhen": {
            "chartType": [
              "bar",
              "column",
              "line",
              "pie",
              "area"
            ]
          }
        },
        "stacked": {
          "prefix": "stacked",
          "example": "stackedBar",
          "appliesWhen": {
            "chartType": [
              "bar",
              "column",
              "line",
              "area"
            ]
          }
        },
        "percentStacked": {
          "prefix": "percentStacked",
          "example": "percentStackedBar",
          "appliesWhen": {
            "chartType": [
              "bar",
              "column",
              "line",
              "area"
            ]
          }
        }
      },
      "aliases": [
        "type",
        "col",
        "donut",
        "xy",
        "spider",
        "ohlc",
        "wf",
        "charttype"
      ],
      "propAliases": [
        "type"
      ],
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop chartType=column",
        "--prop chartType=stackedBar",
        "--prop chartType=percentStackedColumn",
        "--prop chartType=column3d",
        "--prop chartType=waterfall"
      ],
      "readback": "normalized chartType string without modifiers (modifiers surface as separate flags in later iterations)",
      "setNote": "chart type is fixed at creation; changing it post-hoc would require rebuilding the chart XML (series/axes differ per type). Remove and re-add the chart to change its type, or use combotypes for per-series type overrides.",
      "enforcement": "strict"
    },
    "chartareafill": {
      "type": "string",
      "aliases": [
        "chartfill"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "chart-area 背景填充。可为纯色、渐变或 'none'。",
      "examples": [
        "--prop chartareafill=FFFFFF"
      ]
    },
    "chartborder": {
      "type": "string",
      "aliases": [
        "chartarea.border"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "chart-area 外边框线。格式与 plotborder 相同。",
      "examples": [
        "--prop chartborder=000000:1",
        "--prop chartborder=none"
      ]
    },
    "colorrule": {
      "type": "string",
      "aliases": [
        "conditionalcolor",
        "colorRule"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "按 data-point 应用的条件颜色。格式：'threshold:belowColor:aboveColor'。",
      "examples": [
        "--prop colorrule=0:FF0000:00AA00"
      ]
    },
    "colors": {
      "type": "string",
      "description": "以逗号分隔的 series 填充颜色，按位置对应（第 1 个颜色 → series 1）。每个 series 的点分 key（series1.color=...）会覆盖位置指定。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop colors=\"4472C4,ED7D31,A5A5A5\""
      ],
      "enforcement": "strict"
    },
    "combosplit": {
      "type": "number",
      "add": true,
      "set": false,
      "get": false,
      "description": "combo chart 的切分索引：前 N 个 series 使用主 chart type，其余使用次 chart type。仅 add 时使用。",
      "examples": [
        "--prop combosplit=2"
      ]
    },
    "combotypes": {
      "type": "string",
      "aliases": [
        "combo.types"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "按每个 series 的 chart type 重建为 combo chart（column、line、area 等）。以逗号分隔，每个 series 一个值。",
      "examples": [
        "--prop combotypes=\"column,column,line\""
      ]
    },
    "crossBetween": {
      "type": "string",
      "add": true,
      "set": true,
      "get": true,
      "description": "category axis 的 cross-between 行为（between / midCat）。",
      "examples": [
        "--prop crossBetween=between",
        "--prop crossbetween=midcat"
      ],
      "readback": "crossBetween token",
      "enforcement": "report",
      "aliases": [
        "crossbetween"
      ]
    },
    "crosses": {
      "type": "string",
      "add": true,
      "set": true,
      "get": true,
      "description": "value axis 与 category axis 的交叉位置。可选值：autoZero（默认）、max、min。",
      "examples": [
        "--prop crosses=max"
      ],
      "readback": "crosses token"
    },
    "crossesAt": {
      "type": "number",
      "add": true,
      "set": true,
      "get": true,
      "description": "value-axis 的 crossesAt 读取结果。",
      "readback": "numeric value",
      "enforcement": "report",
      "aliases": [
        "crossesat"
      ],
      "examples": [
        "--prop crossesat=0"
      ]
    },
    "data": {
      "type": "string",
      "description": "内联 series 规格：'Name:1,2,3' 或 'Name1:1,2,3;Name2:4,5,6'。仅 add 时使用；创建后请使用每个 series 的 chart-series Set。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop data=\"Sales:10,20,30\"",
        "--prop data=\"Sales:10,20,30;Cost:5,8,12\""
      ],
      "readback": "n/a",
      "enforcement": "report"
    },
    "dataLabels": {
      "type": "string",
      "aliases": [
        "datalabels",
        "labels"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "显示或隐藏 data labels。传入 'none' 隐藏；否则传入以逗号分隔的 flags：value、percent、category、series、all（也接受 seriesName/categoryName/percentage/values 别名）。位置值 outsideEnd/center/insideEnd/insideBase/top/bottom/left/right/bestFit 会隐式启用 showVal，并作为 dLblPos 应用。",
      "examples": [
        "--prop dataLabels=value",
        "--prop dataLabels=\"value,percent\"",
        "--prop dataLabels=outsideEnd",
        "--prop dataLabels=none"
      ],
      "readback": "comma-separated flags: value,percent,category,series"
    },
    "dataTable": {
      "type": "bool",
      "aliases": [
        "datatable"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "在 chart 下方显示 data table（带默认边框和 legend keys）。",
      "examples": [
        "--prop dataTable=true"
      ],
      "readback": "true | false"
    },
    "decreaseColor": {
      "type": "color",
      "add": true,
      "set": false,
      "get": false,
      "description": "waterfall：负值 bar 的颜色。仅 add 时使用。",
      "examples": [
        "--prop decreaseColor=FF0000"
      ]
    },
    "dispBlanksAs": {
      "type": "enum",
      "values": [
        "gap",
        "zero",
        "span"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "空 cell 的呈现方式：gap 留出空缺、zero 按 0 绘制、span 跨越空缺连接。",
      "examples": [
        "--prop dispBlanksAs=gap"
      ],
      "readback": "dispBlanksAs token",
      "enforcement": "report"
    },
    "droplines": {
      "type": "string",
      "appliesWhen": {
        "chartType": [
          "line"
        ]
      },
      "add": true,
      "set": true,
      "get": true,
      "description": "line chart 的 drop lines。可传 true|false 开关或线条规格 'color[:width[:dash]]'；传入 'none' 可移除。",
      "examples": [
        "--prop droplines=true",
        "--prop droplines=808080:0.5"
      ]
    },
    "errbars": {
      "type": "string",
      "aliases": [
        "errorbars"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "每个 series 的 error bars。格式：'type:value'，其中 type ∈ fixed（别名：fixedValue）、percent（别名：percentage、pct）、stddev（别名：standardDeviation）、stderr（别名：standardError）。传入 'none' 可移除。",
      "examples": [
        "--prop errbars=fixed:5",
        "--prop errbars=none",
        "--prop errbars=percent:10"
      ]
    },
    "explosion": {
      "type": "number",
      "aliases": [
        "explode"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "pie/doughnut 切片的分离程度，范围 0..100（半径百分比）；0 表示取消分离。",
      "examples": [
        "--prop explosion=10"
      ],
      "readback": "as emitted by handler (per-format details vary)"
    },
    "firstSliceAngle": {
      "type": "number",
      "add": true,
      "set": true,
      "get": true,
      "description": "pie/doughnut 第一个切片的角度（度）。",
      "readback": "integer degrees",
      "enforcement": "report",
      "aliases": [
        "sliceangle",
        "firstsliceangle"
      ],
      "examples": [
        "--prop firstsliceangle=90"
      ],
      "appliesWhen": {
        "chartType": [
          "pie"
        ]
      }
    },
    "gapdepth": {
      "type": "number",
      "appliesWhen": {
        "chartType": [
          "bar3d",
          "line3d",
          "area3d"
        ]
      },
      "add": true,
      "set": true,
      "get": false,
      "description": "3D bar/line/area chart 中 series 之间的深度间隔（百分比）。",
      "examples": [
        "--prop gapdepth=150"
      ]
    },
    "gapwidth": {
      "type": "number",
      "aliases": [
        "gap"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "bar/column 组之间的间隔，范围 0..500（bar 宽度的百分比）。",
      "examples": [
        "--prop gapwidth=150"
      ],
      "readback": "integer 0..500"
    },
    "gradient": {
      "type": "string",
      "aliases": [
        "gradientfill"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "应用到每个 series 的渐变填充。格式：'c1-c2[-c3][:angle]'（angle 单位为度）。chart 没有 series 时会报错。",
      "examples": [
        "--prop gradient=FF0000-0000FF",
        "--prop gradient=FF0000-00FF00-0000FF:90"
      ],
      "readback": "as emitted by handler (per-format details vary)"
    },
    "gradients": {
      "type": "string",
      "add": true,
      "set": true,
      "get": false,
      "description": "每个 series 的渐变填充，以分号分隔；每个 series 对应一个条目。",
      "examples": [
        "--prop gradients=\"FF0000-0000FF;00FF00-FFFF00\""
      ]
    },
    "gridlines": {
      "type": "bool",
      "aliases": [
        "majorgridlines"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "value-axis 的主网格线。可传 true|false 开关，或使用线条规格 'color'、'color:width'、'color:width:dash' 设置样式；传入 'none' 可移除。",
      "examples": [
        "--prop gridlines=true",
        "--prop gridlines=E0E0E0:0.3",
        "--prop gridlines=none"
      ],
      "readback": "true | false"
    },
    "height": {
      "type": "length",
      "add": true,
      "set": true,
      "get": true,
      "description": "chart frame 高度；接受 cm/in/pt/EMU。设置 anchor= 时会忽略此值。",
      "examples": [
        "--prop height=10cm"
      ]
    },
    "hilowlines": {
      "type": "string",
      "appliesWhen": {
        "chartType": [
          "line",
          "stock"
        ]
      },
      "add": true,
      "set": true,
      "get": true,
      "description": "line/stock chart 的 high-low lines。格式与 droplines 相同。",
      "examples": [
        "--prop hilowlines=true"
      ]
    },
    "holeSize": {
      "type": "number",
      "add": true,
      "set": true,
      "get": true,
      "description": "doughnut hole size 的读取结果。",
      "readback": "integer 10..90 percent",
      "enforcement": "report",
      "aliases": [
        "holesize"
      ],
      "examples": [
        "--prop holesize=50",
        "--prop holeSize=50"
      ],
      "appliesWhen": {
        "chartType": [
          "doughnut"
        ]
      }
    },
    "increaseColor": {
      "type": "color",
      "add": true,
      "set": false,
      "get": false,
      "description": "waterfall：正值 bar 的颜色。仅 add 时使用。",
      "examples": [
        "--prop increaseColor=00AA00"
      ]
    },
    "invertifneg": {
      "type": "bool",
      "aliases": [
        "invertifnegative"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "为 true 时，使用反相（更浅）的颜色绘制负值 bar。",
      "examples": [
        "--prop invertifneg=true"
      ]
    },
    "labelPos": {
      "type": "string",
      "aliases": [
        "labelpos",
        "labelposition"
      ],
      "add": true,
      "set": true,
      "get": true,
      "description": "data label 位置。可选值：center|ctr、insideEnd|inEnd|inside、insideBase|inBase|base、outsideEnd|outEnd|outside、bestFit|best|auto、top|t、bottom|b、left|l、right|r。限制：doughnut/area/radar/stock 不支持；pie/pie3D 仅限 ctr/inEnd/inBase/bestFit（其他 token 会按 OOXML ST_DLblPosPie 被拒绝）；stacked series 会限制为 ctr/inBase/inEnd；combo chart 完全跳过。",
      "examples": [
        "--prop labelPos=outsideEnd"
      ],
      "readback": "OOXML position token: ctr/inEnd/inBase/outEnd/bestFit/t/b/l/r"
    },
    "labelfont": {
      "type": "string",
      "add": true,
      "set": true,
      "get": false,
      "description": "data label 文本字体。格式：'size:color:fontname'（每一段均可省略）。读取结果会拆为 labelFont.size / labelFont.color / labelFont.bold / labelFont.name（每个槽位一个 key），使 dump→replay 无需解析即可重建复合规格。",
      "examples": [
        "--prop labelfont=9:333333:Calibri"
      ]
    },
    "labelFont.size": {
      "type": "number",
      "get": true,
      "description": "data label 字体大小，单位为 points。为 labelfont= 中 size 槽位的读取结果（BuildLabelTextProperties 的 DefaultRunProperties.FontSize）。",
      "examples": []
    },
    "labelFont.color": {
      "type": "string",
      "get": true,
      "description": "data label 字体颜色（hex，例如 #FF0000）。为 labelfont= 中 color 槽位的读取结果。",
      "examples": []
    },
    "labelFont.bold": {
      "type": "bool",
      "get": true,
      "description": "data label 字体粗体标记。仅在为 true 时输出。",
      "examples": []
    },
    "labelFont.name": {
      "type": "string",
      "get": true,
      "description": "data label 字体（latin）。为 labelfont= 中 fontname 槽位的读取结果。",
      "examples": []
    },
    "labeloffset": {
