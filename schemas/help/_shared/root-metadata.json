{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "extended.applicationVersion": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 AppVersion 字段。",
      "readback": "version string",
      "enforcement": "report"
    },
    "extended.characters": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 Characters 计数。",
      "readback": "integer",
      "enforcement": "report"
    },
    "extended.company": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/app.xml 中的 Company 字段。",
      "readback": "company name",
      "enforcement": "report"
    },
    "extended.lines": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 Lines 计数。",
      "readback": "integer",
      "enforcement": "report"
    },
    "extended.manager": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/app.xml 中的 Manager 字段。",
      "readback": "manager name",
      "enforcement": "report"
    },
    "extended.pages": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 Pages 计数。",
      "readback": "integer",
      "enforcement": "report"
    },
    "extended.paragraphs": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 Paragraphs 计数。",
      "readback": "integer",
      "enforcement": "report"
    },
    "extended.template": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/app.xml 中的 Template 字段。",
      "readback": "template name",
      "enforcement": "report"
    },
    "extended.totalTime": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 TotalTime 字段，单位为分钟。",
      "readback": "integer minutes",
      "enforcement": "report"
    },
    "extended.words": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "docProps/app.xml 中的 Words 计数。",
      "readback": "integer",
      "enforcement": "report"
    },
    "subject": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop subject=Finance"
      ],
      "readback": "subject string",
      "enforcement": "report"
    },
    "theme.color.accent1": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题强调色 1。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.accent2": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题强调色 2。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.accent3": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题强调色 3。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.accent4": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题强调色 4。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.accent5": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题强调色 5。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.accent6": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题强调色 6。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.dk1": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题颜色槽位 dk1（dark 1 / 默认文本）。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.dk2": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题颜色槽位 dk2（dark 2）。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.folHlink": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题中已访问 hyperlink 的颜色。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.hlink": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题 hyperlink 颜色。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.lt1": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题颜色槽位 lt1（light 1 / 默认背景）。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.color.lt2": {
      "type": "color",
      "add": false,
      "set": true,
      "get": true,
      "description": "主题颜色槽位 lt2（light 2）。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    },
    "theme.colorScheme": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "颜色方案名称（a:clrScheme/@name）。",
      "readback": "color scheme name",
      "enforcement": "report"
    },
    "theme.font.major.eastAsia": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "major（heading）East Asian 字体。",
      "readback": "font family name",
      "enforcement": "report"
    },
    "theme.font.major.latin": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "major（heading）Latin 字体。",
      "readback": "font family name",
      "enforcement": "report"
    },
    "theme.font.minor.eastAsia": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "minor（body）East Asian 字体。",
      "readback": "font family name",
      "enforcement": "report"
    },
    "theme.font.minor.latin": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "minor（body）Latin 字体。",
      "readback": "font family name",
      "enforcement": "report"
