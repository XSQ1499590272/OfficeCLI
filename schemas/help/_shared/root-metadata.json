      "readback": "font scheme name",
      "enforcement": "report"
    },
    "theme.formatScheme": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "格式方案名称（a:fmtScheme/@name）。",
      "readback": "format scheme name",
      "enforcement": "report"
    },
    "theme.name": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "主题显示名称（a:theme/@name）。",
      "readback": "theme name string",
      "enforcement": "report"
    }
  }
}
