{
  "$schema": "../_schema.json",
  "element": "chart-series",
  "shared_base": true,
  "properties": {
    "categories": {
      "type": "string",
      "description": "逐 series 的 category 覆盖；仅接受 range reference。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop series1.categories=\"Sheet1!$A$2:$A$5\""
      ],
      "enforcement": "report",
      "readback": "as emitted by handler (per-format details vary)"
    },
    "categoriesRef": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "为 category labels 提供数据的 A1 cell range。",
      "readback": "A1 range string",
      "enforcement": "report"
    },
    "color": {
      "type": "color",
      "description": "series 填充颜色。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop series1.color=#4472C4",
        "--prop series1.color=4472C4"
      ],
      "readback": "#-prefixed uppercase hex",
      "enforcement": "report"
    },
    "dataLabels.numFmt": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "逐 series data label 数字格式的读取结果。",
      "readback": "format code",
      "enforcement": "report"
    },
    "dataLabels.separator": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "逐 series data label 分隔符字符串的读取结果。",
      "readback": "separator string",
      "enforcement": "report"
    },
    "errBars": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "error bar 值类型（fixed、percent、stddev、stderr）；接受别名 fixedValue、percentage/pct、standardDeviation、standardError。传入 'none' 可清除。不支持 error bar 的 series type 会静默忽略。",
      "readback": "OOXML errValType token",
      "enforcement": "lenient"
    },
    "invertIfNeg": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "反转负值的颜色。仅 bar/column/area/pie series 支持；line/scatter 会静默忽略。",
      "readback": "true | false",
      "enforcement": "lenient"
    },
    "lineDash": {
      "type": "enum",
      "values": [
        "solid",
        "sysDash",
        "sysDot",
        "sysDashDot",
        "lgDash",
        "lgDashDot",
        "lgDashDotDot",
        "dash",
        "dashDot",
        "dot",
        "longDash"
      ],
      "set": true,
      "get": true,
      "aliases": [
        "dash"
      ],
      "description": "series line dash style。Set 接受易用别名（dash/dot/dashDot/longDash）；Get 返回 OOXML token（sysDash/sysDot/sysDashDot/lgDash）。'dashDotDot' 没有原生 enum member，作为 sysDashDotDot 的别名接受；Get 读取结果会返回 sysDashDotDot。只有 'solid' 可稳定往返。",
      "examples": [
        "--prop lineDash=dash",
        "--prop lineDash=solid"
      ],
      "readback": "OOXML preset dash token",
      "enforcement": "report"
    },
    "lineWidth": {
      "type": "number",
      "set": true,
      "get": true,
      "description": "series 线宽，单位为 points（例如 1.5）。",
      "examples": [
        "--prop lineWidth=1.5"
      ],
      "readback": "numeric width in points",
      "enforcement": "report"
    },
    "marker": {
      "type": "string",
      "set": true,
      "get": true,
      "description": "逐 series marker symbol。可选值：circle、dash、diamond、dot、plus、square、star、triangle、x、none、auto。支持复合形式 'symbol:size:COLOR'（例如 'circle:8:FF0000'）。适用于 line/scatter/radar series。（picture marker 尚未实现。）",
      "examples": [
        "--prop marker=circle",
        "--prop marker=\"circle:8:FF0000\""
      ],
      "readback": "marker symbol name",
      "enforcement": "report"
    },
    "markerSize": {
      "type": "number",
      "set": true,
      "get": true,
      "description": "marker 大小，单位为 points（2–72）。仅当 marker 不为 'none' 时生效。",
      "examples": [
        "--prop markerSize=8"
      ],
      "readback": "integer",
      "enforcement": "report"
    },
    "markerColor": {
      "type": "string",
      "aliases": [
        "marker.color"
      ],
      "set": true,
      "get": true,
      "description": "逐 series marker 填充颜色（line/scatter/radar）。会保留现有 symbol 和 size；可与 marker=/markerSize= 配合，分别设置这三个值。通过 Reader 的 spPr/solidFill 探测实现往返。",
      "examples": [
        "--prop markerColor=FF0000"
      ],
      "readback": "hex color, e.g. #FF0000",
      "enforcement": "report"
    },
    "name": {
      "type": "string",
      "description": "显示在 legend 和 data labels 中的 series 名称。",
      "aliases": [
        "title"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop name=\"Q1\"",
        "--prop series1.name=\"Q1\"",
        "--prop name=\"Product A\"",
        "--prop series1.name=\"Product A\"",
        "--prop name=\"Revenue\"",
        "--prop series1.name=\"Revenue\""
      ],
      "readback": "series name string",
      "enforcement": "report"
    },
    "nameRef": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "为 series 名称提供数据的 A1 cell reference。",
      "readback": "A1 cell reference",
      "enforcement": "report"
    },
    "scatterStyle": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "scatter 子样式（line/lineMarker/marker/smooth/smoothMarker/none）。",
      "readback": "OOXML scatterStyle token",
      "enforcement": "report"
    },
    "secondaryAxis": {
      "type": "bool",
      "add": false,
      "set": false,
      "get": true,
      "description": "当 chart 有多个 value axis 且此 series 使用 secondary axis 时为 true。",
      "readback": "true | false",
      "enforcement": "report"
    },
    "smooth": {
      "type": "string",
      "description": "line/scatter series 的平滑线插值（true|false）。",
      "appliesWhen": {
        "parent.chartType": [
          "line",
          "scatter"
        ]
      },
      "set": true,
      "get": true,
      "examples": [
        "--prop smooth=true"
      ],
      "readback": "true | false",
      "enforcement": "report"
    },
    "values": {
      "type": "string",
      "description": "以逗号分隔的数字，或 cell range reference（Sheet1!B2:B13）。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop series1.values=\"120,150,180\"",
        "--prop series1.values=\"Sheet1!$B$2:$B$5\"",
        "--prop series1.values=\"120,150,180,210\""
      ],
      "enforcement": "strict"
    },
    "bubbleSize": {
      "type": "string",
      "description": "bubble chart 每个 point 的大小；接受以逗号分隔的数字或 cell range reference。省略时默认使用 y-values。",
      "appliesWhen": {
        "parent.chartType": [
          "bubble"
        ]
      },
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop series1.bubbleSize=\"10,20,30\"",
        "--prop series1.bubbleSize=\"Sheet1!$D$1:$D$3\""
      ],
      "readback": "comma-separated numeric list (cached values)",
      "enforcement": "report"
    },
    "bubbleSizeRef": {
      "type": "string",
      "description": "为 bubble 每个 point 的大小提供数据的 A1 cell range。可与 bubbleSize 共存（字面量会成为 numCache）。",
      "appliesWhen": {
        "parent.chartType": [
          "bubble"
        ]
      },
      "add": true,
      "set": false,
      "get": true,
      "examples": [
        "--prop series1.bubbleSizeRef=\"Sheet1!$D$1:$D$3\""
      ],
      "readback": "A1 range string",
      "enforcement": "report"
    }
  }
}
