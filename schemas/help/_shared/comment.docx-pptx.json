{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "date": {
      "type": "string",
      "description": "ISO-8601 时间戳。默认使用 DateTime.UtcNow。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop date=2025-01-15T10:30:00Z",
        "--prop date=2025-01-15T10:00:00Z"
      ],
      "readback": "Date attribute",
      "enforcement": "report"
    },
    "initials": {
      "type": "string",
      "description": "作者姓名首字母。省略时根据作者名称推导。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop initials=AT",
        "--prop initials=AW"
      ],
      "readback": "initials",
      "enforcement": "report"
    }
  }
}
