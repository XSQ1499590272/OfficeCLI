{
  "$schema": "../_schema.json",
  "element": "table",
  "shared_base": true,
  "properties": {
    "style": {
      "type": "string",
      "description": "表格样式名称或 GUID（接受别名 tableStyle、tableStyleId）。有效名称为 medium1..4、light1..3、dark1..2、none，或直接传入 {GUID}。",
      "values": [
        "medium1",
        "medium2",
        "medium3",
        "medium4",
        "light1",
        "light2",
        "light3",
        "dark1",
        "dark2",
        "none"
      ],
      "aliases": [
        "tableStyle",
        "tableStyleId"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop style=medium2",
        "--prop style=light1",
        "--prop style=dark1"
      ],
      "readback": "style name when resolvable, else GUID",
      "enforcement": "strict"
    }
  }
}
