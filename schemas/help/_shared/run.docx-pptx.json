{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "effective.bold": {
      "type": "bool",
      "description": "从 placeholder→layout→master→presentation 默认值继承并解析得到的粗体设置。run 直接设置 'bold' 时不显示此项。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "true/false",
      "enforcement": "report"
    },
    "effective.color": {
      "type": "color",
      "description": "从 placeholder→layout→master→presentation 默认值继承并解析得到的文本颜色。run 直接设置 'color' 时不显示此项。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "#-prefixed uppercase hex (scheme colors pass through)",
      "enforcement": "report"
    },
    "effective.size": {
      "type": "font-size",
      "description": "按继承关系解析得到的字体大小（只读）。当 run 未直接设置 'size' 时显示；解析链为 run style → paragraph style → docDefaults。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "unit-qualified, e.g. \"14pt\"",
      "enforcement": "report"
    },
    "underline": {
      "type": "enum",
      "description": "下划线样式。常用值：single、double、dotted、dash、wave、none。",
      "values": [
        "single",
        "double",
        "dotted",
        "dash",
        "wave",
        "none",
        "thick",
        "dottedHeavy",
        "dashLong",
        "dashLongHeavy",
        "dashDotHeavy",
        "wavyHeavy",
        "wavyDouble"
      ],
      "aliases": [
        "font.underline"
      ],
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop underline=single",
        "--prop underline=double"
      ],
      "readback": "underline style name",
      "enforcement": "report"
    }
  }
}
