{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "alpha": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "以 OOXML 单位表示的 series fill alpha 读取结果（0..100000 = 0..100%）。不同于 chart 级 `transparency`，后者是 Add/Set 使用的百分比输入。",
      "readback": "integer 0..100000 (OOXML alpha units)",
      "enforcement": "report"
    },
    "outlineColor": {
      "type": "color",
      "add": false,
      "set": false,
      "get": true,
      "description": "逐 series outline color 的读取结果。",
      "readback": "#RRGGBB or scheme reference",
      "enforcement": "report"
    }
  }
}
