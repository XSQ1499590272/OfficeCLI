{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "fallback": {
      "type": "string",
      "description": "SVG 来源可选的 PNG fallback。省略时会生成 1x1 的透明 PNG。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop fallback=/path/to/fallback.png"
      ],
      "readback": "n/a (SVG-only)",
      "enforcement": "report"
    }
  }
}
