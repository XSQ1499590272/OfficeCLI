{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "radarstyle": {
      "type": "string",
      "appliesWhen": {
        "chartType": [
          "radar"
        ]
      },
      "add": true,
      "set": true,
      "get": false,
      "description": "radar chart 子类型。可选值：standard|line、marker、filled|fill。",
      "examples": [
        "--prop radarstyle=filled"
      ]
    },
    "roundedcorners": {
      "type": "bool",
      "add": true,
      "set": true,
      "get": false,
      "description": "圆化 chart-area 外角。",
      "examples": [
        "--prop roundedcorners=true"
      ]
    },
    "valaxisvisible": {
      "type": "bool",
      "aliases": [
        "valaxis.visible"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "/chart[N]/axis[@role=...] 的 visible 快捷入口，作用于 role=value；完整的 axis 级选项请参见 chart-axis schema。",
      "examples": [
        "--prop valaxisvisible=false"
      ]
    }
  }
}
