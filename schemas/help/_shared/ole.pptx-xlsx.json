{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "contentType": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "嵌入 part 的 MIME type。",
      "readback": "MIME type string",
      "enforcement": "report"
    },
    "fileSize": {
      "type": "number",
      "add": false,
      "set": false,
      "get": true,
      "description": "嵌入 payload 的字节数。",
      "readback": "integer byte count",
      "enforcement": "report"
    },
    "objectType": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "OLE object type 标记（始终为 'ole'）。",
      "readback": "literal string 'ole'",
      "enforcement": "report"
    }
  }
}
