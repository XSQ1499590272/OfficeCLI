{
  "$schema": "../_schema.json",
  "shared_base": true,
  "properties": {
    "subscript": {
      "type": "bool",
      "description": "垂直对齐方式为 subscript。与 superscript 互斥。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop subscript=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    },
    "superscript": {
      "type": "bool",
      "description": "垂直对齐方式为 superscript。与 subscript 互斥。",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop superscript=true"
      ],
      "readback": "true | false",
      "enforcement": "strict"
    }
  }
}
