{
  "$schema": "../_schema.json",
  "format": "pptx",
  "element": "comment",
  "elementAliases": ["note-comment"],
  "parent": "slide",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/slide[N]/comment[M]"
    ]
  },
  "note": "Comment 保存在带 author list 的 CommentsPart 中，使用 slide 上的 x/y EMU 作为锚点。",
  "extends": [
    "_shared/comment",
    "_shared/comment.docx-pptx"
  ],
  "properties": {
    "index": {
      "type": "int",
      "description": "按 author 递增的 index，由 engine 分配。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "comment index",
      "enforcement": "report"
    },
    "x": {
      "type": "length",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop x=2cm"
      ],
      "readback": "length in cm (e.g. \"2cm\")",
      "enforcement": "report"
    },
    "y": {
      "type": "length",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop y=2cm"
      ],
      "readback": "length in cm (e.g. \"2cm\")",
      "enforcement": "report"
    },
    "direction": {
      "type": "string",
      "aliases": [
        "dir",
        "rtl"
      ],
      "description": "comment 文本的文字方向。rtl 会在开头添加 U+200F（RIGHT-TO-LEFT MARK），使 Arabic / Hebrew comment 在正确的 bidi context 中渲染。p:cm 没有原生 rtl attribute，因此采用此标准的纯文本约定。",
      "add": true,
      "set": false,
      "get": false,
      "examples": [
        "--prop direction=rtl"
      ],
      "readback": "rtl|ltr",
      "enforcement": "report"
    }
  }
}
