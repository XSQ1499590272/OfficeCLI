{
  "$schema": "../_schema.json",
  "format": "pptx",
  "element": "row",
  "elementAliases": ["tr"],
  "parent": "table",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/slide[N]/table[M]/tr[R]"
    ]
  },
  "note": "除非提供 'cols' override，否则 row 会继承 table grid 的 column count。使用 c{N}=value props 为每个 cell 提供初始文本。",
  "extends": "_shared/table-row"
}
