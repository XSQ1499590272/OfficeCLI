{
  "$schema": "../_schema.json",
  "format": "pptx",
  "element": "ole",
  "elementAliases": ["embed", "object", "oleobject"],
  "parent": "slide",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": [
      "/slide[N]/ole[M]"
    ]
  },
  "note": "Aliases：oleobject、object、embed。包含 binary package 和 preview image。通过 x/y/width/height 定位（接受可按 EMU 解析的值，readback 使用 cm）。",
  "extends": [
    "_shared/ole",
    "_shared/ole.docx-pptx",
    "_shared/ole.pptx-xlsx"
  ],
  "properties": {
    "x": {
      "type": "length",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop x=2cm"
      ],
      "readback": "length in cm (e.g. \"2cm\")",
      "enforcement": "report"
    },
    "y": {
      "type": "length",
      "add": true,
      "set": true,
      "get": true,
      "examples": [
        "--prop y=2cm"
      ],
      "readback": "length in cm (e.g. \"2cm\")",
      "enforcement": "report"
    }
  }
}
