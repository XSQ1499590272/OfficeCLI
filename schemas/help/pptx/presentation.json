{
  "$schema": "../_schema.json",
  "format": "pptx",
  "element": "presentation",
  "container": true,
  "operations": {
    "add": false,
    "set": true,
    "get": true,
    "query": true,
    "remove": false
  },
  "paths": {
    "positional": [
      "/"
    ]
  },
  "note": "Root container。Get 返回 presentation node，并将 slide count 以及 theme/master/layout references 作为 children。不能通过 Add 定位。对 '/' 执行 Set 可修改 core document metadata（title/author/subject/keywords/description/category），写入 docProps/core.xml，来源与 docx/xlsx 相同。element 级修改通过 /slide[N]、/theme 等 path 执行。",
  "children": [
    {
      "element": "slide",
      "pathSegment": "slide",
      "cardinality": "0..n"
    },
    {
      "element": "slidemaster",
      "pathSegment": "slidemaster",
      "cardinality": "1..n"
    },
    {
      "element": "theme",
      "pathSegment": "theme",
      "cardinality": "1"
    }
  ],
  "extends": "_shared/root-metadata",
  "properties": {
    "title": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop title=\"Q4 Review\""
      ],
      "readback": "title string",
      "enforcement": "report"
    },
    "author": {
      "type": "string",
      "aliases": [
        "creator"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop author=\"Alice\""
      ],
      "readback": "author string",
      "enforcement": "report"
    },
    "keywords": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop keywords=\"tag1,tag2\""
      ],
      "readback": "keywords string",
      "enforcement": "report"
    },
    "description": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop description=\"Abstract\""
      ],
      "readback": "description string",
      "enforcement": "report"
    },
    "category": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop category=Marketing"
      ],
      "readback": "category string",
      "enforcement": "report"
    },
    "lastModifiedBy": {
      "type": "string",
      "aliases": [
        "lastmodifiedby"
      ],
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop lastModifiedBy=\"Bob\""
      ],
      "readback": "last-modified author",
      "enforcement": "report"
    },
    "revisionNumber": {
      "type": "string",
      "add": false,
      "set": true,
      "get": true,
      "description": "docProps/core.xml 中的 Revision 字段，即 presentation 保存计数器。",
      "examples": [
        "--prop revisionNumber=3"
      ],
      "readback": "revision number string",
      "enforcement": "report"
    },
    "created": {
      "type": "string",
      "description": "来自 docProps/core.xml 的创建时间戳。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "ISO 8601 timestamp",
      "enforcement": "report"
    },
    "modified": {
      "type": "string",
      "description": "来自 docProps/core.xml 的最后修改时间戳。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "ISO 8601 timestamp",
      "enforcement": "report"
    },
    "slideWidth": {
      "type": "string",
      "aliases": ["width"],
      "description": "来自 <p:sldSz/@cx> 的 slide 宽度，经 FormatEmu 格式化。Set 接受带单位的值或原始 EMU；仅设置 width 或 height 会将 @type 切换为 'custom'。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop slideWidth=30cm",
        "--prop slideWidth=720pt"
      ],
      "readback": "unit-qualified length string (e.g. '25.4cm', '720pt')",
      "enforcement": "report"
    },
    "slideHeight": {
      "type": "string",
      "aliases": ["height"],
      "description": "来自 <p:sldSz/@cy> 的 slide 高度，经 FormatEmu 格式化。Set 接受带单位的值或原始 EMU；仅设置 width 或 height 会将 @type 切换为 'custom'。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop slideHeight=20cm",
        "--prop slideHeight=540pt"
      ],
      "readback": "unit-qualified length string (e.g. '19.05cm', '540pt')",
      "enforcement": "report"
    },
    "slideSize": {
      "type": "string",
      "description": "由 <p:sldSz/@type> 得到的 slide size preset 名称。Set 接受列出的 preset 名称之一（widescreen | standard | 16:10 | a4 | a3 | letter | b4 | b5 | 35mm | overhead | banner | ledger | custom），并相应重写 @cx/@cy + @type；未列出的名称会被拒绝（任意 custom size 请使用 slideWidth/slideHeight）。",
      "add": false,
      "set": true,
      "get": true,
      "examples": [
        "--prop slideSize=widescreen",
        "--prop slideSize=a4"
      ],
      "readback": "preset name: widescreen | standard | 16:10 | a4 | a3 | letter | b4 | b5 | 35mm | overhead | banner | ledger | custom",
      "enforcement": "report"
    },
    "defaultFont": {
      "type": "string",
      "description": "来自第一个 slide master 的 theme FontScheme 的默认 minor（body）字体。",
      "add": false,
      "set": false,
      "get": true,
      "readback": "default text font family name",
      "enforcement": "report"
    },
    "extended.application": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "来自 docProps/app.xml 的 application 标识符（例如 \"Microsoft PowerPoint\"）。",
      "readback": "application string",
      "enforcement": "report"
    },
    "compatMode": {
      "type": "bool",
      "aliases": ["compatibilitymode"],
      "add": false,
      "set": true,
      "get": true,
      "description": "presentation 的 @compatMode 标记：文件处于 legacy-compatibility mode 时为 true。",
      "examples": [
        "--prop compatMode=true"
      ],
      "readback": "true when compat mode is on",
      "enforcement": "report"
    },
    "firstSlideNum": {
      "type": "number",
      "aliases": ["firstslidenumber"],
      "add": false,
      "set": true,
      "get": true,
      "description": "presentation 的 @firstSlideNum，即第一个 slide 的编号（默认 1）。",
      "examples": [
        "--prop firstSlideNum=10"
      ],
      "readback": "integer",
      "enforcement": "report"
    },
    "rtl": {
      "type": "bool",
      "add": false,
      "set": true,
      "get": false,
      "description": "presentation @rtl（从右到左阅读顺序）的仅 Set 输入别名。Get 按与 docx 一致的约定，以标准 key `direction` 返回同一 OOXML 属性（为 true 时为 'rtl'）。这是有意的非对称设计：通过 `rtl=true|false` 设置，通过 `direction` 读取。",
      "examples": [
        "--prop rtl=true"
      ],
      "enforcement": "report"
    },
    "direction": {
      "type": "string",
      "add": false,
      "set": false,
      "get": true,
      "description": "presentation 阅读方向的仅 Get 标准 key。设置 @rtl=true 时返回 'rtl'；否则不返回。设置请使用仅输入的 `rtl=true|false` key。",
      "readback": "'rtl' when right-to-left; key absent for default left-to-right",
      "enforcement": "report"
    },
    "print.colorMode": {
      "type": "string",
      "aliases": ["printcolormode"],
      "add": false,
      "set": true,
      "get": true,
      "description": "PrintingProperties 的 color mode。Set 接受：color|clr、grayscale|gray、blackAndWhite|bw。",
      "examples": [
        "--prop print.colorMode=gray",
        "--prop print.colorMode=color"
      ],
      "readback": "color mode token (clr | gray | bw)",
      "enforcement": "report"
    },
    "print.frameSlides": {
      "type": "bool",
      "add": false,
      "set": true,
      "get": true,
      "description": "PrintingProperties 的 FrameSlides 标记：在每个 slide 周围打印细边框。",
      "examples": [
        "--prop print.frameSlides=true"
      ],
      "readback": "true when set",
      "enforcement": "report"
    },
    "print.hiddenSlides": {
      "type": "bool",
      "add": false,
      "set": true,
      "get": true,
      "description": "PrintingProperties 的 HiddenSlides 标记：在打印输出中包含隐藏的 slide。",
      "examples": [
        "--prop print.hiddenSlides=true"
      ],
      "readback": "true when set",
      "enforcement": "report"
    },
    "print.what": {
      "type": "string",
      "aliases": ["printwhat"],
      "add": false,
      "set": true,
      "get": true,
      "description": "PrintingProperties 的 PrintWhat，即打印内容。Set 接受简写（slides、handouts、notes、outline）和明确的 OOXML token（handouts1、handouts2、handouts3、handouts4、handouts6、handouts9）。不带子字段的 `handouts` 是 handouts1 的别名。Get 返回 OOXML token（例如 handouts1）。",
      "examples": [
        "--prop print.what=handouts",
        "--prop print.what=handouts4",
        "--prop print.what=notes"
      ],
      "readback": "print-what enum inner text (slides | handouts1..9 | notes | outline)",
      "enforcement": "report"
    },
    "print.scaleToFitPaper": {
      "type": "bool",
      "add": false,
      "set": true,
      "get": true,
      "description": "PrintingProperties 的 ScaleToFitPaper 标记：缩放 slide 以填满纸张页面。",
      "examples": [
        "--prop print.scaleToFitPaper=true"
      ],
      "readback": "true when set",
      "enforcement": "report"
    },
    "show.loop": {
      "type": "bool",
      "aliases": ["showloop"],
      "add": false,
      "set": true,
      "get": true,
      "description": "ShowProperties 的 Loop 标记：slideshow 到达末尾时自动重新开始。",
      "examples": [
        "--prop show.loop=true"
      ],
      "readback": "true when set",
      "enforcement": "report"
    },
    "show.narration": {
      "type": "bool",
      "aliases": ["shownarration"],
      "add": false,
      "set": true,
      "get": true,
      "description": "ShowProperties 的 ShowNarration 标记：slideshow 时播放录制的 narration。",
      "examples": [
        "--prop show.narration=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "show.animation": {
      "type": "bool",
      "aliases": ["showanimation"],
      "add": false,
      "set": true,
      "get": true,
      "description": "ShowProperties 的 ShowAnimation 标记：slideshow 时播放 animation。",
      "examples": [
        "--prop show.animation=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "show.useTimings": {
      "type": "bool",
      "aliases": ["usetimings", "show.usetimings"],
      "add": false,
      "set": true,
      "get": true,
      "description": "ShowProperties 的 UseTimings 标记：slideshow 时使用保存的 slide timing。",
      "examples": [
        "--prop show.useTimings=true"
      ],
      "readback": "true|false",
      "enforcement": "report"
    },
    "removePersonalInfo": {
      "type": "bool",
      "aliases": ["removepersonalinfoonsave"],
      "add": false,
      "set": true,
      "get": true,
      "description": "ExtendedProperties 的 RemovePersonalInfoOnSave：保存时移除 author/last-saved-by 元数据。",
      "examples": [
        "--prop removePersonalInfo=true"
      ],
      "readback": "true when set",
      "enforcement": "report"
    }
  }
}
