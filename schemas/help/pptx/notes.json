{
  "$schema": "../_schema.json",
  "format": "pptx",
  "element": "notes",
  "elementAliases": ["note"],
  "parent": "slide",
  "operations": {
    "add": true,
    "set": true,
    "get": true,
    "query": true,
    "remove": true
  },
  "paths": {
    "positional": ["/slide[N]/notes"]
  },
  "note": "Speaker notes 保存在与 slide 配对的 NotesSlidePart 中。Add 在 part 不存在时创建，Set 替换文本。",
  "properties": {
    "text": {
      "type": "string",
      "description": "notes 正文文本。",
      "add": true, "set": true, "get": true,
      "examples": ["--prop text=\"Emphasize slide 3 data\""],
      "readback": "notes text",
      "enforcement": "report"
    },
    "direction": {
      "type": "enum",
      "values": ["ltr", "rtl"],
      "aliases": ["dir", "rtl"],
      "description": "notes 正文的文字方向。会在每个 paragraph 上设置 <a:pPr rtl=\"1\"/>，并在 body shape 的 bodyPr 上设置 rtlCol=\"1\"。Arabic / Hebrew speaker notes 需要此设置。",
      "add": true, "set": true, "get": false,
      "examples": ["--prop direction=rtl"],
      "enforcement": "report"
    },
    "lang": {
      "type": "string",
      "description": "应用到 notes 正文每个 run 的 BCP-47 language tag（a:rPr/@lang）。可使用与 shape Set 相同的取值。",
      "add": true, "set": true, "get": false,
      "examples": ["--prop lang=ar-SA"],
      "enforcement": "report"
    }
  }
}
